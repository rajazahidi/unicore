# Enforce consistent LF line endings for all Linux scripts, configs, and source files across Windows/Linux/macOS.
* text=auto eol=lf

# Linux OS builder & overlay assets MUST always remain LF
os-builder/** text eol=lf
*.sh text eol=lf
*.start text eol=lf
*.jsonc text eol=lf
*.css text eol=lf
*.ini text eol=lf
*.conf text eol=lf
*.xml text eol=lf
*.desktop text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.rs text eol=lf
*.toml text eol=lf
*.slint text eol=lf
*.py text eol=lf
*.md text eol=lf
.githooks/* text eol=lf

# Windows scripts
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.exe binary
*.apk binary
*.iso binary
*.squashfs binary
*.img binary
*.qcow2 binary
*.gz binary
*.zst binary
*.zip binary
*.tar binary
