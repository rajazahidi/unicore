    callback install-only-open();
    callback cancel-open();
    callback switch-to-full-center();

    callback android-action(string);
    callback win32-asset-action(string);
    callback install-runtimes-selected();
    callback toggle-game-mode(bool);
    callback toggle-show-fps(bool);
    callback complete-oobe(bool);
    callback skip-oobe();
    callback toggle-language();
    callback oobe-lang-selected(int);
    callback refresh-tasks();
    callback select-task(int);
    callback end-task(int, bool);

    // Settings & Power callbacks
    callback refresh-settings();
    callback toggle-wifi-radio(bool);
    callback select-wifi(int);
    callback connect-wifi(string, string);
    callback disconnect-wifi();
    callback forget-wifi(string);
