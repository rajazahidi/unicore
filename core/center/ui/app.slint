export global UiTheme {
    in-out property <bool> light: false;
    in-out property <bool> high-contrast: false;
    in-out property <int> accent-idx: 0; // 0:blue, 1:purple, 2:green, 3:amber, 4:rose
    out property <color> accent: accent-idx == 1 ? #6366f1 : (accent-idx == 2 ? #059669 : (accent-idx == 3 ? #d97706 : (accent-idx == 4 ? #e11d48 : #0284c7)));
    out property <color> accent-dark: accent-idx == 1 ? #4f46e5 : (accent-idx == 2 ? #047857 : (accent-idx == 3 ? #b45309 : (accent-idx == 4 ? #be123c : #0369a1)));
    out property <color> accent-bright: accent-idx == 1 ? #a5b4fc : (accent-idx == 2 ? #34d399 : (accent-idx == 3 ? #fbbf24 : (accent-idx == 4 ? #fb7185 : #38bdf8)));
    out property <color> bg: high-contrast ? (light ? #ffffff : #000000) : (light ? #f1f5f9 : #0f172a);
    out property <color> card-bg: high-contrast ? (light ? #ffffff : #090d16) : (light ? #ffffff : #1e293b);
    out property <color> card-border: high-contrast ? (light ? #0f172a : #facc15) : (light ? #cbd5e1 : #334155);
    out property <color> text-primary: high-contrast ? (light ? #000000 : #ffffff) : (light ? #0f172a : #f8fafc);
    out property <color> text-secondary: high-contrast ? (light ? #0f172a : #f8fafc) : (light ? #334155 : #e2e8f0);
    out property <color> text-muted: high-contrast ? (light ? #1e293b : #e2e8f0) : (light ? #475569 : #94a3b8);
    out property <color> text-accent: high-contrast ? (light ? #0c4a6e : #fde047) : (light ? accent-dark : accent-bright);
    out property <color> text-ok: light ? #15803d : #4ade80;
    out property <color> surface-subtle: light ? #e2e8f0 : #263449;
    out property <color> surface-hover: light ? #cbd5e1 : #334155;
}

component Card inherits Rectangle {
    background: UiTheme.card-bg;
    border-radius: 8px;
    border-width: 1px;
    border-color: UiTheme.card-border;
}

component TabPill inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    in property <bool> danger: false;
    callback clicked();

    height: 32px;
    border-radius: 6px;
    background: active ? UiTheme.accent : (danger ? (ta.has-hover ? #991b1b : #7f1d1d) : (ta.has-hover ? UiTheme.surface-hover : UiTheme.card-bg));
    border-width: 1px;
    border-color: active ? UiTheme.accent-bright : (danger ? #ef4444 : UiTheme.card-border);

    ta := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;
        Text {
            text: root.label;
            color: (active || danger) ? #f8fafc : UiTheme.text-primary;
            font-size: 12px;
            font-weight: active || danger ? 700 : 500;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

component StoreNavItem inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked();

    height: 36px;
    border-radius: 7px;
    background: active ? UiTheme.accent-dark : (nav-ta.has-hover ? UiTheme.surface-hover : transparent);
    border-width: active ? 1px : 0px;
    border-color: UiTheme.accent-bright;

    nav-ta := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        Rectangle {
            width: 3px;
            height: 18px;
            border-radius: 2px;
            background: active ? #38bdf8 : transparent;
            y: 9px;
        }
        Text {
            text: root.label;
            color: active ? #ffffff : UiTheme.text-secondary;
            font-size: 12px;
            font-weight: active ? 700 : 500;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

component StoreAppCard inherits Rectangle {
    in property <StoreEntry> item;
    in property <string> get-label;
    in property <string> open-label;
    in property <bool> busy: false;
    callback card-clicked(StoreEntry);
    callback install-clicked(string);
    callback launch-clicked(string);

    height: 158px;
    border-radius: 10px;
    background: card-ta.has-hover ? UiTheme.surface-subtle : UiTheme.card-bg;
    border-width: 1px;
    border-color: item.is-installed ? #22c55e : (card-ta.has-hover ? UiTheme.text-accent : UiTheme.card-border);

    card-ta := TouchArea {
        clicked => { root.card-clicked(root.item); }
    }

    VerticalLayout {
        padding: 12px;
        spacing: 8px;

        // Top row: Color Icon Tile + Name + Platform/Version
        HorizontalLayout {
            spacing: 10px;
            Rectangle {
                width: 46px;
                height: 46px;
                border-radius: 10px;
                background: item.accent-color;
                Text {
                    text: item.icon-text;
                    color: #ffffff;
                    font-size: 15px;
                    font-weight: 800;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                spacing: 2px;
                Text {
                    text: item.name;
                    color: UiTheme.text-primary;
                    font-size: 13px;
                    font-weight: 700;
                    overflow: elide;
                }
                Text {
                    text: item.platform-short + " • v" + item.version + " • " + item.size-label;
                    color: UiTheme.text-muted;
                    font-size: 10px;
                    overflow: elide;
                }
            }
        }

        // Middle summary
        Text {
            text: item.summary;
            color: UiTheme.text-secondary;
            font-size: 11px;
            wrap: word-wrap;
            overflow: elide;
            vertical-stretch: 1;
        }

        // Bottom strip: Verification badge + Get/Open button
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: item.badge;
                color: item.is-installed ? UiTheme.text-ok : UiTheme.text-accent;
                font-size: 10px;
                font-weight: 600;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            if !item.is-installed : Button {
                text: root.get-label;
                primary: true;
                enabled: !root.busy;
                clicked => { root.install-clicked(root.item.id); }
            }
            if item.is-installed : Button {
                text: root.open-label;
                clicked => { root.launch-clicked(root.item.installed-app-id); }
            }
        }
    }
}

component InfoRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    in property <color> value-color: UiTheme.text-secondary;
    spacing: 8px;
    height: 22px;

    Text {
        text: root.label;
        color: UiTheme.text-muted;
        font-size: 12px;
        width: 130px;
        vertical-alignment: center;
    }
    Text {
        text: root.value;
        color: root.value-color;
        font-size: 12px;
        overflow: elide;
        horizontal-stretch: 1;
        vertical-alignment: center;
    }
}

component PermissionGrid inherits VerticalLayout {
    in-out property <bool> perm-network: true;
    in-out property <bool> perm-gpu: true;
    in-out property <bool> perm-documents: false;
    in-out property <bool> perm-camera: false;
    in-out property <bool> perm-microphone: false;
    in property <bool> controls-enabled: true;
    callback permission-toggled(string, bool);

    spacing: 8px;

    Text {
        text: "Sandbox Permissions";
        color: UiTheme.text-muted;
        font-size: 12px;
        font-weight: 600;
    }

    HorizontalLayout {
        spacing: 16px;
        Switch {
            text: "Network Access";
            width: 210px;
            checked <=> root.perm-network;
            enabled: root.controls-enabled;
            toggled => { root.permission-toggled("network", self.checked); }
        }
        Switch {
            text: "GPU Acceleration";
            checked <=> root.perm-gpu;
            enabled: root.controls-enabled;
            toggled => { root.permission-toggled("gpu_acceleration", self.checked); }
        }
    }

    HorizontalLayout {
        spacing: 16px;
        Switch {
            text: "Shared Documents";
            width: 210px;
            checked <=> root.perm-documents;
            enabled: root.controls-enabled;
            toggled => { root.permission-toggled("shared_documents", self.checked); }
        }
        Switch {
            text: "Camera";
            checked <=> root.perm-camera;
            enabled: root.controls-enabled;
            toggled => { root.permission-toggled("camera", self.checked); }
        }
    }

    Switch {
        text: "Microphone";
        width: 210px;
        checked <=> root.perm-microphone;
        enabled: root.controls-enabled;
        toggled => { root.permission-toggled("microphone", self.checked); }
    }
}

component WinEraRow inherits HorizontalLayout {
    in-out property <int> current-index: 3;
    in property <length> label-width: 110px;
    in property <length> label-font-size: 13px;
    callback era-selected(int);

    spacing: 10px;
    Text {
        text: "Windows Era:";
        color: UiTheme.text-muted;
        font-size: root.label-font-size;
        width: root.label-width;
        vertical-alignment: center;
    }
    ComboBox {
        model: ["Windows 98 (Win98)", "Windows XP (WinXP)", "Windows 7 (Win7)", "Windows 10 / 11 (Win10)"];
        current-index <=> root.current-index;
        selected => { root.era-selected(self.current-index); }
        horizontal-stretch: 1;
    }
}

export component MainWindow inherits Window {
    title: root.start-menu-only ? root.tr.title-start-menu : (root.emoji-dialog-only ? root.tr.title-emoji : (root.capture-dialog-only ? root.tr.title-capture : (root.ai-dialog-only ? root.tr.title-ai : (root.login-dialog-only ? root.tr.title-login : (root.quick-settings-only ? root.tr.title-quick : (root.power-dialog-only ? root.tr.title-power : (root.taskmgr-dialog-only ? root.tr.title-taskmgr : (root.oobe-dialog-only ? root.tr.title-oobe : (root.open-dialog-only ? root.tr.title-open : root.tr.title-center)))))))));
    preferred-width: root.start-menu-only ? 600px : (root.emoji-dialog-only ? 430px : (root.capture-dialog-only ? 520px : (root.ai-dialog-only ? 640px : (root.login-dialog-only ? 460px : (root.quick-settings-only ? 420px : (root.power-dialog-only ? 440px : (root.open-dialog-only ? 600px : (root.taskmgr-dialog-only ? 680px : 1040px))))))));
    preferred-height: root.start-menu-only ? 540px : (root.emoji-dialog-only ? 430px : (root.capture-dialog-only ? 400px : (root.ai-dialog-only ? 560px : (root.login-dialog-only ? 410px : (root.quick-settings-only ? 580px : (root.power-dialog-only ? 320px : (root.open-dialog-only ? (root.open-show-advanced ? 590px : 390px) : (root.taskmgr-dialog-only ? 520px : 650px))))))));
    min-width: (root.power-dialog-only || root.quick-settings-only || root.login-dialog-only || root.capture-dialog-only || root.emoji-dialog-only) ? 360px : 520px;
    min-height: (root.power-dialog-only || root.quick-settings-only || root.login-dialog-only || root.capture-dialog-only || root.emoji-dialog-only) ? 280px : 360px;
    background: UiTheme.bg;

    private property <bool> show-tabs: !root.open-dialog-only && !root.power-dialog-only && !root.oobe-dialog-only && !root.taskmgr-dialog-only && !root.quick-settings-only && !root.login-dialog-only && !root.ai-dialog-only && !root.capture-dialog-only && !root.start-menu-only && !root.emoji-dialog-only && !root.picker-open;

    public function set-theme(light: bool) {
        UiTheme.light = light;
        Palette.color-scheme = light ? ColorScheme.light : ColorScheme.dark;
    }

    public function set-high-contrast-theme(hc: bool) {
        UiTheme.high-contrast = hc;
    }

    public function set-accent-color(idx: int) {
        UiTheme.accent-idx = idx;
    }

    init => {
        Palette.color-scheme = UiTheme.light ? ColorScheme.light : ColorScheme.dark;
    }

    // Localization & Navigation
    in-out property <UiText> tr;
    in-out property <string> lang-badge: "EN";
    in-out property <bool> open-dialog-only: false;
    in-out property <bool> power-dialog-only: false;
    in-out property <bool> quick-settings-only: false;
    in-out property <bool> login-dialog-only: false;
    in-out property <bool> ai-dialog-only: false;
    in-out property <bool> capture-dialog-only: false;
    in-out property <bool> start-menu-only: false;
    in-out property <bool> emoji-dialog-only: false;
    in-out property <bool> oobe-dialog-only: false;
    in-out property <bool> taskmgr-dialog-only: false;
    in-out property <bool> picker-open: false;
    in-out property <string> picker-target: "";
    in-out property <string> picker-dir: "/";
    in-out property <[PickerRow]> picker-entries: [];
    in-out property <[string]> login-user-names: ["unicore"];
    in-out property <int> login-user-idx: 0;
    in-out property <string> login-password: "";
    in-out property <string> login-error: "";
    in-out property <string> login-clock-text: "UniCore OS v0.6.0";
    in-out property <bool> open-show-advanced: false;
    in-out property <[TaskEntry]> task-list: [];
    in-out property <int> selected-task-idx: -1;
    in-out property <int> selected-task-pid: 0;
    in-out property <int> oobe-step: 0;
    in-out property <int> oobe-lang-idx: 0;
    in-out property <int> oobe-tz-idx: 1;
    in-out property <string> oobe-hostname: "unicore-pc";
    in-out property <string> oobe-pass: "";
    in-out property <string> oobe-pass-confirm: "";
    in-out property <int> active-tab: 0; // 0: Installed Apps, 1: Install File, 2: System & Android, 3: Settings
    in-out property <int> settings-subtab: 0; // 0: Wi-Fi, 1: Bluetooth, 2: Audio, 3: Display, 4: Printers
    in-out property <string> hw-summary: "Detecting hardware...";
    in-out property <string> status-message: "";
    in-out property <bool> status-is-error: false;

    // Installed apps tab state
    in-out property <[AppEntry]> installed-apps: [];
    in-out property <int> selected-app-idx: -1;
    in-out property <string> sel-name: "No application selected";
    in-out property <string> sel-app-id: "";
    in-out property <string> sel-platform: "-";
    in-out property <string> sel-arch: "-";
    in-out property <string> sel-source-path: "-";
    in-out property <string> sel-sandbox-dir: "-";
    in-out property <bool> sel-supports-era: false;
    in-out property <int> sel-win-era-idx: 3;
    in-out property <bool> sel-perm-network: true;
    in-out property <bool> sel-perm-gpu: true;
    in-out property <bool> sel-perm-documents: false;
    in-out property <bool> sel-perm-camera: false;
    in-out property <bool> sel-perm-microphone: false;
    in-out property <bool> has-selected-app: false;
    in-out property <bool> sel-log-visible: false;
    in-out property <string> sel-log-text: "";
    in-out property <bool> sel-show-adv: false;
    in-out property <string> sel-launch-args: "";
    in-out property <string> sel-env-vars: "";
    in-out property <string> sel-save-archive: "/data/home/Documents/app-save.tar.gz";

    // Open / Install file form state (shared by --open dialog and Install tab)
    in-out property <string> install-path-input: "";
    in-out property <[BrowseFileEntry]> browse-files: [];
    in-out property <bool> open-has-file: false;
    in-out property <string> open-name: "";
    in-out property <string> open-path: "";
    in-out property <string> open-platform: "-";
