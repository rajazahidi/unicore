    in-out property <bool> oobe-pack-creative: false;
    in-out property <bool> oobe-pack-gaming: false;

    // App Catalog / Store state (Tab 4)
    in-out property <[StoreEntry]> store-entries: [];
    in-out property <[StoreRow]> store-rows: [];
    in-out property <bool> store-has-featured: false;
    in-out property <StoreEntry> store-featured;
