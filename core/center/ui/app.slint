import { Button, CheckBox, ComboBox, LineEdit, Palette, ProgressIndicator, ScrollView, Slider, Switch } from "std-widgets.slint";

export struct AppEntry {
    name: string,
    platform-label: string,
}

export struct BrowseFileEntry {
    name: string,
    path: string,
    kind: string,
}

export struct WifiEntry {
    in-use: bool,
    ssid: string,
    signal: int,
    security: string,
}

export struct BtEntry {
    mac: string,
    name: string,
    paired: bool,
    connected: bool,
}

export struct PrinterEntry {
    name: string,
    status: string,
    is-default: bool,
}

export struct VpnEntry {
    name: string,
    vpn-type: string,
    active: bool,
}

export struct TaskEntry {
    pid: int,
    name: string,
    ram-label: string,
    detail: string,
}

export struct StoreEntry {
    id: string,
    name: string,
    version: string,
    size-label: string,
    platform-label: string,
    platform-short: string,
    summary: string,
    badge: string,
    sha256-short: string,
    category: string,
    icon-text: string,
    accent-color: color,
    is-flatpak: bool,
    flatpak-id: string,
    is-installed: bool,
    installed-app-id: string,
}

export struct StoreRow {
    has-a: bool,
    a: StoreEntry,
    has-b: bool,
    b: StoreEntry,
    has-c: bool,
    c: StoreEntry,
}

export struct PickerRow {
    name: string,
    path: string,
    is-dir: bool,
    detail: string,
}

export struct UserRow {
    username: string,
    uid: int,
    role: string,
    has-password: bool,
}

export struct ShareEntry {
    id: string,
    label: string,
    uri: string,
    username: string,
    mounted: bool,
}

export struct StartPinnedRow {
    has-0: bool, n0: string, b0: string, e0: string, c0: color,
    has-1: bool, n1: string, b1: string, e1: string, c1: color,
    has-2: bool, n2: string, b2: string, e2: string, c2: color,
    has-3: bool, n3: string, b3: string, e3: string, c3: color,
}

export struct StartAppRow {
    has-a: bool, a-name: string, a-desc: string, a-badge: string, a-exec: string, a-color: color,
    has-b: bool, b-name: string, b-desc: string, b-badge: string, b-exec: string, b-color: color,
}

export struct EmojiRow {
    e0: string, e1: string, e2: string, e3: string,
    e4: string, e5: string, e6: string, e7: string,
}

