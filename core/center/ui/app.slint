    callback mic-mute-toggled(bool);
    callback audio-sink-selected(int);
    callback display-output-selected(int);
    callback apply-display(int, int, int);
    callback brightness-changed(int);
    callback nightlight-changed(bool, int);
    callback apply-personalize(int, int, string, int, bool, bool, int, bool, int, int, int, bool, bool);
    callback preview-look-oobe(int, int, int);
    callback start-filter-changed(string, string);
    callback start-launch-app(string);
    callback start-open-folder(string);
    callback emoji-filter-changed(string, string);
    callback emoji-selected(string);
    callback audio-profile-selected(int);
    callback toggle-dnd(bool);
    callback dismiss-all-notifications();
    callback restore-last-notification();
    callback capture-take-shot(bool, int);
    callback capture-start-recording(bool, bool);
    callback capture-stop-recording();
    callback capture-open-dir(string);
    callback select-share(int);
    callback add-network-share(string, string, string, string);
    callback share-action(string, string);
    callback toggle-osk();
    callback speak-clipboard();
    callback toggle-cups(bool);
    callback scan-printers();
    callback open-document-scanner();
    callback select-printer(int);
    callback select-discovered-printer(int);
    callback add-printer(string, string);
    callback printer-action(string, string);
    callback toggle-firewall(bool);
    callback firewall-profile-changed(int);
    callback firewall-ssh-toggled(bool);
    callback select-vpn(int);
    callback import-vpn(string);
    callback vpn-action(string, string);
    callback refresh-backup-targets();
    callback create-backup(int, bool, string);
    callback restore-backup(string, string);
    callback power-action(string);
    callback refresh-install-disks();
    callback start-disk-install(int, int, string, bool, string, string);
    callback refresh-update-status();
    callback check-ota-update(string);
    callback apply-ota-update(string);
    callback apply-local-update(string, bool);
    callback rollback-os-slot();
    callback store-filter-changed(string, string);
    callback store-install-app(string);
    callback store-uninstall-app(string, string);
    callback store-launch-app(string, bool);
    callback store-sync-catalog(string);
    callback install-latest-proton();
    callback ai-save-provider(int, string, string, string);
    callback ai-copilot-ask(string, bool);
    callback ai-quick-nav(string);
    callback lock-screen-now();
    callback toggle-auto-check-updates(bool);
    callback enroll-secureboot-mok(string);
    callback install-native-browser(string);
    callback set-default-browser(string);
    callback diagnose-selected-app();
    callback autofix-selected-app();
    callback save-app-launch-config(string, string);
    callback reset-app-prefix();
    callback backup-app-save(string);
    callback restore-app-save(string);
    callback open-file-picker(string);
    callback picker-activate-entry(int);
    callback picker-use-current-dir();
    callback picker-cancel();
    callback attempt-login(int, string);
    callback set-power-profile(int);
    callback apply-idle-timers(int, int, int);
    callback scan-smart-health();
    callback select-user(int);
    callback add-user-account(string, int, string);
    callback delete-selected-user();
    callback set-selected-user-password(string);
    callback refresh-dev-ai();
    callback create-devbox(int, string);
    callback open-devbox-shell();
    callback remove-devbox();
    callback select-devbox(int);
    callback ai-action(string, string);
    callback ai-ask(string, string);
    callback quick-toggle-theme(bool);

    VerticalLayout {
        padding: 14px;
        spacing: 12px;

        // Top Header Bar
        if !root.quick-settings-only && !root.login-dialog-only && !root.ai-dialog-only && !root.start-menu-only && !root.emoji-dialog-only : Card {
            height: 54px;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 10px;

                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    horizontal-stretch: 1;
                    Text {
                        text: root.power-dialog-only ? root.tr.title-power : (root.taskmgr-dialog-only ? root.tr.title-taskmgr : (root.oobe-dialog-only ? root.tr.title-oobe : (root.open-dialog-only ? root.tr.title-open : root.tr.title-center)));
                        color: UiTheme.text-primary;
                        font-size: 15px;
                        font-weight: 700;
                        overflow: elide;
                    }
                    Text {
                        text: root.hw-summary;
                        color: UiTheme.text-accent;
                        font-size: 11px;
                        overflow: elide;
                    }
                }

                TabPill {
                    label: root.lang-badge;
                    active: false;
                    clicked => { root.toggle-language(); }
                }

                if root.show-tabs : HorizontalLayout {
                    alignment: center;
                    spacing: 6px;
                    TabPill {
                        label: root.tr.tab-apps;
                        active: root.active-tab == 0;
                        clicked => { root.active-tab = 0; }
                    }
                    TabPill {
                        label: root.tr.tab-store;
                        active: root.active-tab == 4;
                        clicked => {
                            root.active-tab = 4;
                            root.store-detail-open = false;
                            root.store-filter-changed(root.store-category, root.store-search-query);
                        }
                    }
                    TabPill {
                        label: root.tr.tab-dev-ai;
                        active: root.active-tab == 5;
                        clicked => { root.active-tab = 5; root.refresh-dev-ai(); }
                    }
                    TabPill {
                        label: root.tr.tab-install;
                        active: root.active-tab == 1;
                        clicked => { root.active-tab = 1; }
                    }
                    TabPill {
                        label: root.tr.tab-system;
                        active: root.active-tab == 2;
                        clicked => { root.active-tab = 2; root.refresh-all(); }
                    }
                    TabPill {
                        label: root.tr.tab-settings;
                        active: root.active-tab == 3;
                        clicked => { root.active-tab = 3; root.refresh-settings(); }
                    }
                    TabPill {
                        label: root.tr.tab-tasks;
                        active: false;
                        clicked => { root.taskmgr-dialog-only = true; root.refresh-tasks(); }
                    }
                    TabPill {
                        label: root.tr.tab-power;
                        active: false;
                        danger: true;
                        clicked => { root.power-dialog-only = true; }
                    }
                }
            }
        }

        // Tier-1 Win11/macOS Quick Settings Control Center (--quick-settings)
        if root.quick-settings-only : VerticalLayout {
            spacing: 10px;
            vertical-stretch: 1;

            Card {
                vertical-stretch: 1;
                VerticalLayout {
                    padding: 14px;
                    spacing: 12px;

                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: root.tr.title-quick;
                            color: UiTheme.text-primary;
                            font-size: 16px;
                            font-weight: 800;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                        Button {
                            text: "AI (Win+A)";
                            clicked => {
                                root.quick-settings-only = false;
                                root.ai-dialog-only = true;
                                root.refresh-dev-ai();
                            }
                        }
                    }

                    // 2x3 Quick-Toggle Tiles Grid
                    HorizontalLayout {
                        spacing: 8px;
                        Rectangle {
                            horizontal-stretch: 1;
                            height: 46px;
                            border-radius: 8px;
                            background: root.set-wifi-enabled ? UiTheme.accent : UiTheme.surface-subtle;
                            border-width: 1px;
                            border-color: root.set-wifi-enabled ? UiTheme.accent-bright : UiTheme.card-border;
                            TouchArea { clicked => { if (root.set-net-available) { root.set-wifi-enabled = !root.set-wifi-enabled; root.toggle-wifi-radio(root.set-wifi-enabled); } } }
                            Text {
                                text: root.set-wifi-enabled ? "Wi-Fi: ON" : "Wi-Fi: OFF";
                                color: root.set-wifi-enabled ? #ffffff : UiTheme.text-primary;
                                font-size: 12px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            height: 46px;
                            border-radius: 8px;
                            background: root.set-bt-powered ? UiTheme.accent : UiTheme.surface-subtle;
                            border-width: 1px;
                            border-color: root.set-bt-powered ? UiTheme.accent-bright : UiTheme.card-border;
                            TouchArea { clicked => { root.set-bt-powered = !root.set-bt-powered; root.toggle-bluetooth(root.set-bt-powered); } }
                            Text {
                                text: root.set-bt-powered ? "Bluetooth: ON" : "Bluetooth: OFF";
                                color: root.set-bt-powered ? #ffffff : UiTheme.text-primary;
                                font-size: 12px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Rectangle {
                            horizontal-stretch: 1;
                            height: 46px;
                            border-radius: 8px;
                            background: root.set-nightlight-enabled ? #d97706 : UiTheme.surface-subtle;
                            border-width: 1px;
                            border-color: root.set-nightlight-enabled ? #fbbf24 : UiTheme.card-border;
                            TouchArea { clicked => { root.set-nightlight-enabled = !root.set-nightlight-enabled; root.nightlight-changed(root.set-nightlight-enabled, Math.round(root.set-nightlight-temp)); } }
                            Text {
                                text: root.set-nightlight-enabled ? "Night Light: ON" : "Night Light: OFF";
                                color: root.set-nightlight-enabled ? #ffffff : UiTheme.text-primary;
                                font-size: 12px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            height: 46px;
                            border-radius: 8px;
                            background: UiTheme.light ? #0ea5e9 : UiTheme.surface-subtle;
                            border-width: 1px;
                            border-color: UiTheme.light ? #38bdf8 : UiTheme.card-border;
                            TouchArea { clicked => { root.quick-toggle-theme(!UiTheme.light); } }
                            Text {
                                text: UiTheme.light ? "Theme: Light" : "Theme: Dark";
                                color: UiTheme.light ? #ffffff : UiTheme.text-primary;
                                font-size: 12px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Rectangle {
                            horizontal-stretch: 1;
                            height: 42px;
                            border-radius: 8px;
                            background: root.gaming-mode-enabled ? #16a34a : UiTheme.surface-subtle;
                            border-width: 1px;
                            border-color: root.gaming-mode-enabled ? #4ade80 : UiTheme.card-border;
                            TouchArea { clicked => { root.gaming-mode-enabled = !root.gaming-mode-enabled; root.toggle-game-mode(root.gaming-mode-enabled); } }
                            Text {
                                text: root.gaming-mode-enabled ? "Game Mode: ON" : "Game Mode: OFF";
                                color: root.gaming-mode-enabled ? #ffffff : UiTheme.text-primary;
                                font-size: 12px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            height: 42px;
                            border-radius: 8px;
                            background: UiTheme.surface-subtle;
                            border-width: 1px;
                            border-color: UiTheme.card-border;
                            TouchArea { clicked => { root.lock-screen-now(); } }
                            Text {
                                text: "Lock Screen (Win+L)";
                                color: UiTheme.text-primary;
                                font-size: 12px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Rectangle {
                            horizontal-stretch: 1;
                            height: 42px;
                            border-radius: 8px;
                            background: root.notify-dnd ? #7c3aed : UiTheme.surface-subtle;
                            border-width: 1px;
                            border-color: root.notify-dnd ? #c084fc : UiTheme.card-border;
                            TouchArea { clicked => { root.notify-dnd = !root.notify-dnd; root.toggle-dnd(root.notify-dnd); } }
                            Text {
                                text: root.notify-dnd ? root.tr.tile-dnd + ": ON" : root.tr.tile-dnd + ": OFF";
                                color: root.notify-dnd ? #ffffff : UiTheme.text-primary;
                                font-size: 12px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            height: 42px;
                            border-radius: 8px;
                            background: root.cap-recording ? #dc2626 : UiTheme.surface-subtle;
                            border-width: 1px;
                            border-color: root.cap-recording ? #f87171 : UiTheme.card-border;
                            TouchArea {
                                clicked => {
                                    root.quick-settings-only = false;
                                    root.capture-dialog-only = true;
                                }
                            }
                            Text {
                                text: root.cap-recording ? "REC ● Stop" : root.tr.tile-capture;
                                color: root.cap-recording ? #ffffff : UiTheme.text-primary;
                                font-size: 12px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Button {
                            text: root.tr.btn-dismiss-notifs;
                            horizontal-stretch: 1;
                            clicked => { root.dismiss-all-notifications(); }
                        }
                        Button {
                            text: root.tr.btn-restore-notif;
                            horizontal-stretch: 1;
                            clicked => { root.restore-last-notification(); }
                        }
                        Button {
                            text: "OSK";
                            clicked => { root.toggle-osk(); }
                        }
                    }

                    Rectangle { height: 1px; background: UiTheme.card-border; }

                    HorizontalLayout {
                        spacing: 10px;
                        Text { text: "Volume (" + Math.round(root.set-audio-volume) + "%)"; color: UiTheme.text-secondary; font-size: 12px; width: 112px; vertical-alignment: center; }
                        Slider {
                            minimum: 0;
                            maximum: 100;
                            step: 2;
                            value <=> root.set-audio-volume;
                            released(v) => { root.audio-volume-changed(Math.round(v)); }
                            horizontal-stretch: 1;
                        }
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        Text { text: "Brightness (" + Math.round(root.set-brightness-pct) + "%)"; color: UiTheme.text-secondary; font-size: 12px; width: 112px; vertical-alignment: center; }
                        Slider {
                            minimum: 5;
                            maximum: 100;
                            step: 5;
                            value <=> root.set-brightness-pct;
                            enabled: root.set-backlight-available;
                            released(v) => { root.brightness-changed(Math.round(v)); }
                            horizontal-stretch: 1;
                        }
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        Text { text: "Power Profile:"; color: UiTheme.text-muted; font-size: 12px; width: 112px; vertical-alignment: center; }
                        ComboBox {
                            model: ["Power Saver (TLP)", "Balanced", "Performance"];
                            current-index <=> root.pwr-profile-idx;
                            selected => { root.set-power-profile(self.current-index); }
                            horizontal-stretch: 1;
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                Button {
                    text: "All Settings";
                    clicked => {
                        root.quick-settings-only = false;
                        root.active-tab = 3;
                        root.refresh-settings();
                    }
                }
                Button {
                    text: "Power";
                    clicked => {
                        root.quick-settings-only = false;
                        root.power-dialog-only = true;
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                Button {
                    text: root.tr.btn-close;
                    clicked => { root.cancel-open(); }
                }
            }
        }


        // Tier-1 Multi-User Sign-In Greeter (--login)
        if root.login-dialog-only : VerticalLayout {
            spacing: 12px;
            vertical-stretch: 1;

            Rectangle {
                height: 110px;
                border-radius: 12px;
                background: @linear-gradient(135deg, #0f172a 0%, #0c4a6e 55%, #312e81 100%);
                border-width: 1px;
                border-color: #38bdf8;
                VerticalLayout {
                    padding: 14px;
                    spacing: 4px;
                    alignment: center;
                    Text {
                        text: root.login-clock-text;
                        color: #ffffff;
                        font-size: 22px;
                        font-weight: 800;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: root.tr.title-login + " • Universal OS";
                        color: #bae6fd;
                        font-size: 12px;
                        horizontal-alignment: center;
                    }
                }
            }

            Card {
                vertical-stretch: 1;
                VerticalLayout {
                    padding: 18px;
                    spacing: 12px;
                    alignment: center;

                    HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: 56px;
                            height: 56px;
                            border-radius: 28px;
                            background: #0284c7;
                            border-width: 2px;
                            border-color: #7dd3fc;
                            Text {
                                text: "UC";
                                color: #ffffff;
                                font-size: 18px;
                                font-weight: 800;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        Text { text: "Account:"; color: UiTheme.text-muted; font-size: 13px; width: 84px; vertical-alignment: center; }
                        ComboBox {
                            model: root.login-user-names;
                            current-index <=> root.login-user-idx;
                            horizontal-stretch: 1;
                        }
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        Text { text: "Password:"; color: UiTheme.text-muted; font-size: 13px; width: 84px; vertical-alignment: center; }
                        LineEdit {
                            text <=> root.login-password;
                            placeholder-text: "Enter password & press Enter";
                            input-type: InputType.password;
                            horizontal-stretch: 1;
                            accepted => { root.attempt-login(root.login-user-idx, root.login-password); }
                        }
                    }

                    if root.login-error != "" : Text {
                        text: root.login-error;
                        color: #ef4444;
                        font-size: 12px;
                        horizontal-alignment: center;
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        Button {
                            text: root.tr.btn-reboot;
                            clicked => { root.power-action("reboot"); }
                        }
                        Button {
                            text: root.tr.btn-shutdown;
                            clicked => { root.power-action("poweroff"); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Button {
                            text: "Sign In";
                            primary: true;
                            clicked => { root.attempt-login(root.login-user-idx, root.login-password); }
                        }
                    }
                }
            }
        }

        // Bilingual Multi-Provider System AI Copilot Drawer (--ai / Win+A)
        if root.ai-dialog-only : VerticalLayout {
            spacing: 10px;
            vertical-stretch: 1;

            Rectangle {
                height: 62px;
                border-radius: 10px;
                background: @linear-gradient(135deg, #312e81 0%, #1d4ed8 60%, #0284c7 100%);
                border-width: 1px;
                border-color: #38bdf8;
                HorizontalLayout {
                    padding: 12px;
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        spacing: 2px;
                        Text {
                            text: "UniCore AI System Assistant (Win+A)";
                            color: #ffffff;
                            font-size: 15px;
                            font-weight: 800;
                        }
                        Text {
                            text: "Offline Ollama (0 MB idle) + Optional Gemini / OpenAI API for Low-RAM PCs";
                            color: #e0f2fe;
                            font-size: 11px;
                        }
                    }
                    Button {
                        text: "Full Center";
                        clicked => {
                            root.ai-dialog-only = false;
                            root.active-tab = 5;
                            root.refresh-dev-ai();
                        }
                    }
                }
            }

            Card {
                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 8px;
                        ComboBox {
                            model: ["Local Offline (Ollama)", "Google Gemini API", "OpenAI-Compatible API"];
                            current-index <=> root.ai-provider-idx;
                            width: 195px;
                        }
                        LineEdit {
                            text <=> root.ai-model-input;
                            placeholder-text: root.ai-provider-idx == 1 ? "gemini-2.5-flash" : (root.ai-provider-idx == 2 ? "gpt-4o-mini" : "llama3.2:1b");
                            horizontal-stretch: 1;
                        }
                        Button {
                            text: "Save Provider";
                            clicked => { root.ai-save-provider(root.ai-provider-idx, root.ai-model-input, root.ai-base-url-input, root.ai-api-key-input); }
                        }
                    }
                    if root.ai-provider-idx != 0 : HorizontalLayout {
                        spacing: 8px;
                        LineEdit {
                            text <=> root.ai-api-key-input;
                            placeholder-text: root.ai-api-key-set ? "API key saved securely (leave blank to keep)" : "Paste API key (stored chmod 600 in /data/ai)";
                            input-type: InputType.password;
                            horizontal-stretch: 1;
                        }
                        if root.ai-provider-idx == 2 : LineEdit {
                            text <=> root.ai-base-url-input;
                            placeholder-text: "https://api.openai.com/v1";
                            width: 205px;
                        }
                    }
                    CheckBox {
                        text: "Include live read-only diagnostics (Hardware, Wi-Fi, Power, Secure Boot, Storage)";
                        checked <=> root.ai-include-context;
                    }
                }
            }

            Card {
                vertical-stretch: 1;
                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 8px;
                        LineEdit {
                            text <=> root.ai-prompt-input;
                            placeholder-text: "Tanya apa sahaja (BM/EN) — cth: Kenapa Wi-Fi perlahan / baiki ralat .exe...";
                            enabled: !root.ai-busy;
                            horizontal-stretch: 1;
                            accepted => { root.ai-copilot-ask(root.ai-prompt-input, root.ai-include-context); }
                        }
                        Button {
                            text: root.ai-busy ? "Thinking..." : "Ask AI";
                            primary: true;
                            enabled: !root.ai-busy && root.ai-prompt-input != "";
                            clicked => { root.ai-copilot-ask(root.ai-prompt-input, root.ai-include-context); }
                        }
                    }
                    if root.ai-busy : ProgressIndicator {
                        indeterminate: true;
                        height: 6px;
                    }
                    Rectangle {
                        vertical-stretch: 1;
                        background: UiTheme.surface-subtle;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: UiTheme.card-border;
                        ScrollView {
                            Text {
                                text: root.ai-response-text != "" ? root.ai-response-text : "Tip: Pilih pembekal di atas (Ollama tempatan untuk PC >=4 GB RAM, atau Gemini/OpenAI API untuk PC lama 512 MB–2 GB RAM). Semua tindakan sistem hanya dijalankan selepas anda klik butang selamat di bawah.";
                                color: UiTheme.text-primary;
                                font-size: 12px;
                                wrap: word-wrap;
                                x: 10px;
                                y: 8px;
                                width: parent.width - 20px;
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        Button { text: "Wi-Fi Settings"; clicked => { root.ai-quick-nav("wifi"); } }
                        Button { text: "Win32 / Apps"; clicked => { root.ai-quick-nav("apps"); } }
                        Button { text: "Power & Health"; clicked => { root.ai-quick-nav("power"); } }
                        Button { text: "App Store"; clicked => { root.ai-quick-nav("store"); } }
                        Rectangle { horizontal-stretch: 1; }
                        Button { text: root.tr.btn-close; clicked => { root.cancel-open(); } }
                    }
                }
            }
        }

        // Screen Capture & MP4 Video Recorder Dialog (--capture / Print / Win+Shift+R)
        if root.capture-dialog-only : VerticalLayout {
            spacing: 10px;
            vertical-stretch: 1;

            Rectangle {
                height: 60px;
                border-radius: 10px;
                background: root.cap-recording
                    ? @linear-gradient(135deg, #7f1d1d 0%, #dc2626 60%, #991b1b 100%)
                    : @linear-gradient(135deg, #0f172a 0%, #0369a1 55%, #1d4ed8 100%);
                border-width: 1px;
                border-color: root.cap-recording ? #f87171 : #38bdf8;
                HorizontalLayout {
                    padding: 12px;
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        spacing: 2px;
                        Text {
                            text: root.tr.title-capture;
                            color: #ffffff;
                            font-size: 15px;
                            font-weight: 800;
                        }
                        Text {
                            text: root.cap-recording
                                ? "REC ACTIVE -> " + root.cap-active-file
                                : "Screenshots -> Pictures/Screenshots (auto-copied) | Video MP4 -> Videos/Recordings";
                            color: #e0f2fe;
                            font-size: 11px;
                            overflow: elide;
                        }
                    }
                }
            }

            Card {
                VerticalLayout {
                    padding: 14px;
                    spacing: 10px;

                    HorizontalLayout {
                        spacing: 10px;
                        Text {
                            text: root.tr.lbl-delay;
                            color: UiTheme.text-muted;
                            font-size: 12px;
                            width: 110px;
                            vertical-alignment: center;
                        }
                        ComboBox {
                            model: ["0s (Instant)", "3s Delay", "5s Delay"];
                            current-index <=> root.cap-delay-idx;
                            horizontal-stretch: 1;
                        }
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        Button {
                            text: root.tr.btn-shot-full;
                            primary: !root.cap-recording;
                            enabled: !root.cap-busy;
                            horizontal-stretch: 1;
                            clicked => { root.capture-take-shot(false, root.cap-delay-idx == 2 ? 5 : (root.cap-delay-idx == 1 ? 3 : 0)); }
                        }
                        Button {
                            text: root.tr.btn-shot-region;
                            enabled: !root.cap-busy;
                            horizontal-stretch: 1;
                            clicked => { root.capture-take-shot(true, root.cap-delay-idx == 2 ? 5 : (root.cap-delay-idx == 1 ? 3 : 0)); }
                        }
                    }

                    Rectangle { height: 1px; background: UiTheme.card-border; }

                    Switch {
                        text: root.tr.chk-rec-audio;
                        checked <=> root.cap-record-audio;
                        enabled: !root.cap-recording && root.cap-wf-available;
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        if !root.cap-recording : Button {
                            text: root.tr.btn-rec-start;
                            primary: true;
                            enabled: root.cap-wf-available && !root.cap-busy;
                            horizontal-stretch: 1;
                            clicked => { root.capture-start-recording(false, root.cap-record-audio); }
                        }
                        if !root.cap-recording : Button {
                            text: "Record Region (MP4)";
                            enabled: root.cap-wf-available && !root.cap-busy;
                            horizontal-stretch: 1;
                            clicked => { root.capture-start-recording(true, root.cap-record-audio); }
                        }
                        if root.cap-recording : Button {
                            text: root.tr.btn-rec-stop;
                            primary: true;
                            horizontal-stretch: 1;
                            clicked => { root.capture-stop-recording(); }
                        }
                    }

                    if root.cap-status != "" : Text {
                        text: root.cap-status;
                        color: UiTheme.text-accent;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                Button {
                    text: root.tr.btn-open-shots;
                    clicked => { root.capture-open-dir("shots"); }
                }
                Button {
                    text: root.tr.btn-open-videos;
                    clicked => { root.capture-open-dir("videos"); }
                }
                Rectangle { horizontal-stretch: 1; }
                Button {
                    text: root.tr.btn-close;
                    clicked => { root.cancel-open(); }
                }
            }
        }

        // Windows 11 / Zorin-Style Native Graphical Start Menu (--start-menu / Win key)
        if root.start-menu-only : VerticalLayout {
            spacing: 10px;
            vertical-stretch: 1;

            Card {
                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;

                    HorizontalLayout {
                        spacing: 8px;
                        LineEdit {
                            text <=> root.start-search-query;
                            placeholder-text: root.tr.start-search-hint;
                            horizontal-stretch: 1;
                            edited(txt) => { root.start-filter-changed(root.start-category, txt); }
                        }
                        TabPill {
                            label: root.lang-badge;
                            active: false;
                            clicked => { root.toggle-language(); }
                        }
                    }

                    HorizontalLayout {
                        spacing: 6px;
                        TabPill {
                            label: root.tr.start-cat-all;
                            active: root.start-category == "all";
                            clicked => { root.start-category = "all"; root.start-filter-changed("all", root.start-search-query); }
                        }
                        TabPill {
                            label: root.tr.start-cat-internet;
                            active: root.start-category == "internet";
                            clicked => { root.start-category = "internet"; root.start-filter-changed("internet", root.start-search-query); }
                        }
                        TabPill {
                            label: root.tr.start-cat-office;
                            active: root.start-category == "office";
                            clicked => { root.start-category = "office"; root.start-filter-changed("office", root.start-search-query); }
                        }
                        TabPill {
                            label: root.tr.start-cat-media;
                            active: root.start-category == "media";
                            clicked => { root.start-category = "media"; root.start-filter-changed("media", root.start-search-query); }
                        }
                        TabPill {
                            label: root.tr.start-cat-gaming;
                            active: root.start-category == "gaming";
                            clicked => { root.start-category = "gaming"; root.start-filter-changed("gaming", root.start-search-query); }
                        }
                        TabPill {
                            label: root.tr.start-cat-system;
                            active: root.start-category == "system";
                            clicked => { root.start-category = "system"; root.start-filter-changed("system", root.start-search-query); }
                        }
                    }
                }
            }

            Card {
                vertical-stretch: 1;
                ScrollView {
                    VerticalLayout {
                        padding: 12px;
                        spacing: 10px;
                        alignment: start;

                        if root.start-category == "all" && root.start-search-query == "" : VerticalLayout {
                            spacing: 8px;
                            Text {
                                text: root.tr.start-pinned;
                                color: UiTheme.text-accent;
                                font-size: 12px;
                                font-weight: 700;
                            }
                            for prow in root.start-pinned-rows : HorizontalLayout {
                                spacing: 8px;
                                if prow.has-0 : Rectangle {
                                    horizontal-stretch: 1;
                                    height: 68px;
                                    border-radius: 10px;
                                    background: sp0.has-hover ? UiTheme.surface-hover : UiTheme.surface-subtle;
                                    border-width: 1px;
                                    border-color: sp0.has-hover ? UiTheme.accent-bright : UiTheme.card-border;
                                    sp0 := TouchArea { clicked => { root.start-launch-app(prow.e0); } }
                                    VerticalLayout {
                                        padding: 6px;
                                        spacing: 4px;
                                        alignment: center;
                                        HorizontalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 30px; height: 30px; border-radius: 8px; background: prow.c0;
                                                Text { text: prow.b0; color: #ffffff; font-size: 10px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                            }
                                        }
                                        Text { text: prow.n0; color: UiTheme.text-primary; font-size: 11px; font-weight: 600; horizontal-alignment: center; overflow: elide; }
                                    }
                                }
                                if prow.has-1 : Rectangle {
                                    horizontal-stretch: 1;
                                    height: 68px;
                                    border-radius: 10px;
                                    background: sp1.has-hover ? UiTheme.surface-hover : UiTheme.surface-subtle;
                                    border-width: 1px;
                                    border-color: sp1.has-hover ? UiTheme.accent-bright : UiTheme.card-border;
                                    sp1 := TouchArea { clicked => { root.start-launch-app(prow.e1); } }
                                    VerticalLayout {
                                        padding: 6px;
                                        spacing: 4px;
                                        alignment: center;
                                        HorizontalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 30px; height: 30px; border-radius: 8px; background: prow.c1;
                                                Text { text: prow.b1; color: #ffffff; font-size: 10px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                            }
                                        }
                                        Text { text: prow.n1; color: UiTheme.text-primary; font-size: 11px; font-weight: 600; horizontal-alignment: center; overflow: elide; }
                                    }
                                }
                                if prow.has-2 : Rectangle {
                                    horizontal-stretch: 1;
                                    height: 68px;
                                    border-radius: 10px;
                                    background: sp2.has-hover ? UiTheme.surface-hover : UiTheme.surface-subtle;
                                    border-width: 1px;
                                    border-color: sp2.has-hover ? UiTheme.accent-bright : UiTheme.card-border;
                                    sp2 := TouchArea { clicked => { root.start-launch-app(prow.e2); } }
                                    VerticalLayout {
                                        padding: 6px;
                                        spacing: 4px;
                                        alignment: center;
                                        HorizontalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 30px; height: 30px; border-radius: 8px; background: prow.c2;
                                                Text { text: prow.b2; color: #ffffff; font-size: 10px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                            }
                                        }
                                        Text { text: prow.n2; color: UiTheme.text-primary; font-size: 11px; font-weight: 600; horizontal-alignment: center; overflow: elide; }
                                    }
                                }
                                if prow.has-3 : Rectangle {
                                    horizontal-stretch: 1;
                                    height: 68px;
                                    border-radius: 10px;
                                    background: sp3.has-hover ? UiTheme.surface-hover : UiTheme.surface-subtle;
                                    border-width: 1px;
                                    border-color: sp3.has-hover ? UiTheme.accent-bright : UiTheme.card-border;
                                    sp3 := TouchArea { clicked => { root.start-launch-app(prow.e3); } }
                                    VerticalLayout {
                                        padding: 6px;
                                        spacing: 4px;
                                        alignment: center;
                                        HorizontalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 30px; height: 30px; border-radius: 8px; background: prow.c3;
                                                Text { text: prow.b3; color: #ffffff; font-size: 10px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                            }
                                        }
                                        Text { text: prow.n3; color: UiTheme.text-primary; font-size: 11px; font-weight: 600; horizontal-alignment: center; overflow: elide; }
                                    }
                                }
                            }
                            Rectangle { height: 1px; background: UiTheme.card-border; }
                        }

                        Text {
                            text: root.tr.start-all-apps;
                            color: UiTheme.text-muted;
                            font-size: 12px;
                            font-weight: 700;
                        }

                        for arow in root.start-app-rows : HorizontalLayout {
                            spacing: 8px;
                            if arow.has-a : Rectangle {
                                horizontal-stretch: 1;
                                height: 48px;
                                border-radius: 8px;
                                background: sa0.has-hover ? UiTheme.surface-hover : UiTheme.surface-subtle;
                                border-width: 1px;
                                border-color: sa0.has-hover ? UiTheme.accent-bright : UiTheme.card-border;
                                sa0 := TouchArea { clicked => { root.start-launch-app(arow.a-exec); } }
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 8px;
                                    Rectangle {
                                        width: 30px; height: 30px; y: 9px; border-radius: 7px; background: arow.a-color;
                                        Text { text: arow.a-badge; color: #ffffff; font-size: 10px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        horizontal-stretch: 1;
                                        spacing: 1px;
                                        Text { text: arow.a-name; color: UiTheme.text-primary; font-size: 12px; font-weight: 600; overflow: elide; }
                                        Text { text: arow.a-desc; color: UiTheme.text-muted; font-size: 10px; overflow: elide; }
                                    }
                                }
                            }
                            if arow.has-b : Rectangle {
                                horizontal-stretch: 1;
                                height: 48px;
                                border-radius: 8px;
                                background: sa1.has-hover ? UiTheme.surface-hover : UiTheme.surface-subtle;
                                border-width: 1px;
                                border-color: sa1.has-hover ? UiTheme.accent-bright : UiTheme.card-border;
                                sa1 := TouchArea { clicked => { root.start-launch-app(arow.b-exec); } }
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 8px;
                                    Rectangle {
                                        width: 30px; height: 30px; y: 9px; border-radius: 7px; background: arow.b-color;
                                        Text { text: arow.b-badge; color: #ffffff; font-size: 10px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        horizontal-stretch: 1;
                                        spacing: 1px;
                                        Text { text: arow.b-name; color: UiTheme.text-primary; font-size: 12px; font-weight: 600; overflow: elide; }
                                        Text { text: arow.b-desc; color: UiTheme.text-muted; font-size: 10px; overflow: elide; }
                                    }
                                }
                            }
                            if !arow.has-b : Rectangle { horizontal-stretch: 1; }
                        }
                    }
                }
            }

            // Bottom User & Quick-Folders Bar
            Card {
                height: 48px;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 6px;
                    alignment: center;
                    Rectangle {
                        width: 28px; height: 28px; y: 10px; border-radius: 14px; background: UiTheme.accent;
                        Text { text: "U"; color: #ffffff; font-size: 12px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Text {
                        text: root.start-user-name;
                        color: UiTheme.text-primary;
                        font-size: 12px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Button { text: "Docs"; clicked => { root.start-open-folder("documents"); } }
                    Button { text: "Downloads"; clicked => { root.start-open-folder("downloads"); } }
                    Button { text: "Pictures"; clicked => { root.start-open-folder("pictures"); } }
                    Button {
                        text: "Emoji";
                        clicked => {
                            root.start-menu-only = false;
                            root.emoji-dialog-only = true;
                            root.emoji-filter-changed("all", "");
                        }
                    }
                    TabPill {
                        label: root.tr.tab-power;
                        active: false;
                        danger: true;
                        clicked => {
                            root.start-menu-only = false;
                            root.power-dialog-only = true;
                        }
                    }
                }
            }
        }

        // Windows 11-Style Emoji Picker (--emoji / Win+.)
        if root.emoji-dialog-only : VerticalLayout {
            spacing: 10px;
            vertical-stretch: 1;

            Card {
                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;
                    Text {
                        text: root.tr.title-emoji;
                        color: UiTheme.text-primary;
                        font-size: 14px;
                        font-weight: 800;
                    }
                    LineEdit {
                        text <=> root.emoji-search-query;
                        placeholder-text: root.tr.emoji-search-hint;
                        edited(txt) => { root.emoji-filter-changed(root.emoji-category, txt); }
                    }
                    HorizontalLayout {
                        spacing: 5px;
                        TabPill { label: "All"; active: root.emoji-category == "all"; clicked => { root.emoji-category = "all"; root.emoji-filter-changed("all", root.emoji-search-query); } }
                        TabPill { label: "Smileys"; active: root.emoji-category == "smileys"; clicked => { root.emoji-category = "smileys"; root.emoji-filter-changed("smileys", root.emoji-search-query); } }
                        TabPill { label: "Hands"; active: root.emoji-category == "gestures"; clicked => { root.emoji-category = "gestures"; root.emoji-filter-changed("gestures", root.emoji-search-query); } }
                        TabPill { label: "Work"; active: root.emoji-category == "work"; clicked => { root.emoji-category = "work"; root.emoji-filter-changed("work", root.emoji-search-query); } }
                        TabPill { label: "Symbols"; active: root.emoji-category == "symbols"; clicked => { root.emoji-category = "symbols"; root.emoji-filter-changed("symbols", root.emoji-search-query); } }
                    }
                }
            }

            Card {
                vertical-stretch: 1;
                ScrollView {
                    VerticalLayout {
                        padding: 10px;
                        spacing: 6px;
                        alignment: start;
                        for erow in root.emoji-rows : HorizontalLayout {
                            spacing: 6px;
                            for sym in [erow.e0, erow.e1, erow.e2, erow.e3, erow.e4, erow.e5, erow.e6, erow.e7] : Rectangle {
                                horizontal-stretch: 1;
                                height: 40px;
                                border-radius: 8px;
                                background: sym == "" ? transparent : (eta.has-hover ? UiTheme.surface-hover : UiTheme.surface-subtle);
                                eta := TouchArea {
                                    enabled: sym != "";
                                    clicked => { root.emoji-selected(sym); }
                                }
                                Text {
                                    text: sym;
                                    font-size: 20px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: root.emoji-status != "" ? root.emoji-status : "Click any emoji to copy & insert";
                    color: UiTheme.text-accent;
                    font-size: 11px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                Button {
                    text: root.tr.btn-close;
                    clicked => { root.cancel-open(); }
                }
            }
        }

        // Built-in Graphical File Picker Overlay
        if root.picker-open : Card {
            vertical-stretch: 1;
            VerticalLayout {
                padding: 14px;
                spacing: 10px;

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "Browse File / Folder";
                        color: UiTheme.text-primary;
                        font-size: 15px;
                        font-weight: 700;
                    }
                    Text {
                        text: root.picker-dir;
                        color: UiTheme.text-accent;
                        font-size: 12px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                }

                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 4px;
                        alignment: start;

                        for entry[idx] in root.picker-entries : Rectangle {
                            height: 36px;
                            border-radius: 6px;
                            background: pentry-ta.has-hover ? UiTheme.surface-hover : UiTheme.surface-subtle;
                            border-width: 1px;
                            border-color: UiTheme.card-border;

                            pentry-ta := TouchArea {
                                clicked => { root.picker-activate-entry(idx); }
                            }

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 10px;
                                Text {
                                    text: entry.name;
                                    color: UiTheme.text-primary;
                                    font-size: 12px;
                                    font-weight: entry.is-dir ? 700 : 500;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                Text {
                                    text: entry.detail;
                                    color: UiTheme.text-muted;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    if root.picker-target == "backup-dir" : Button {
                        text: "Select Current Folder";
                        primary: true;
                        clicked => { root.picker-use-current-dir(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        text: root.tr.btn-cancel;
                        clicked => { root.picker-cancel(); }
                    }
                }
            }
        }

        // Power Options Modal (--power or header Power button)
        if root.power-dialog-only : VerticalLayout {
            spacing: 12px;
            vertical-stretch: 1;

            Card {
                vertical-stretch: 1;
                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;
                    alignment: center;

                    Text {
                        text: root.tr.power-prompt;
                        color: UiTheme.text-secondary;
                        font-size: 14px;
                        font-weight: 600;
                        horizontal-alignment: center;
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        Button {
                            text: root.tr.btn-shutdown;
                            primary: true;
                            horizontal-stretch: 1;
                            clicked => { root.power-action("poweroff"); }
                        }
                        Button {
                            text: root.tr.btn-reboot;
                            horizontal-stretch: 1;
                            clicked => { root.power-action("reboot"); }
                        }
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        Button {
                            text: root.tr.btn-sleep;
                            horizontal-stretch: 1;
                            clicked => { root.power-action("suspend"); }
                        }
                        Button {
                            text: root.tr.btn-logout;
                            horizontal-stretch: 1;
                            clicked => { root.power-action("logout"); }
                        }
                    }
                }
            }

            HorizontalLayout {
                Button {
                    text: root.tr.btn-back-center;
                    clicked => { root.power-dialog-only = false; }
                }
                Rectangle { horizontal-stretch: 1; }
                Button {
                    text: root.tr.btn-close;
                    clicked => { root.cancel-open(); }
                }
            }
        }


        // Lightweight Task Manager (--taskmgr or header Tasks button)
        if root.taskmgr-dialog-only && !root.power-dialog-only : VerticalLayout {
            spacing: 10px;
            vertical-stretch: 1;

            Card {
                vertical-stretch: 1;
                VerticalLayout {
                    padding: 14px;
                    spacing: 8px;

                    Text {
                        text: root.tr.taskmgr-heading;
                        color: UiTheme.text-accent;
                        font-size: 13px;
                        font-weight: 700;
                    }

                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 6px;
                            alignment: start;

                            if root.task-list.length == 0 : Text {
                                text: root.tr.taskmgr-empty;
                                color: UiTheme.text-muted;
                                font-size: 12px;
                            }

                            for task[idx] in root.task-list : Rectangle {
                                height: 46px;
                                border-radius: 6px;
                                background: idx == root.selected-task-idx ? #0369a1 : (tta.has-hover ? UiTheme.surface-hover : UiTheme.surface-subtle);
                                border-width: 1px;
                                border-color: idx == root.selected-task-idx ? #38bdf8 : UiTheme.card-border;

                                tta := TouchArea {
                                    clicked => { root.select-task(idx); }
                                }

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 10px;
                                    VerticalLayout {
                                        alignment: center;
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        Text {
                                            text: task.name + "  (PID " + task.pid + ")";
                                            color: idx == root.selected-task-idx ? #ffffff : UiTheme.text-primary;
                                            font-size: 13px;
                                            font-weight: 600;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: task.detail;
                                            color: idx == root.selected-task-idx ? #e0f2fe : UiTheme.text-muted;
                                            font-size: 11px;
                                            overflow: elide;
                                        }
                                    }
                                    Text {
                                        text: task.ram-label;
                                        color: UiTheme.text-accent;
                                        font-size: 12px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                Button {
                    text: root.tr.btn-end-task;
                    primary: true;
                    enabled: root.selected-task-pid > 1;
                    clicked => { root.end-task(root.selected-task-pid, false); }
                }
                Button {
                    text: root.tr.btn-force-kill;
                    enabled: root.selected-task-pid > 1;
                    clicked => { root.end-task(root.selected-task-pid, true); }
                }
                Button {
                    text: root.tr.btn-refresh;
                    clicked => { root.refresh-tasks(); }
                }
                Rectangle { horizontal-stretch: 1; }
                Button {
                    text: root.tr.btn-back-center;
                    clicked => { root.taskmgr-dialog-only = false; }
                }
                Button {
                    text: root.tr.btn-close;
                    clicked => { root.cancel-open(); }
                }
            }
        }


        // Quick Open / Install Form (Simple Mode by default, collapsible Advanced Security & Compatibility)
        if root.open-dialog-only && !root.power-dialog-only : VerticalLayout {
            spacing: 12px;
            vertical-stretch: 1;

            Card {
                VerticalLayout {
                    padding: 14px;
                    spacing: 10px;

                    HorizontalLayout {
                        spacing: 10px;
                        Text {
                            text: root.tr.open-app-name;
                            color: UiTheme.text-muted;
                            font-size: 13px;
                            width: 110px;
                            vertical-alignment: center;
                        }
                        LineEdit {
                            text <=> root.open-name;
                            placeholder-text: "Application display name";
                            horizontal-stretch: 1;
                        }
                    }

                    InfoRow { label: root.tr.open-app-type; value: root.open-platform; value-color: UiTheme.text-accent; }

                    if !root.open-show-advanced : Text {
                        text: root.tr.open-simple-hint;
                        color: #22c55e;
                        font-size: 12px;
                        wrap: word-wrap;
                    }

                    CheckBox {
                        text: root.tr.chk-create-shortcut;
                        checked <=> root.open-create-shortcut;
                    }

                    HorizontalLayout {
                        Button {
                            text: root.open-show-advanced ? root.tr.open-hide-adv : root.tr.open-show-adv;
                            clicked => { root.open-show-advanced = !root.open-show-advanced; }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }

                    if root.open-show-advanced : VerticalLayout {
                        spacing: 8px;
                        InfoRow { label: "CPU / ABIs:"; value: root.open-arch + "  (" + root.open-sub-abis + ")"; }
                        InfoRow { label: "Binary Path:"; value: root.open-path; }
                        if root.open-supports-era : WinEraRow {
                            current-index <=> root.open-win-era-idx;
                        }
                    }
                }
            }

            if root.open-show-advanced : Card {
                VerticalLayout {
                    padding: 14px;
                    spacing: 10px;

                    PermissionGrid {
                        perm-network <=> root.open-perm-network;
                        perm-gpu <=> root.open-perm-gpu;
                        perm-documents <=> root.open-perm-documents;
                        perm-camera <=> root.open-perm-camera;
                        perm-microphone <=> root.open-perm-microphone;
                        controls-enabled: root.open-has-file;
                    }
                }
            }

            Rectangle { vertical-stretch: 1; }

            HorizontalLayout {
                spacing: 10px;
                Button {
                    text: root.open-already-installed ? root.tr.btn-run-now : root.tr.btn-install-run;
                    primary: true;
                    enabled: root.open-has-file;
                    clicked => { root.install-and-launch-open(); }
                }
                Button {
                    text: root.tr.btn-install-only;
                    enabled: root.open-has-file;
                    clicked => { root.install-only-open(); }
                }
                if root.open-show-advanced : Button {
                    text: root.tr.btn-open-center;
                    clicked => { root.switch-to-full-center(); }
                }
                Rectangle { horizontal-stretch: 1; }
                Button {
                    text: root.tr.btn-cancel;
                    clicked => { root.cancel-open(); }
                }
            }
        }

        // First-Boot Setup Wizard (--oobe)
        if root.oobe-dialog-only && !root.power-dialog-only && !root.taskmgr-dialog-only : VerticalLayout {
            spacing: 12px;
            vertical-stretch: 1;

            Card {
                vertical-stretch: 1;
                VerticalLayout {
                    padding: 18px;
                    spacing: 12px;
                    alignment: start;

                    Text {
                        text: root.oobe-step == 0 ? root.tr.oobe-step1 : (root.oobe-step == 1 ? root.tr.oobe-step-look : (root.oobe-step == 2 ? root.tr.oobe-step2 : root.tr.oobe-step3));
                        color: UiTheme.text-accent;
                        font-size: 15px;
                        font-weight: 700;
                    }

                    if root.oobe-step == 0 : VerticalLayout {
                        spacing: 10px;
                        HorizontalLayout {
                            spacing: 8px;
                            Button {
                                text: "Bahasa Melayu (BM)";
                                primary: root.oobe-lang-idx == 1;
                                clicked => { root.oobe-lang-selected(1); }
                            }
                            Button {
                                text: "English (EN)";
                                primary: root.oobe-lang-idx != 1;
                                clicked => { root.oobe-lang-selected(0); }
                            }
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            Text { text: root.tr.oobe-lang; color: UiTheme.text-muted; font-size: 13px; width: 130px; vertical-alignment: center; }
                            ComboBox {
                                model: ["English (United States - en_US.UTF-8)", "Bahasa Melayu (Malaysia - ms_MY.UTF-8)", "Minimal POSIX UTF-8 (C.UTF-8)"];
                                current-index <=> root.oobe-lang-idx;
                                selected => { root.oobe-lang-selected(self.current-index); }
                                horizontal-stretch: 1;
                            }
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            Text { text: root.tr.oobe-tz; color: UiTheme.text-muted; font-size: 13px; width: 130px; vertical-alignment: center; }
                            ComboBox {
                                model: ["UTC", "Asia/Kuala_Lumpur", "Asia/Singapore", "America/New_York", "Europe/London", "Asia/Tokyo"];
                                current-index <=> root.oobe-tz-idx;
                                horizontal-stretch: 1;
                            }
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            Text { text: root.tr.oobe-hostname; color: UiTheme.text-muted; font-size: 13px; width: 130px; vertical-alignment: center; }
                            LineEdit {
                                text <=> root.oobe-hostname;
                                placeholder-text: "unicore-pc";
                                horizontal-stretch: 1;
                            }
                        }
                    }

                    if root.oobe-step == 1 : VerticalLayout {
                        spacing: 12px;
                        Text {
                            text: root.tr.lbl-desktop-layout;
                            color: UiTheme.text-secondary;
                            font-size: 13px;
                            font-weight: 700;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Button {
                                text: "Windows 11 Modern";
                                primary: root.set-desktop-layout-idx == 0;
                                horizontal-stretch: 1;
                                clicked => { root.set-desktop-layout-idx = 0; root.preview-look-oobe(root.set-theme-idx, 0, root.set-accent-idx); }
                            }
                            Button {
                                text: "Windows 10 / Zorin";
                                primary: root.set-desktop-layout-idx == 1;
                                horizontal-stretch: 1;
                                clicked => { root.set-desktop-layout-idx = 1; root.preview-look-oobe(root.set-theme-idx, 1, root.set-accent-idx); }
                            }
                            Button {
                                text: "macOS Top Dock";
                                primary: root.set-desktop-layout-idx == 2;
                                horizontal-stretch: 1;
                                clicked => { root.set-desktop-layout-idx = 2; root.preview-look-oobe(root.set-theme-idx, 2, root.set-accent-idx); }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: root.tr.lbl-theme; color: UiTheme.text-muted; font-size: 13px; width: 130px; vertical-alignment: center; }
                            Button {
                                text: "Dark (Midnight)";
                                primary: root.set-theme-idx == 0;
                                horizontal-stretch: 1;
                                clicked => { root.set-theme-idx = 0; root.preview-look-oobe(0, root.set-desktop-layout-idx, root.set-accent-idx); }
                            }
                            Button {
                                text: "Light (Daylight)";
                                primary: root.set-theme-idx == 1;
                                horizontal-stretch: 1;
                                clicked => { root.set-theme-idx = 1; root.preview-look-oobe(1, root.set-desktop-layout-idx, root.set-accent-idx); }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: root.tr.lbl-accent-color; color: UiTheme.text-muted; font-size: 13px; width: 130px; vertical-alignment: center; }
                            for swatch[sidx] in [#0284c7, #6366f1, #059669, #d97706, #e11d48] : Rectangle {
                                width: 32px;
                                height: 32px;
                                border-radius: 16px;
                                background: swatch;
                                border-width: root.set-accent-idx == sidx ? 3px : 1px;
                                border-color: root.set-accent-idx == sidx ? UiTheme.text-primary : UiTheme.card-border;
                                TouchArea {
                                    clicked => {
                                        root.set-accent-idx = sidx;
                                        root.preview-look-oobe(root.set-theme-idx, root.set-desktop-layout-idx, sidx);
                                    }
                                }
                            }
                        }
                    }

                    if root.oobe-step == 2 : VerticalLayout {
                        spacing: 10px;
                        Text {
                            text: root.tr.oobe-pw-hint;
                            color: UiTheme.text-muted;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            Text { text: root.tr.oobe-pw; color: UiTheme.text-muted; font-size: 13px; width: 130px; vertical-alignment: center; }
                            LineEdit {
                                text <=> root.oobe-pass;
                                placeholder-text: "Optional (min 4 chars)";
                                input-type: InputType.password;
                                horizontal-stretch: 1;
                            }
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            Text { text: root.tr.oobe-pw-confirm; color: UiTheme.text-muted; font-size: 13px; width: 130px; vertical-alignment: center; }
                            LineEdit {
                                text <=> root.oobe-pass-confirm;
                                placeholder-text: "Re-enter password";
                                input-type: InputType.password;
                                horizontal-stretch: 1;
                            }
                        }
                    }

                    if root.oobe-step == 3 : VerticalLayout {
                        spacing: 10px;
                        Text {
                            text: root.tr.oobe-apps-hint;
                            color: UiTheme.text-secondary;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                        CheckBox {
                            text: root.tr.oobe-pack-office;
                            checked <=> root.oobe-pack-office;
                        }
                        CheckBox {
                            text: root.tr.oobe-pack-creative;
                            checked <=> root.oobe-pack-creative;
                        }
                        CheckBox {
                            text: root.tr.oobe-pack-gaming;
                            checked <=> root.oobe-pack-gaming;
                        }
                        Rectangle { height: 1px; background: UiTheme.card-border; }
                        Text {
                            text: root.tr.oobe-ready-hint;
                            color: UiTheme.text-muted;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                        InfoRow { label: "Boot Mode:"; value: root.sys-boot-mode; value-color: UiTheme.text-ok; }
                        InfoRow { label: root.tr.oobe-hostname; value: root.oobe-hostname; }
                    }
                }
            }

            HorizontalLayout {
                spacing: 10px;
                if root.oobe-step > 0 : Button {
                    text: root.tr.btn-back;
                    clicked => { root.oobe-step -= 1; }
                }
                Button {
                    text: root.tr.btn-skip;
                    clicked => { root.skip-oobe(); }
                }
                Rectangle { horizontal-stretch: 1; }
                if root.oobe-step < 3 : Button {
                    text: root.tr.btn-next;
                    primary: true;
                    clicked => { root.oobe-step += 1; }
                }
                if root.oobe-step == 3 && root.sys-is-live : Button {
                    text: root.tr.btn-finish-install;
                    clicked => { root.complete-oobe(true); }
                }
                if root.oobe-step == 3 : Button {
                    text: root.tr.btn-finish;
                    primary: true;
                    clicked => { root.complete-oobe(false); }
                }
            }
        }

        // Tab 0: Installed Applications & Permissions Manager
        if root.show-tabs && root.active-tab == 0 : HorizontalLayout {
            spacing: 12px;
            vertical-stretch: 1;

            // Left sidebar: app list
            Card {
                width: 240px;
                VerticalLayout {
                    padding: 10px;
                    spacing: 8px;

                    HorizontalLayout {
                        spacing: 6px;
                        Text {
                            text: root.tr.hdr-registered-apps;
                            color: UiTheme.text-secondary;
                            font-size: 13px;
                            font-weight: 700;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                        Button {
                            text: root.tr.btn-add;
                            clicked => { root.active-tab = 1; }
                        }
                    }

                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 6px;
                            alignment: start;

                            if root.installed-apps.length == 0 : Text {
                                text: "No apps installed yet.\nClick '+ Add' or double-click a .exe / .apk in File Manager.";
                                color: UiTheme.text-muted;
                                font-size: 12px;
                                wrap: word-wrap;
                            }

                            for app[idx] in root.installed-apps : Rectangle {
                                height: 50px;
                                border-radius: 6px;
                                background: idx == root.selected-app-idx ? #0369a1 : (item-ta.has-hover ? UiTheme.surface-hover : UiTheme.surface-subtle);
                                border-width: 1px;
                                border-color: idx == root.selected-app-idx ? #38bdf8 : UiTheme.card-border;

                                item-ta := TouchArea {
                                    clicked => { root.select-app(idx); }
                                }

                                VerticalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    alignment: center;
                                    spacing: 2px;
                                    Text {
                                        text: app.name;
                                        color: idx == root.selected-app-idx ? #ffffff : UiTheme.text-primary;
                                        font-size: 13px;
                                        font-weight: 600;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: app.platform-label;
                                        color: idx == root.selected-app-idx ? #e0f2fe : UiTheme.text-muted;
                                        font-size: 11px;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Right details pane
            Card {
                horizontal-stretch: 1;
                ScrollView {
                    VerticalLayout {
                        padding: 14px;
                        spacing: 12px;
                        alignment: start;

                        Text {
                            text: root.sel-name;
                            color: UiTheme.text-primary;
                            font-size: 17px;
                            font-weight: 700;
                        }

                        InfoRow { label: "Platform:"; value: root.sel-platform; value-color: UiTheme.text-accent; }
                        InfoRow { label: "Architecture:"; value: root.sel-arch; }
                        InfoRow { label: "App ID:"; value: root.sel-app-id; }
                        InfoRow { label: "Binary Path:"; value: root.sel-source-path; }
                        InfoRow { label: "Sandbox Dir:"; value: root.sel-sandbox-dir; }

                        if root.has-selected-app && root.sel-supports-era : WinEraRow {
                            label-width: 130px;
                            label-font-size: 12px;
                            current-index <=> root.sel-win-era-idx;
                            era-selected(idx) => { root.selected-era-changed(idx); }
                        }

                        Rectangle { height: 1px; background: UiTheme.card-border; }

                        PermissionGrid {
                            perm-network <=> root.sel-perm-network;
                            perm-gpu <=> root.sel-perm-gpu;
                            perm-documents <=> root.sel-perm-documents;
                            perm-camera <=> root.sel-perm-camera;
                            perm-microphone <=> root.sel-perm-microphone;
                            controls-enabled: root.has-selected-app;
                            permission-toggled(name, val) => { root.selected-permission-toggled(name, val); }
                        }

                        HorizontalLayout {
                            spacing: 10px;
                            Button {
                                text: root.tr.btn-launch-app;
                                primary: true;
                                enabled: root.has-selected-app;
                                clicked => { root.launch-selected(); }
                            }
                            Button {
                                text: root.tr.btn-create-shortcut;
                                enabled: root.has-selected-app;
                                clicked => { root.create-shortcut-selected(); }
                            }
                            Button {
                                text: root.sel-log-visible ? root.tr.btn-hide-log : root.tr.btn-view-log;
                                enabled: root.has-selected-app;
                                clicked => { root.view-log-selected(); }
                            }
                            Button {
                                text: root.tr.btn-uninstall;
                                enabled: root.has-selected-app;
                                clicked => { root.uninstall-selected(); }
                            }
                            Button {
                                text: root.tr.btn-refresh;
                                clicked => { root.refresh-all(); }
                            }
                        }

                        if root.has-selected-app : HorizontalLayout {
                            spacing: 10px;
                            if root.sel-supports-era : Button {
                                text: root.sel-fix-busy ? "Installing Runtimes..." : root.tr.btn-classic-runtimes;
                                enabled: !root.sel-fix-busy;
                                clicked => { root.install-runtimes-selected(); }
                            }
                            if root.sel-supports-era : Button {
                                text: "Diagnose Crashes / DLLs";
                                enabled: !root.sel-fix-busy;
                                clicked => { root.diagnose-selected-app(); }
                            }
                            Button {
                                text: root.sel-show-adv ? "v Hide App Launch / Save Controls" : "> Advanced App Launch & Save Controls";
                                clicked => { root.sel-show-adv = !root.sel-show-adv; }
                            }
                        }

                        if root.sel-fix-busy : ProgressIndicator {
                            indeterminate: true;
                            height: 8px;
                        }

                        if root.has-selected-app && root.sel-diag-summary != "" : Card {
                            VerticalLayout {
                                padding: 10px;
                                spacing: 6px;
                                Text {
                                    text: root.sel-diag-summary;
                                    color: UiTheme.text-accent;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }
                                if root.sel-diag-verbs != "" : HorizontalLayout {
                                    spacing: 8px;
                                    Button {
                                        text: root.sel-fix-busy ? "Repairing..." : ("1-Click Auto-Fix (" + root.sel-diag-verbs + ")");
                                        primary: true;
                                        enabled: !root.sel-fix-busy;
                                        clicked => { root.autofix-selected-app(); }
                                    }
                                }
                            }
                        }

                        if root.has-selected-app && root.sel-show-adv : Card {
                            VerticalLayout {
                                padding: 10px;
                                spacing: 8px;
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text { text: "Launch Args:"; color: UiTheme.text-muted; font-size: 12px; width: 105px; vertical-alignment: center; }
                                    LineEdit { text <=> root.sel-launch-args; placeholder-text: "e.g. -windowed -skipintro"; horizontal-stretch: 1; }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text { text: "Env (KEY=VAL):"; color: UiTheme.text-muted; font-size: 12px; width: 105px; vertical-alignment: center; }
                                    LineEdit { text <=> root.sel-env-vars; placeholder-text: "e.g. DXVK_HUD=fps, PROTON_NO_ESYNC=1"; horizontal-stretch: 1; }
                                    Button {
                                        text: "Save Config";
                                        primary: true;
                                        clicked => { root.save-app-launch-config(root.sel-launch-args, root.sel-env-vars); }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text { text: "Save Archive:"; color: UiTheme.text-muted; font-size: 12px; width: 105px; vertical-alignment: center; }
                                    LineEdit { text <=> root.sel-save-archive; horizontal-stretch: 1; }
                                    Button { text: "Backup Saves"; clicked => { root.backup-app-save(root.sel-save-archive); } }
                                    Button { text: "Restore Saves"; clicked => { root.restore-app-save(root.sel-save-archive); } }
                                    if root.sel-supports-era : Button { text: "Reset Wine Prefix"; clicked => { root.reset-app-prefix(); } }
                                }
                            }
                        }

                        if root.sel-log-visible : Rectangle {
                            height: 120px;
                            background: #020617;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: UiTheme.card-border;
                            ScrollView {
                                Text {
                                    text: root.sel-log-text;
                                    color: UiTheme.text-muted;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                    x: 8px;
                                    y: 6px;
                                    width: parent.width - 16px;
                                }
                            }
                        }
                    }
                }
            }
        }

        // Tab 1: Browse & Install File (.exe / .msi / .apk)
        if root.show-tabs && root.active-tab == 1 : HorizontalLayout {
            spacing: 12px;
            vertical-stretch: 1;

            Card {
                width: 270px;
                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;

                    Text {
                        text: "Detected Binaries (.exe / .com / .bat / .apk)";
                        color: UiTheme.text-secondary;
                        font-size: 13px;
                        font-weight: 700;
                    }

                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 6px;
                            alignment: start;

                            if root.browse-files.length == 0 : Text {
                                text: "No .exe, .com, .bat, or .apk files found in Home / Downloads / /usr/share/unicore.";
                                color: UiTheme.text-muted;
                                font-size: 12px;
                                wrap: word-wrap;
                            }

                            for file in root.browse-files : Rectangle {
                                height: 48px;
                                border-radius: 6px;
                                background: file-ta.has-hover ? UiTheme.surface-hover : UiTheme.surface-subtle;
                                border-width: 1px;
                                border-color: UiTheme.card-border;

                                file-ta := TouchArea {
                                    clicked => {
                                        root.install-path-input = file.path;
                                        root.inspect-path(file.path);
                                    }
                                }

                                VerticalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    alignment: center;
                                    spacing: 2px;
                                    Text {
                                        text: file.name;
                                        color: UiTheme.text-primary;
                                        font-size: 12px;
                                        font-weight: 600;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: file.kind + " - " + file.path;
                                        color: UiTheme.text-muted;
                                        font-size: 10px;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            Card {
                horizontal-stretch: 1;
                ScrollView {
                    VerticalLayout {
                        padding: 14px;
                        spacing: 10px;
                        alignment: start;

                        Text {
                            text: "Inspect & Install Application";
                            color: UiTheme.text-primary;
                            font-size: 15px;
                            font-weight: 700;
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            LineEdit {
                                text <=> root.install-path-input;
                                placeholder-text: "/path/to/app.exe, game.com, run.bat, or app.apk";
                                horizontal-stretch: 1;
                            }
                            Button {
                                text: root.tr.btn-browse;
                                clicked => { root.open-file-picker("install"); }
                            }
                            Button {
                                text: "Inspect";
                                clicked => { root.inspect-path(root.install-path-input); }
                            }
                        }

                        if !root.open-has-file : Text {
                            text: "Select a file on the left or enter a file path above to configure Windows Era and Sandbox Permissions.";
                            color: UiTheme.text-muted;
                            font-size: 12px;
                            wrap: word-wrap;
                        }

                        if root.open-has-file : VerticalLayout {
                            spacing: 10px;
                            HorizontalLayout {
                                spacing: 10px;
                                Text {
                                    text: "App Name:";
                                    color: UiTheme.text-muted;
                                    font-size: 12px;
                                    width: 110px;
                                    vertical-alignment: center;
                                }
                                LineEdit {
                                    text <=> root.open-name;
                                    horizontal-stretch: 1;
                                }
                            }
                            InfoRow { label: "Platform:"; value: root.open-platform; value-color: UiTheme.text-accent; }
                            InfoRow { label: "CPU / ABIs:"; value: root.open-arch + "  (" + root.open-sub-abis + ")"; }

                            if root.open-supports-era : WinEraRow {
                                label-font-size: 12px;
                                current-index <=> root.open-win-era-idx;
                            }

                            PermissionGrid {
                                perm-network <=> root.open-perm-network;
                                perm-gpu <=> root.open-perm-gpu;
                                perm-documents <=> root.open-perm-documents;
                                perm-camera <=> root.open-perm-camera;
                                perm-microphone <=> root.open-perm-microphone;
                                controls-enabled: true;
                            }

                            CheckBox {
                                text: "Create Start Menu & Desktop shortcut (.desktop)";
                                checked <=> root.open-create-shortcut;
                            }

                            HorizontalLayout {
                                spacing: 10px;
                                Button {
                                    text: "Install & Launch";
                                    primary: true;
                                    clicked => { root.install-and-launch-open(); }
                                }
                                Button {
                                    text: "Install Only";
                                    clicked => { root.install-only-open(); }
                                }
                            }
                        }
                    }
                }
            }
        }

        // Tab 2: Hardware Profile & Built-in Android Subsystem
        if root.show-tabs && root.active-tab == 2 : ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 12px;
                alignment: start;

                Card {
                    VerticalLayout {
                        padding: 14px;
                        spacing: 6px;
                        Text {
                            text: "Adaptive Hardware Profile (2005 - Present)";
                            color: UiTheme.text-primary;
                            font-size: 15px;
                            font-weight: 700;
                        }
                        InfoRow { label: "Hardware Tier:"; value: root.sys-hw-tier; value-color: UiTheme.text-accent; }
                        InfoRow { label: "Processor:"; value: root.sys-hw-cpu; }
                        InfoRow { label: "Memory / zram:"; value: root.sys-hw-ram; }
                        InfoRow { label: "CPU / GPU Caps:"; value: root.sys-hw-caps; }
                        InfoRow { label: "Active Backends:"; value: root.sys-hw-renderers; }
                        InfoRow { label: "Boot Mode:"; value: root.sys-boot-mode; value-color: root.sys-is-live ? #fbbf24 : #22c55e; }
                        HorizontalLayout {
                            spacing: 10px;
                            Button {
                                text: "Export Diagnostics";
                                clicked => { root.export-diagnostics(); }
                            }
                        }
                    }
                }

                if root.sys-is-live : Card {
                    VerticalLayout {
                        padding: 14px;
                        spacing: 8px;
                        Text {
                            text: "Install UniCore OS to Disk (A/B Hybrid BIOS + UEFI / Safe Windows Dual-Boot)";
                            color: UiTheme.text-primary;
                            font-size: 15px;
                            font-weight: 700;
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            Text { text: "Install Mode:"; color: UiTheme.text-muted; font-size: 12px; width: 92px; vertical-alignment: center; }
                            ComboBox {
                                model: ["Erase Whole Disk (Hybrid BIOS + UEFI A/B)", "Safe Dual-Boot Alongside Windows (Uses >= 10 GB Unallocated GPT Space)"];
                                current-index <=> root.inst-mode-idx;
                                enabled: root.inst-has-disk && !root.inst-busy;
                                horizontal-stretch: 1;
                            }
                        }
                        Text {
                            text: root.inst-mode-idx == 1
                                ? "SAFE DUAL-BOOT: Installs A/B slots into unallocated GPT free space (>= 10 GB) without touching or resizing any Windows NTFS partition, reuses Windows ESP, and auto-adds Windows Boot Manager + UniCore Recovery to GRUB. Need free space? Shrink C: inside Windows Disk Management first."
                                : "WHOLE-DISK MODE: Creates GPT Hybrid BIOS + UEFI layout with Slot A (UNICORE_SYS_A), Slot B fallback (UNICORE_SYS_B), UniCore Recovery submenu, and persistent UNICORE_DATA. ALL existing data on the selected disk will be erased.";
                            color: root.inst-mode-idx == 1 ? #38bdf8 : #fbbf24;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                        if root.inst-dualboot-hint != "" : Text {
                            text: root.inst-dualboot-hint;
                            color: UiTheme.text-ok;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            ComboBox {
                                model: root.inst-disk-labels;
                                current-index <=> root.inst-disk-idx;
                                enabled: root.inst-has-disk && !root.inst-busy;
                                horizontal-stretch: 1;
                            }
                            Button {
                                text: "Refresh Disks";
                                enabled: !root.inst-busy;
                                clicked => { root.refresh-install-disks(); }
                            }
                        }
                        CheckBox {
                            text: "Encrypt persistent /data partition with LUKS2 (recommended for laptops)";
                            checked <=> root.inst-encrypt-data;
                            enabled: root.inst-has-disk && !root.inst-busy;
                        }
                        if root.inst-encrypt-data : HorizontalLayout {
                            spacing: 10px;
                            LineEdit {
                                text <=> root.inst-luks-pass;
                                placeholder-text: "LUKS2 passphrase (min 8 chars)";
                                input-type: InputType.password;
                                enabled: !root.inst-busy;
                                horizontal-stretch: 1;
                            }
                            LineEdit {
                                text <=> root.inst-luks-confirm;
                                placeholder-text: "Confirm LUKS2 passphrase";
                                input-type: InputType.password;
                                enabled: !root.inst-busy;
                                horizontal-stretch: 1;
                            }
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            LineEdit {
                                text <=> root.inst-confirm-input;
                                placeholder-text: "Type device name to confirm (e.g. sda or nvme0n1)";
                                enabled: root.inst-has-disk && !root.inst-busy;
                                horizontal-stretch: 1;
                            }
                            Button {
                                text: root.inst-busy ? "Installing..." : (root.inst-mode-idx == 1 ? "Install Alongside Windows" : "Erase & Install UniCore OS");
                                primary: true;
                                enabled: root.inst-has-disk && !root.inst-busy;
                                clicked => { root.start-disk-install(root.inst-disk-idx, root.inst-mode-idx, root.inst-confirm-input, root.inst-encrypt-data, root.inst-luks-pass, root.inst-luks-confirm); }
                            }
                        }
                        if root.inst-status != "" : Text {
                            text: root.inst-status;
                            color: UiTheme.text-accent;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                }

                Card {
                    VerticalLayout {
                        padding: 14px;
                        spacing: 8px;
                        Text {
                            text: "System Updates & A/B Rollback";
                            color: UiTheme.text-primary;
                            font-size: 15px;
                            font-weight: 700;
                        }
                        InfoRow { label: "OS Version:"; value: root.upd-current-version; value-color: UiTheme.text-accent; }
                        InfoRow { label: "Active Slot:"; value: root.upd-active-slot; }
                        InfoRow { label: "Standby Slot:"; value: root.upd-standby-slot; }
                        InfoRow { label: "Boot Health:"; value: root.upd-pending-summary; value-color: UiTheme.text-ok; }

                        if !root.upd-can-update : Text {
                            text: "Note: A/B OTA updates and slot rollback are active once installed to disk (current mode: " + root.sys-boot-mode + ").";
                            color: #fbbf24;
                            font-size: 12px;
                            wrap: word-wrap;
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            LineEdit {
                                text <=> root.upd-url-input;
                                placeholder-text: "HTTPS manifest URL (https://.../unicore-manifest.json)";
                                enabled: !root.upd-busy;
                                horizontal-stretch: 1;
                            }
                            Button {
                                text: "Check Updates";
                                enabled: !root.upd-busy;
                                clicked => { root.check-ota-update(root.upd-url-input); }
                            }
                            Button {
                                text: root.upd-busy ? "Updating..." : "Apply OTA Update";
                                primary: true;
                                enabled: root.upd-can-update && !root.upd-busy;
                                clicked => { root.apply-ota-update(root.upd-url-input); }
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            LineEdit {
                                text <=> root.upd-local-path;
                                placeholder-text: "Local ISO or manifest path (/data/home/Downloads/unicore-os-x86_64.iso)";
                                enabled: !root.upd-busy;
                                horizontal-stretch: 1;
                            }
                            Button {
                                text: "Apply Local Update";
                                enabled: root.upd-can-update && !root.upd-busy;
                                clicked => { root.apply-local-update(root.upd-local-path, root.upd-allow-unsigned); }
                            }
                        }

                        CheckBox {
                            text: "Allow unsigned local ISO / dev build (SHA-256 verified when manifest present)";
                            checked <=> root.upd-allow-unsigned;
                            enabled: !root.upd-busy;
                        }

                        Switch {
                            text: "Auto-check for signed updates in background (Waybar badge & toast)";
                            checked <=> root.upd-auto-check;
                            enabled: !root.upd-busy;
                            toggled => { root.toggle-auto-check-updates(self.checked); }
                        }

                        if root.upd-busy : ProgressIndicator {
                            indeterminate: true;
                            height: 8px;
                        }

                        HorizontalLayout {
                            spacing: 10px;
                            Button {
                                text: "Rollback to Standby Slot";
                                enabled: root.upd-can-rollback && !root.upd-busy;
                                clicked => { root.rollback-os-slot(); }
                            }
                            Button {
                                text: "Refresh Status";
                                enabled: !root.upd-busy;
                                clicked => { root.refresh-update-status(); }
                            }
                            if root.upd-needs-reboot : Button {
                                text: "Reboot Now";
                                primary: true;
                                enabled: !root.upd-busy;
                                clicked => { root.power-action("reboot"); }
                            }
                        }

                        if root.upd-status != "" : Text {
                            text: root.upd-status;
                            color: UiTheme.text-accent;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                }

                Card {
                    VerticalLayout {
                        padding: 14px;
                        spacing: 8px;
                        Text {
                            text: "Built-in Android Subsystem (ART / Waydroid)";
                            color: UiTheme.text-primary;
                            font-size: 15px;
                            font-weight: 700;
                        }
                        InfoRow { label: "Kernel BinderFS:"; value: root.sys-android-binder; }
                        InfoRow { label: "Container Engine:"; value: root.sys-android-engine; }
                        InfoRow { label: "Android Image:"; value: root.sys-android-image; }
                        InfoRow { label: "ARM Translator:"; value: root.sys-android-arm; }
                        InfoRow { label: "Runtime State:"; value: root.sys-android-container; value-color: UiTheme.text-ok; }

                        HorizontalLayout {
                            spacing: 10px;
                            Text {
                                text: "Image Profile:";
                                color: UiTheme.text-muted;
                                font-size: 12px;
                                width: 130px;
                                vertical-alignment: center;
                            }
                            ComboBox {
                                model: ["VANILLA (Minimal Open-Source)", "MICROG (Open-Source Play Services)", "GAPPS"];
                                current-index <=> root.android-profile-idx;
                                horizontal-stretch: 1;
                            }
                        }

                        HorizontalLayout {
                            spacing: 10px;
                            Button {
                                text: root.android-busy ? "Working..." : "Initialize Android";
                                primary: true;
                                enabled: !root.android-busy;
                                clicked => { root.android-action("init"); }
                            }
                            Button {
                                text: "Open Android UI";
                                enabled: !root.android-busy;
                                clicked => { root.android-action("ui"); }
                            }
                            Button {
                                text: "Install ARM Translator";
                                enabled: !root.android-busy;
                                clicked => { root.android-action("setup-arm"); }
                            }
                            Button {
                                text: "Sync App Shortcuts";
                                enabled: !root.android-busy;
                                clicked => { root.android-action("sync-shortcuts"); }
                            }
                            Button {
                                text: "Sync Clipboard";
                                enabled: !root.android-busy;
                                clicked => { root.android-action("clipboard-sync"); }
                            }
                            Button {
                                text: "Reclaim Idle RAM";
                                clicked => { root.reclaim-ram(); }
                            }
                            Button {
                                text: "Refresh";
                                clicked => { root.refresh-all(); }
                            }
                        }
                        if root.android-busy : ProgressIndicator {
                            indeterminate: true;
                            height: 8px;
                        }
                        if root.android-status != "" : Text {
                            text: root.android-status;
                            color: UiTheme.text-accent;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                }

                Card {
                    VerticalLayout {
                        padding: 14px;
                        spacing: 8px;
                        Text {
                            text: root.tr.hdr-gaming-perf;
                            color: UiTheme.text-primary;
                            font-size: 15px;
                            font-weight: 700;
                        }
                        InfoRow { label: root.tr.lbl-cpu-governor; value: root.sys-cpu-governor; value-color: UiTheme.text-accent; }
                        Switch {
                            text: root.tr.chk-game-mode;
                            checked <=> root.gaming-mode-enabled;
                            toggled => { root.toggle-game-mode(self.checked); }
                        }
                        Switch {
                            text: root.tr.chk-show-fps;
                            checked <=> root.gaming-fps-enabled;
                            toggled => { root.toggle-show-fps(self.checked); }
                        }
                        Text {
                            text: root.tr.gaming-hint;
                            color: #22c55e;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                }

                Card {
                    VerticalLayout {
                        padding: 14px;
                        spacing: 8px;
                        Text {
                            text: "Win32 / Win16 / MS-DOS Subsystems & Runtime Assets";
                            color: UiTheme.text-primary;
                            font-size: 15px;
                            font-weight: 700;
                        }
                        InfoRow { label: "Wine Core:"; value: root.sys-win32-wine; }
                        InfoRow { label: "DXVK (D3D8-11):"; value: root.sys-win32-dxvk; }
                        InfoRow { label: "VKD3D (Direct3D 12):"; value: root.sys-win32-vkd3d; }
                        InfoRow { label: "cnc-ddraw (Win98/XP):"; value: root.sys-win32-cnc-ddraw; }
                        InfoRow { label: "OTVDM (Win16 NE):"; value: root.sys-win32-otvdm; }
                        InfoRow { label: "Winetricks (DX9/VC++):"; value: root.sys-win32-winetricks; }
                        InfoRow { label: "MS-DOS Subsystem:"; value: root.sys-dos-subsystem; }
                        HorizontalLayout {
                            spacing: 10px;
                            Button {
                                text: "Install DXVK";
                                clicked => { root.win32-asset-action("install-dxvk"); }
                            }
                            Button {
                                text: "Install VKD3D";
                                clicked => { root.win32-asset-action("install-vkd3d"); }
                            }
                            Button {
                                text: "Install cnc-ddraw";
                                clicked => { root.win32-asset-action("install-cnc-ddraw"); }
                            }
                            Button {
                                text: "Install OTVDM (Win16)";
                                clicked => { root.win32-asset-action("install-otvdm"); }
                            }
                        }
                    }
                }
            }
        }

        // Tab 3: Daily Settings (Wi-Fi, Bluetooth, Audio, Display & Brightness, Printers, Security, Power & Users)
        if root.show-tabs && root.active-tab == 3 : VerticalLayout {
            spacing: 10px;
            vertical-stretch: 1;

            HorizontalLayout {
                spacing: 8px;
                TabPill {
                    label: root.tr.subtab-wifi;
                    active: root.settings-subtab == 0;
                    clicked => { root.settings-subtab = 0; root.refresh-settings(); }
                }
                TabPill {
                    label: root.tr.subtab-bt;
                    active: root.settings-subtab == 1;
                    clicked => { root.settings-subtab = 1; root.refresh-settings(); }
                }
                TabPill {
                    label: root.tr.subtab-audio;
                    active: root.settings-subtab == 2;
                    clicked => { root.settings-subtab = 2; root.refresh-settings(); }
                }
                TabPill {
                    label: root.tr.subtab-display;
                    active: root.settings-subtab == 3;
                    clicked => { root.settings-subtab = 3; root.refresh-settings(); }
                }
                TabPill {
                    label: root.tr.subtab-printers;
                    active: root.settings-subtab == 4;
                    clicked => { root.settings-subtab = 4; root.refresh-settings(); }
                }
                TabPill {
                    label: root.tr.subtab-security;
                    active: root.settings-subtab == 5;
                    clicked => { root.settings-subtab = 5; root.refresh-settings(); }
                }
                TabPill {
                    label: root.tr.subtab-power-users;
                    active: root.settings-subtab == 6;
                    clicked => { root.settings-subtab = 6; root.refresh-settings(); }
                }
                Rectangle { horizontal-stretch: 1; }
                Button {
                    text: root.tr.btn-refresh;
                    clicked => { root.refresh-settings(); }
                }
            }

            // Subtab 0: Wi-Fi, Network & Network Drives (SMB / SFTP / WebDAV)
            if root.settings-subtab == 0 : ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    spacing: 10px;
                    alignment: start;

                    Card {
                        VerticalLayout {
                            padding: 14px;
                            spacing: 10px;

                            InfoRow { label: "Network Status:"; value: root.set-net-summary; value-color: UiTheme.text-accent; }

                            HorizontalLayout {
                                spacing: 12px;
                                Switch {
                                    text: "Wi-Fi Radio";
                                    checked <=> root.set-wifi-enabled;
                                    enabled: root.set-net-available;
                                    toggled => { root.toggle-wifi-radio(self.checked); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                                Button {
                                    text: "Scan Wi-Fi";
                                    enabled: root.set-net-available;
                                    clicked => { root.refresh-settings(); }
                                }
                            }

                            VerticalLayout {
                                spacing: 6px;
                                alignment: start;

                                if root.set-wifi-list.length == 0 : Text {
                                    text: root.set-wifi-enabled ? "No Wi-Fi networks detected yet (wired Ethernet DHCP connects automatically)." : "Wi-Fi radio is off or no Wi-Fi adapter found.";
                                    color: UiTheme.text-muted;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }

                                for net[idx] in root.set-wifi-list : Rectangle {
                                    height: 40px;
                                    border-radius: 6px;
                                    background: idx == root.set-selected-wifi-idx ? #0369a1 : (wta.has-hover ? UiTheme.surface-hover : UiTheme.surface-subtle);
                                    border-width: 1px;
                                    border-color: net.in-use ? #22c55e : (idx == root.set-selected-wifi-idx ? #38bdf8 : UiTheme.card-border);

                                    wta := TouchArea {
                                        clicked => { root.select-wifi(idx); }
                                    }

                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        spacing: 10px;
                                        Text {
                                            text: net.in-use ? "* " + net.ssid : net.ssid;
                                            color: idx == root.set-selected-wifi-idx ? #ffffff : UiTheme.text-primary;
                                            font-size: 13px;
                                            font-weight: net.in-use ? 700 : 500;
                                            horizontal-stretch: 1;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: net.security + " | " + net.signal + "%";
                                            color: UiTheme.text-muted;
                                            font-size: 11px;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                LineEdit {
                                    text <=> root.set-wifi-ssid;
                                    placeholder-text: "Wi-Fi SSID";
                                    horizontal-stretch: 1;
                                }
                                LineEdit {
                                    text <=> root.set-wifi-password;
                                    placeholder-text: "Password (blank if open)";
                                    input-type: InputType.password;
                                    horizontal-stretch: 1;
                                }
                            }

                            HorizontalLayout {
                                spacing: 10px;
                                Button {
                                    text: "Connect";
                                    primary: true;
                                    enabled: root.set-net-available;
                                    clicked => { root.connect-wifi(root.set-wifi-ssid, root.set-wifi-password); }
                                }
                                Button {
                                    text: "Disconnect";
                                    enabled: root.set-net-available;
                                    clicked => { root.disconnect-wifi(); }
                                }
                                Button {
                                    text: "Forget Saved";
                                    enabled: root.set-net-available;
                                    clicked => { root.forget-wifi(root.set-wifi-ssid); }
                                }
                            }
                        }
                    }

                    // Network Drives & File Shares (Windows SMB, SFTP, WebDAV, Phone MTP/AFC)
                    Card {
                        VerticalLayout {
                            padding: 14px;
                            spacing: 8px;

                            Text {
                                text: root.tr.hdr-net-shares;
                                color: UiTheme.text-primary;
                                font-size: 15px;
                                font-weight: 700;
                            }
                            Text {
                                text: "Connect Windows/NAS SMB shares (smb://192.168.1.10/Share), SFTP servers (sftp://host/path), or WebDAV/Nextcloud (davs://...). Android MTP & iPhone AFC auto-mount in Files.";
                                color: UiTheme.text-muted;
                                font-size: 11px;
                                wrap: word-wrap;
                            }

                            if root.set-share-list.length == 0 : Text {
                                text: "No saved network drives yet.";
                                color: UiTheme.text-muted;
                                font-size: 12px;
                            }

                            for sh[idx] in root.set-share-list : Rectangle {
                                height: 38px;
                                border-radius: 6px;
                                background: idx == root.set-selected-share-idx ? #0369a1 : (sta.has-hover ? UiTheme.surface-hover : UiTheme.surface-subtle);
                                border-width: 1px;
                                border-color: sh.mounted ? #22c55e : (idx == root.set-selected-share-idx ? #38bdf8 : UiTheme.card-border);

                                sta := TouchArea { clicked => { root.select-share(idx); } }

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 10px;
                                    Text {
                                        text: (sh.mounted ? "[Mounted] " : "") + sh.label + "  (" + sh.uri + ")";
                                        color: idx == root.set-selected-share-idx ? #ffffff : UiTheme.text-primary;
                                        font-size: 12px;
                                        font-weight: sh.mounted ? 700 : 500;
                                        horizontal-stretch: 1;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                Button {
                                    text: root.tr.btn-mount;
                                    primary: true;
                                    enabled: root.set-selected-share-id != "";
                                    clicked => { root.share-action("mount", root.set-selected-share-id); }
                                }
                                Button {
                                    text: root.tr.btn-open-folder;
                                    enabled: root.set-selected-share-id != "";
                                    clicked => { root.share-action("open", root.set-selected-share-id); }
                                }
                                Button {
                                    text: root.tr.btn-unmount;
                                    enabled: root.set-selected-share-id != "";
                                    clicked => { root.share-action("unmount", root.set-selected-share-id); }
                                }
                                Button {
                                    text: root.tr.btn-remove-printer;
                                    enabled: root.set-selected-share-id != "";
                                    clicked => { root.share-action("remove", root.set-selected-share-id); }
                                }
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                LineEdit {
                                    text <=> root.set-share-label-input;
                                    placeholder-text: "Drive Name (e.g. Home NAS)";
                                    width: 170px;
                                }
                                LineEdit {
                                    text <=> root.set-share-uri-input;
                                    placeholder-text: "smb://192.168.1.10/Share or sftp://host/home";
                                    horizontal-stretch: 1;
                                }
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                LineEdit {
                                    text <=> root.set-share-user-input;
                                    placeholder-text: "Username (optional)";
                                    horizontal-stretch: 1;
                                }
                                LineEdit {
                                    text <=> root.set-share-pass-input;
                                    placeholder-text: "Password (stored chmod 600, optional)";
                                    input-type: InputType.password;
                                    horizontal-stretch: 1;
                                }
                                Button {
                                    text: root.tr.btn-add-share;
                                    primary: true;
                                    clicked => {
                                        root.add-network-share(
                                            root.set-share-label-input,
                                            root.set-share-uri-input,
                                            root.set-share-user-input,
                                            root.set-share-pass-input
                                        );
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Subtab 1: Bluetooth (On-Demand BlueZ)
            if root.settings-subtab == 1 : Card {
                vertical-stretch: 1;
                VerticalLayout {
                    padding: 14px;
                    spacing: 10px;

                    InfoRow { label: "Bluetooth Status:"; value: root.set-bt-summary; value-color: UiTheme.text-accent; }

                    HorizontalLayout {
                        spacing: 12px;
                        Switch {
                            text: "Enable Bluetooth (On-Demand)";
                            checked <=> root.set-bt-powered;
                            toggled => { root.toggle-bluetooth(self.checked); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Button {
                            text: "Scan Devices (5s)";
                            enabled: root.set-bt-powered;
                            clicked => { root.scan-bluetooth(); }
                        }
                    }

                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 6px;
                            alignment: start;

                            if root.set-bt-list.length == 0 : Text {
                                text: "No Bluetooth devices listed. Enable Bluetooth and click Scan Devices.";
                                color: UiTheme.text-muted;
                                font-size: 12px;
                            }

                            for dev[idx] in root.set-bt-list : Rectangle {
                                height: 42px;
                                border-radius: 6px;
                                background: idx == root.set-selected-bt-idx ? #0369a1 : (bta.has-hover ? UiTheme.surface-hover : UiTheme.surface-subtle);
                                border-width: 1px;
                                border-color: dev.connected ? #22c55e : (idx == root.set-selected-bt-idx ? #38bdf8 : #334155);

                                bta := TouchArea {
                                    clicked => { root.select-bt-device(idx); }
                                }

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 10px;
                                    Text {
                                        text: dev.name + " (" + dev.mac + ")";
                                        color: idx == root.set-selected-bt-idx ? #ffffff : UiTheme.text-primary;
                                        font-size: 12px;
                                        horizontal-stretch: 1;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: dev.connected ? "Connected" : (dev.paired ? "Paired" : "Available");
                                        color: dev.connected ? #4ade80 : UiTheme.text-muted;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        Button {
                            text: "Pair & Connect";
                            primary: true;
                            enabled: root.set-selected-bt-mac != "";
                            clicked => { root.bt-action("pair-connect", root.set-selected-bt-mac); }
                        }
                        Button {
                            text: "Disconnect";
                            enabled: root.set-selected-bt-mac != "";
                            clicked => { root.bt-action("disconnect", root.set-selected-bt-mac); }
                        }
                        Button {
                            text: "Remove";
                            enabled: root.set-selected-bt-mac != "";
                            clicked => { root.bt-action("remove", root.set-selected-bt-mac); }
                        }
                    }
                }
            }

            // Subtab 2: Audio (PipeWire)
            if root.settings-subtab == 2 : Card {
                vertical-stretch: 1;
                VerticalLayout {
                    padding: 16px;
                    spacing: 14px;
                    alignment: start;

                    Text {
                        text: "PipeWire Sound & Microphone";
                        color: UiTheme.text-primary;
                        font-size: 15px;
                        font-weight: 700;
                    }

                    HorizontalLayout {
                        spacing: 12px;
                        Text {
                            text: "Output Volume (" + Math.round(root.set-audio-volume) + "%):";
                            color: UiTheme.text-secondary;
                            font-size: 13px;
                            width: 170px;
                            vertical-alignment: center;
                        }
                        Slider {
                            minimum: 0;
                            maximum: 100;
                            step: 2;
                            value <=> root.set-audio-volume;
                            enabled: root.set-audio-available;
                            released(val) => { root.audio-volume-changed(Math.round(val)); }
                            horizontal-stretch: 1;
                        }
                    }

                    HorizontalLayout {
                        spacing: 12px;
                        Text {
                            text: "Output Device:";
                            color: UiTheme.text-muted;
                            font-size: 13px;
                            width: 170px;
                            vertical-alignment: center;
                        }
                        ComboBox {
                            model: root.set-audio-sinks;
                            current-index <=> root.set-audio-sink-idx;
                            enabled: root.set-audio-available;
                            selected => { root.audio-sink-selected(self.current-index); }
                            horizontal-stretch: 1;
                        }
                    }

                    HorizontalLayout {
                        spacing: 24px;
                        Switch {
                            text: "Mute Output";
                            checked <=> root.set-audio-muted;
                            enabled: root.set-audio-available;
                            toggled => { root.audio-mute-toggled(self.checked); }
                        }
                        Switch {
                            text: "Mute Microphone";
                            checked <=> root.set-mic-muted;
                            enabled: root.set-audio-available;
                            toggled => { root.mic-mute-toggled(self.checked); }
                        }
                    }

                    Rectangle { height: 1px; background: UiTheme.card-border; }

                    HorizontalLayout {
                        spacing: 12px;
                        Text {
                            text: root.tr.lbl-audio-profile;
                            color: UiTheme.text-muted;
                            font-size: 13px;
                            width: 190px;
                            vertical-alignment: center;
                        }
                        ComboBox {
                            model: root.set-audio-profiles;
                            current-index <=> root.set-audio-profile-idx;
                            enabled: root.set-audio-available;
                            selected => { root.audio-profile-selected(self.current-index); }
                            horizontal-stretch: 1;
                        }
                    }
                    Text {
                        text: "PipeWire Bluetooth A2DP Stereo & HFP Headset profiles are enabled automatically when Bluetooth headphones connect.";
                        color: UiTheme.text-muted;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                }
            }

            // Subtab 3: Display, Brightness & Appearance/Input Personalization
            if root.settings-subtab == 3 : ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    spacing: 10px;
                    alignment: start;

                    Card {
                        VerticalLayout {
                            padding: 16px;
                            spacing: 10px;
                            alignment: start;

                            Text {
                                text: "Wayland Display & Screen Brightness";
                                color: UiTheme.text-primary;
                                font-size: 15px;
                                font-weight: 700;
                            }

                            HorizontalLayout {
                                spacing: 12px;
                                Text {
                                    text: "Display Output:";
                                    color: UiTheme.text-muted;
                                    font-size: 13px;
                                    width: 160px;
                                    vertical-alignment: center;
                                }
                                ComboBox {
                                    model: root.set-disp-outputs;
                                    current-index <=> root.set-disp-output-idx;
                                    selected => { root.display-output-selected(self.current-index); }
                                    horizontal-stretch: 1;
                                }
                            }

                            HorizontalLayout {
                                spacing: 12px;
                                Text {
                                    text: "Resolution & Refresh:";
                                    color: UiTheme.text-muted;
                                    font-size: 13px;
                                    width: 160px;
                                    vertical-alignment: center;
                                }
                                ComboBox {
                                    model: root.set-disp-modes;
                                    current-index <=> root.set-disp-mode-idx;
                                    horizontal-stretch: 1;
                                }
                            }

                            HorizontalLayout {
                                spacing: 12px;
                                Text {
                                    text: "UI Scale:";
                                    color: UiTheme.text-muted;
                                    font-size: 13px;
                                    width: 160px;
                                    vertical-alignment: center;
                                }
                                ComboBox {
                                    model: ["1.0", "1.25", "1.5", "2.0"];
                                    current-index <=> root.set-disp-scale-idx;
                                    horizontal-stretch: 1;
                                }
                            }

                            Button {
                                text: "Apply & Save Display Settings";
                                primary: true;
                                clicked => { root.apply-display(root.set-disp-output-idx, root.set-disp-mode-idx, root.set-disp-scale-idx); }
                            }

                            Rectangle { height: 1px; background: UiTheme.card-border; }

                            HorizontalLayout {
                                spacing: 12px;
                                Text {
                                    text: root.set-backlight-available ? "Backlight (" + Math.round(root.set-brightness-pct) + "%):" : "Backlight (N/A on VM):";
                                    color: UiTheme.text-secondary;
                                    font-size: 13px;
                                    width: 215px;
                                    vertical-alignment: center;
                                }
                                Slider {
                                    minimum: 5;
                                    maximum: 100;
                                    step: 5;
                                    value <=> root.set-brightness-pct;
                                    enabled: root.set-backlight-available;
                                    released(val) => { root.brightness-changed(Math.round(val)); }
                                    horizontal-stretch: 1;
                                }
                            }

                            Rectangle { height: 1px; background: UiTheme.card-border; }

                            HorizontalLayout {
                                spacing: 12px;
                                Switch {
                                    text: root.tr.chk-night-light;
                                    checked <=> root.set-nightlight-enabled;
                                    toggled => { root.nightlight-changed(self.checked, Math.round(root.set-nightlight-temp)); }
                                }
                            }

                            HorizontalLayout {
                                spacing: 12px;
                                Text {
                                    text: root.tr.lbl-night-temp + " (" + Math.round(root.set-nightlight-temp) + "K):";
                                    color: UiTheme.text-secondary;
                                    font-size: 13px;
                                    width: 215px;
                                    vertical-alignment: center;
                                }
                                Slider {
                                    minimum: 2700;
                                    maximum: 5500;
                                    step: 100;
                                    value <=> root.set-nightlight-temp;
                                    enabled: root.set-nightlight-enabled;
                                    released(val) => { root.nightlight-changed(root.set-nightlight-enabled, Math.round(val)); }
                                    horizontal-stretch: 1;
                                }
                            }
                        }
                    }

                    Card {
                        VerticalLayout {
                            padding: 16px;
                            spacing: 10px;
                            alignment: start;

                            Text {
                                text: root.tr.hdr-personalize;
                                color: UiTheme.text-primary;
                                font-size: 15px;
                                font-weight: 700;
                            }

                            HorizontalLayout {
                                spacing: 12px;
                                Text {
                                    text: root.tr.lbl-theme;
                                    color: UiTheme.text-muted;
                                    font-size: 13px;
                                    width: 160px;
                                    vertical-alignment: center;
                                }
                                ComboBox {
                                    model: ["Dark (UniCore Midnight)", "Light (UniCore Daylight)"];
                                    current-index <=> root.set-theme-idx;
                                    horizontal-stretch: 1;
                                }
                            }

                            HorizontalLayout {
                                spacing: 12px;
                                Text {
                                    text: root.tr.lbl-wallpaper;
                                    color: UiTheme.text-muted;
                                    font-size: 13px;
                                    width: 160px;
                                    vertical-alignment: center;
                                }
                                ComboBox {
                                    model: ["Midnight Blue (Default)", "Aurora Violet", "Daylight Slate", "Custom Image Path"];
                                    current-index <=> root.set-wallpaper-idx;
                                    horizontal-stretch: 1;
                                }
                            }

                            if root.set-wallpaper-idx == 3 : HorizontalLayout {
                                spacing: 8px;
                                Rectangle { width: 160px; }
                                LineEdit {
                                    text <=> root.set-wallpaper-custom;
                                    placeholder-text: "/data/home/Pictures/wallpaper.png";
                                    horizontal-stretch: 1;
                                }
                                Button {
                                    text: root.tr.btn-browse;
                                    clicked => { root.open-file-picker("wallpaper"); }
                                }
                            }

                            HorizontalLayout {
                                spacing: 12px;
                                Text {
                                    text: root.tr.lbl-kb-layout;
                                    color: UiTheme.text-muted;
                                    font-size: 13px;
                                    width: 160px;
                                    vertical-alignment: center;
                                }
                                ComboBox {
                                    model: ["US English (us)", "Malay / QWERTY (my)", "UK English (gb)", "German (de)", "French (fr)", "Japanese (jp)"];
                                    current-index <=> root.set-kb-layout-idx;
                                    horizontal-stretch: 1;
                                }
                            }

                            HorizontalLayout {
                                spacing: 12px;
                                Text {
                                    text: root.tr.lbl-desktop-layout;
                                    color: UiTheme.text-muted;
                                    font-size: 13px;
                                    width: 160px;
                                    vertical-alignment: center;
                                }
                                ComboBox {
                                    model: ["Windows 11 Modern (Centered Floating)", "Windows 10 / Zorin Classic (Left Bar)", "macOS / Zorin Top Dock"];
                                    current-index <=> root.set-desktop-layout-idx;
                                    horizontal-stretch: 1;
                                }
                            }

                            HorizontalLayout {
                                spacing: 12px;
                                Text {
                                    text: root.tr.lbl-accent-color;
                                    color: UiTheme.text-muted;
                                    font-size: 13px;
                                    width: 160px;
                                    vertical-alignment: center;
                                }
                                HorizontalLayout {
                                    spacing: 10px;
                                    alignment: start;
                                    for swatch[sidx] in [#0284c7, #6366f1, #059669, #d97706, #e11d48] : Rectangle {
                                        width: 28px;
                                        height: 28px;
                                        border-radius: 14px;
                                        background: swatch;
                                        border-width: root.set-accent-idx == sidx ? 3px : 1px;
                                        border-color: root.set-accent-idx == sidx ? UiTheme.text-primary : UiTheme.card-border;
                                        TouchArea {
                                            clicked => {
                                                root.set-accent-idx = sidx;
                                                root.set-accent-color(sidx);
                                            }
                                        }
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 12px;
                                Text {
                                    text: root.tr.lbl-taskbar-style;
                                    color: UiTheme.text-muted;
                                    font-size: 13px;
                                    width: 160px;
                                    vertical-alignment: center;
                                }
                                ComboBox {
                                    model: ["Docked Bar", "Floating Pill Dock"];
                                    current-index <=> root.set-taskbar-style-idx;
                                    horizontal-stretch: 1;
                                }
                            }

                            HorizontalLayout {
                                spacing: 18px;
                                Switch {
                                    text: root.tr.chk-natural-scroll;
                                    checked <=> root.set-natural-scroll;
                                }
                                Switch {
                                    text: root.tr.chk-tap-click;
                                    checked <=> root.set-tap-to-click;
                                }
                                Switch {
                                    text: "Desktop Icons";
                                    checked <=> root.set-desktop-icons;
                                }
                            }

                            HorizontalLayout {
                                spacing: 18px;
                                Switch {
                                    text: root.tr.chk-high-contrast;
                                    checked <=> root.set-high-contrast;
                                }
                                Switch {
                                    text: root.tr.chk-large-text;
                                    checked <=> root.set-large-text;
                                }
                            }

                            HorizontalLayout {
                                spacing: 12px;
                                Text {
                                    text: root.tr.lbl-pointer-speed + " (" + (Math.round(root.set-pointer-speed-tenths) / 10) + ")";
                                    color: UiTheme.text-secondary;
                                    font-size: 13px;
                                    width: 160px;
                                    vertical-alignment: center;
                                }
                                Slider {
                                    minimum: -8;
                                    maximum: 8;
                                    step: 1;
                                    value <=> root.set-pointer-speed-tenths;
                                    horizontal-stretch: 1;
                                }
                            }

                            HorizontalLayout {
                                spacing: 12px;
                                Button {
                                    text: root.tr.btn-apply-personalize;
                                    primary: true;
                                    clicked => {
                                        root.apply-personalize(
                                            root.set-theme-idx,
                                            root.set-wallpaper-idx,
                                            root.set-wallpaper-custom,
                                            root.set-kb-layout-idx,
                                            root.set-natural-scroll,
                                            root.set-tap-to-click,
                                            Math.round(root.set-pointer-speed-tenths),
                                            root.set-desktop-icons,
                                            root.set-taskbar-style-idx,
                                            root.set-desktop-layout-idx,
                                            root.set-accent-idx,
                                            root.set-high-contrast,
                                            root.set-large-text
                                        );
                                    }
                                }
                                if root.set-personalize-status != "" : Text {
                                    text: root.set-personalize-status;
                                    color: UiTheme.text-accent;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                            }
                        }
                    }

                    // Accessibility & Touch Helpers (0 MB Idle RAM)
                    Card {
                        VerticalLayout {
                            padding: 16px;
                            spacing: 10px;
                            Text {
                                text: root.tr.hdr-accessibility;
                                color: UiTheme.text-primary;
                                font-size: 15px;
                                font-weight: 700;
                            }
                            HorizontalLayout {
                                spacing: 10px;
                                Button {
                                    text: root.a11y-osk-running ? root.tr.btn-osk-toggle + " (ON)" : root.tr.btn-osk-toggle;
                                    primary: root.a11y-osk-running;
                                    clicked => { root.toggle-osk(); }
                                }
                                Button {
                                    text: root.tr.btn-read-aloud;
                                    enabled: root.a11y-tts-available;
                                    clicked => { root.speak-clipboard(); }
                                }
                            }
                        }
                    }
                }
            }

            // Subtab 4: Printers (On-Demand CUPS)
            if root.settings-subtab == 4 : Card {
                vertical-stretch: 1;
                VerticalLayout {
                    padding: 14px;
                    spacing: 10px;

                    Text {
                        text: root.tr.hdr-printers;
                        color: UiTheme.text-primary;
                        font-size: 15px;
                        font-weight: 700;
                    }

                    InfoRow { label: "CUPS Status:"; value: root.set-cups-summary; value-color: root.set-cups-active ? UiTheme.text-ok : UiTheme.text-accent; }

                    HorizontalLayout {
                        spacing: 12px;
                        Switch {
                            text: root.tr.chk-cups-service;
                            checked <=> root.set-cups-active;
                            toggled => { root.toggle-cups(self.checked); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Button {
                            text: root.tr.btn-open-scanner;
                            clicked => { root.open-document-scanner(); }
                        }
                        Button {
                            text: root.tr.btn-scan-printers;
                            enabled: root.set-cups-active;
                            clicked => { root.scan-printers(); }
                        }
                    }

                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 6px;
                            alignment: start;

                            if root.set-printer-list.length == 0 : Text {
                                text: root.set-cups-active ? "No printers configured yet. Click Scan USB / Wi-Fi or enter an IPP/USB printer URI below." : "Enable the printer service above to manage USB & Wi-Fi printers (0 MB idle RAM when off).";
                                color: UiTheme.text-muted;
                                font-size: 12px;
                                wrap: word-wrap;
                            }

                            for pr[idx] in root.set-printer-list : Rectangle {
                                height: 40px;
                                border-radius: 6px;
                                background: idx == root.set-selected-printer-idx ? #0369a1 : (pta.has-hover ? UiTheme.surface-hover : UiTheme.surface-subtle);
                                border-width: 1px;
                                border-color: pr.is-default ? #22c55e : (idx == root.set-selected-printer-idx ? #38bdf8 : #334155);

                                pta := TouchArea {
                                    clicked => { root.select-printer(idx); }
                                }

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 10px;
                                    Text {
                                        text: pr.is-default ? "* " + pr.name + " (Default)" : pr.name;
                                        color: idx == root.set-selected-printer-idx ? #ffffff : UiTheme.text-primary;
                                        font-size: 12px;
                                        font-weight: pr.is-default ? 700 : 500;
                                        horizontal-stretch: 1;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: pr.status;
                                        color: UiTheme.text-muted;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        Button {
                            text: root.tr.btn-set-default;
                            enabled: root.set-cups-active && root.set-selected-printer-name != "";
                            clicked => { root.printer-action("default", root.set-selected-printer-name); }
                        }
                        Button {
                            text: root.tr.btn-test-page;
                            enabled: root.set-cups-active && root.set-selected-printer-name != "";
                            clicked => { root.printer-action("test", root.set-selected-printer-name); }
                        }
                        Button {
                            text: root.tr.btn-remove-printer;
                            enabled: root.set-cups-active && root.set-selected-printer-name != "";
                            clicked => { root.printer-action("remove", root.set-selected-printer-name); }
                        }
                    }

                    Rectangle { height: 1px; background: UiTheme.card-border; }

                    ComboBox {
                        model: root.set-discovered-printers;
                        current-index <=> root.set-discovered-idx;
                        enabled: root.set-cups-active;
                        selected => { root.select-discovered-printer(self.current-index); }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        LineEdit {
                            text <=> root.set-printer-name-input;
                            placeholder-text: "Printer Name (e.g. Office_Laser)";
                            enabled: root.set-cups-active;
                            horizontal-stretch: 1;
                        }
                        LineEdit {
                            text <=> root.set-printer-uri-input;
                            placeholder-text: "ipp://192.168.1.50/ipp/print or usb://...";
                            enabled: root.set-cups-active;
                            horizontal-stretch: 2;
                        }
                        Button {
                            text: root.tr.btn-add-printer;
                            primary: true;
                            enabled: root.set-cups-active;
                            clicked => { root.add-printer(root.set-printer-name-input, root.set-printer-uri-input); }
                        }
                    }
                }
            }

            // Subtab 5: Security, Firewall, VPN & 1-Click Backup
            if root.settings-subtab == 5 : ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    spacing: 10px;
                    alignment: start;

                    Card {
                        VerticalLayout {
                            padding: 14px;
                            spacing: 8px;

                            Text {
                                text: root.tr.hdr-firewall;
                                color: UiTheme.text-primary;
                                font-size: 14px;
                                font-weight: 700;
                            }
                            InfoRow { label: "Status:"; value: root.set-fw-summary; value-color: root.set-fw-enabled ? #4ade80 : #fbbf24; }

                            HorizontalLayout {
                                spacing: 14px;
                                Switch {
                                    text: root.tr.chk-firewall;
                                    checked <=> root.set-fw-enabled;
                                    toggled => { root.toggle-firewall(self.checked); }
                                }
                                Switch {
                                    text: root.tr.chk-fw-ssh;
                                    checked <=> root.set-fw-ssh;
                                    enabled: root.set-fw-enabled;
                                    toggled => { root.firewall-ssh-toggled(self.checked); }
                                }
                            }

                            HorizontalLayout {
                                spacing: 10px;
                                Text {
                                    text: "Network Profile:";
                                    color: UiTheme.text-muted;
                                    font-size: 12px;
                                    width: 130px;
                                    vertical-alignment: center;
                                }
                                ComboBox {
                                    model: ["Home / Office (Allow LAN & mDNS Printers)", "Public Wi-Fi (Strict Block Inbound)"];
                                    current-index <=> root.set-fw-profile-idx;
                                    enabled: root.set-fw-enabled;
                                    selected => { root.firewall-profile-changed(self.current-index); }
                                    horizontal-stretch: 1;
                                }
                            }
                        }
                    }

                    Card {
                        VerticalLayout {
                            padding: 14px;
                            spacing: 8px;

                            Text {
                                text: root.tr.hdr-vpn;
                                color: UiTheme.text-primary;
                                font-size: 14px;
                                font-weight: 700;
                            }

                            if root.set-vpn-list.length == 0 : Text {
                                text: "No VPN profiles imported yet. Enter a WireGuard (.conf) or OpenVPN (.ovpn) file path below.";
                                color: UiTheme.text-muted;
                                font-size: 12px;
                                wrap: word-wrap;
                            }

                            for vpn[idx] in root.set-vpn-list : Rectangle {
                                height: 36px;
                                border-radius: 6px;
                                background: idx == root.set-selected-vpn-idx ? #0369a1 : (vta.has-hover ? UiTheme.surface-hover : UiTheme.surface-subtle);
                                border-width: 1px;
                                border-color: vpn.active ? #22c55e : (idx == root.set-selected-vpn-idx ? #38bdf8 : #334155);

                                vta := TouchArea {
                                    clicked => { root.select-vpn(idx); }
                                }

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 10px;
                                    Text {
                                        text: vpn.name + " [" + vpn.vpn-type + "]";
                                        color: idx == root.set-selected-vpn-idx ? #ffffff : UiTheme.text-primary;
                                        font-size: 12px;
                                        font-weight: vpn.active ? 700 : 500;
                                        horizontal-stretch: 1;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: vpn.active ? "Connected" : "Idle";
                                        color: vpn.active ? #4ade80 : UiTheme.text-muted;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                LineEdit {
                                    text <=> root.set-vpn-import-path;
                                    placeholder-text: "/data/home/Downloads/wg0.conf or office.ovpn";
                                    horizontal-stretch: 1;
                                }
                                Button {
                                    text: root.tr.btn-browse;
                                    clicked => { root.open-file-picker("vpn"); }
                                }
                                Button {
                                    text: root.tr.btn-import-vpn;
                                    primary: true;
                                    clicked => { root.import-vpn(root.set-vpn-import-path); }
                                }
                                Button {
                                    text: "Connect";
                                    enabled: root.set-selected-vpn-name != "";
                                    clicked => { root.vpn-action("connect", root.set-selected-vpn-name); }
                                }
                                Button {
                                    text: "Disconnect";
                                    enabled: root.set-selected-vpn-name != "";
                                    clicked => { root.vpn-action("disconnect", root.set-selected-vpn-name); }
                                }
                                Button {
                                    text: "Delete";
                                    enabled: root.set-selected-vpn-name != "";
                                    clicked => { root.vpn-action("delete", root.set-selected-vpn-name); }
                                }
                            }
                        }
                    }

                    Card {
                        VerticalLayout {
                            padding: 14px;
                            spacing: 8px;

                            Text {
                                text: root.tr.hdr-backup;
                                color: UiTheme.text-primary;
                                font-size: 14px;
                                font-weight: 700;
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                ComboBox {
                                    model: root.set-backup-targets;
                                    current-index <=> root.set-backup-target-idx;
                                    enabled: !root.set-backup-busy;
                                    horizontal-stretch: 1;
                                }
                                Button {
                                    text: root.tr.btn-refresh;
                                    enabled: !root.set-backup-busy;
                                    clicked => { root.refresh-backup-targets(); }
                                }
                            }

                            HorizontalLayout {
                                spacing: 10px;
                                CheckBox {
                                    text: root.tr.chk-backup-enc;
                                    checked <=> root.set-backup-encrypted;
                                    enabled: !root.set-backup-busy;
                                }
                                LineEdit {
                                    text <=> root.set-backup-passphrase;
                                    placeholder-text: "Backup / Restore passphrase (min 8 chars)";
                                    input-type: InputType.password;
                                    enabled: !root.set-backup-busy;
                                    horizontal-stretch: 1;
                                }
                                Button {
                                    text: root.set-backup-busy ? "Working..." : root.tr.btn-create-backup;
                                    primary: true;
                                    enabled: !root.set-backup-busy;
                                    clicked => { root.create-backup(root.set-backup-target-idx, root.set-backup-encrypted, root.set-backup-passphrase); }
                                }
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                LineEdit {
                                    text <=> root.set-backup-restore-path;
                                    placeholder-text: "/media/usb/unicore-backup-YYYYMMDD.tar.zst.enc";
                                    enabled: !root.set-backup-busy;
                                    horizontal-stretch: 1;
                                }
                                Button {
                                    text: root.tr.btn-browse;
                                    enabled: !root.set-backup-busy;
                                    clicked => { root.open-file-picker("backup-restore"); }
                                }
                                Button {
                                    text: root.tr.btn-restore-backup;
                                    enabled: !root.set-backup-busy;
                                    clicked => { root.restore-backup(root.set-backup-restore-path, root.set-backup-passphrase); }
                                }
                            }

                            if root.set-backup-status != "" : Text {
                                text: root.set-backup-status;
                                color: UiTheme.text-accent;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                        }
                    }

                    Card {
                        VerticalLayout {
                            padding: 14px;
                            spacing: 8px;
                            Text {
                                text: "UEFI Secure Boot & Machine Owner Key (MOK)";
                                color: UiTheme.text-primary;
                                font-size: 14px;
                                font-weight: 700;
                            }
                            Text {
                                text: root.set-sb-summary;
                                color: UiTheme.text-secondary;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                            if root.set-sb-can-enroll : HorizontalLayout {
                                spacing: 8px;
                                LineEdit {
                                    text <=> root.set-sb-mok-pass;
                                    placeholder-text: "One-time MOK enroll password (8-32 chars)";
                                    input-type: InputType.password;
                                    horizontal-stretch: 1;
                                }
                                Button {
                                    text: "Enroll UniCore MOK";
                                    primary: true;
                                    clicked => { root.enroll-secureboot-mok(root.set-sb-mok-pass); }
                                }
                            }
                            if root.set-sb-status != "" : Text {
                                text: root.set-sb-status;
                                color: UiTheme.text-accent;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }

            // Subtab 6: Power Profiles, Auto-Lock (swayidle), S.M.A.R.T. Disk Health & Multi-User Accounts
            if root.settings-subtab == 6 : ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    spacing: 10px;
                    alignment: start;

                    Card {
                        VerticalLayout {
                            padding: 14px;
                            spacing: 8px;

                            Text {
                                text: root.tr.hdr-power-smart;
                                color: UiTheme.text-primary;
                                font-size: 14px;
                                font-weight: 700;
                            }

                            HorizontalLayout {
                                spacing: 10px;
                                Text { text: "Power Profile:"; color: UiTheme.text-muted; font-size: 12px; width: 150px; vertical-alignment: center; }
                                ComboBox {
                                    model: ["Power Saver", "Balanced", "Performance"];
                                    current-index <=> root.pwr-profile-idx;
                                    selected => { root.set-power-profile(self.current-index); }
                                    horizontal-stretch: 1;
                                }
                                Text { text: "Bat: " + root.pwr-battery-label; color: UiTheme.text-accent; font-size: 12px; vertical-alignment: center; }
                            }

                            HorizontalLayout {
                                spacing: 10px;
                                Text { text: "Screen Off (" + Math.round(root.pwr-screen-min) + " min):"; color: UiTheme.text-secondary; font-size: 12px; width: 170px; vertical-alignment: center; }
                                Slider { minimum: 0; maximum: 60; step: 1; value <=> root.pwr-screen-min; horizontal-stretch: 1; }
                            }
                            HorizontalLayout {
                                spacing: 10px;
                                Text { text: "Auto-Lock (" + Math.round(root.pwr-lock-min) + " min):"; color: UiTheme.text-secondary; font-size: 12px; width: 170px; vertical-alignment: center; }
                                Slider { minimum: 0; maximum: 60; step: 1; value <=> root.pwr-lock-min; horizontal-stretch: 1; }
                            }
                            HorizontalLayout {
                                spacing: 10px;
                                Text { text: "Battery Sleep (" + Math.round(root.pwr-suspend-bat-min) + " min):"; color: UiTheme.text-secondary; font-size: 12px; width: 170px; vertical-alignment: center; }
                                Slider { minimum: 0; maximum: 120; step: 5; value <=> root.pwr-suspend-bat-min; horizontal-stretch: 1; }
                                Button {
                                    text: "Apply Timers";
                                    primary: true;
                                    clicked => { root.apply-idle-timers(Math.round(root.pwr-screen-min), Math.round(root.pwr-lock-min), Math.round(root.pwr-suspend-bat-min)); }
                                }
                            }

                            Rectangle { height: 1px; background: UiTheme.card-border; }

                            HorizontalLayout {
                                spacing: 10px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 2px;
                                    InfoRow { label: "Disk Device:"; value: root.pwr-smart-device + " (" + root.pwr-smart-model + ")"; }
                                    InfoRow { label: "S.M.A.R.T. Health:"; value: root.pwr-smart-health + " | Temp: " + root.pwr-smart-temp + " | Hours: " + root.pwr-smart-hours; value-color: UiTheme.text-ok; }
                                }
                                Button {
                                    text: "Scan Disk Health";
                                    clicked => { root.scan-smart-health(); }
                                }
                            }
                        }
                    }

                    Card {
                        VerticalLayout {
                            padding: 14px;
                            spacing: 8px;

                            Text {
                                text: root.tr.hdr-users;
                                color: UiTheme.text-primary;
                                font-size: 14px;
                                font-weight: 700;
                            }

                            for usr[idx] in root.user-list : Rectangle {
                                height: 34px;
                                border-radius: 6px;
                                background: idx == root.selected-user-idx ? #0369a1 : (uta.has-hover ? UiTheme.surface-hover : UiTheme.surface-subtle);
                                border-width: 1px;
                                border-color: idx == root.selected-user-idx ? #38bdf8 : UiTheme.card-border;

                                uta := TouchArea { clicked => { root.select-user(idx); } }

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 10px;
                                    Text {
                                        text: usr.username + " (UID " + usr.uid + ", " + usr.role + ")";
                                        color: idx == root.selected-user-idx ? #ffffff : UiTheme.text-primary;
                                        font-size: 12px;
                                        font-weight: 600;
                                        horizontal-stretch: 1;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: usr.has-password ? "Password Set" : "Auto-Login (No Password)";
                                        color: idx == root.selected-user-idx ? #e0f2fe : UiTheme.text-muted;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                LineEdit { text <=> root.new-user-name; placeholder-text: "New username (a-z, min 2 chars)"; horizontal-stretch: 1; }
                                ComboBox { model: ["Standard", "Admin"]; current-index <=> root.new-user-role-idx; width: 110px; }
                                LineEdit { text <=> root.new-user-pass; placeholder-text: "Password (min 4 chars)"; input-type: InputType.password; horizontal-stretch: 1; }
                                Button {
                                    text: "Add User";
                                    primary: true;
                                    clicked => { root.add-user-account(root.new-user-name, root.new-user-role-idx, root.new-user-pass); }
                                }
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                LineEdit {
                                    text <=> root.update-user-pass;
                                    placeholder-text: "New password for '" + root.selected-user-name + "' (blank clears unicore pw)";
                                    input-type: InputType.password;
                                    enabled: root.selected-user-name != "";
                                    horizontal-stretch: 1;
                                }
                                Button {
                                    text: "Set Password";
                                    enabled: root.selected-user-name != "";
                                    clicked => { root.set-selected-user-password(root.update-user-pass); }
                                }
                                Button {
                                    text: "Delete User";
                                    enabled: root.selected-user-name != "" && root.selected-user-name != "unicore";
                                    clicked => { root.delete-selected-user(); }
                                }
                            }
                        }
                    }
                }
            }
        }

        // Tab 5: Developer Environments & Local AI (Ollama + Rootless Podman DevBox)
        if root.show-tabs && root.active-tab == 5 : ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 12px;
                alignment: start;

                Card {
                    VerticalLayout {
                        padding: 14px;
                        spacing: 8px;

                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: root.tr.hdr-local-ai;
                                color: UiTheme.text-primary;
                                font-size: 15px;
                                font-weight: 700;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                            }
                            Button {
                                text: "Open AI Copilot (Win+A)";
                                primary: true;
                                clicked => { root.ai-dialog-only = true; }
                            }
                        }
                        InfoRow {
                            label: "Engine Status:";
                            value: root.ai-provider-idx == 1
                                ? ("Google Gemini Cloud API (" + (root.ai-api-key-set ? "Key Configured" : "Key Missing") + ")")
                                : (root.ai-provider-idx == 2
                                    ? ("OpenAI-Compatible API (" + (root.ai-api-key-set ? "Key Configured" : "Key Missing") + ")")
                                    : (root.ai-running ? ("Running (" + root.ai-endpoint + ")") : (root.ai-installed ? "Installed / Idle (0 MB RAM)" : "Not installed yet (1-click install to /data/ai)")));
                            value-color: (root.ai-running || (root.ai-provider-idx != 0 && root.ai-api-key-set)) ? UiTheme.text-ok : UiTheme.text-accent;
                        }
                        InfoRow { label: "Recommended:"; value: root.ai-recommended-model; }
                        InfoRow { label: "Downloaded Models:"; value: root.ai-models-summary; }

                        HorizontalLayout {
                            spacing: 8px;
                            ComboBox {
                                model: ["Local Offline (Ollama)", "Google Gemini API", "OpenAI-Compatible API"];
                                current-index <=> root.ai-provider-idx;
                                width: 195px;
                            }
                            if root.ai-provider-idx != 0 : LineEdit {
                                text <=> root.ai-api-key-input;
                                placeholder-text: root.ai-api-key-set ? "API key saved (leave blank to keep)" : "Paste API key (chmod 600)";
                                input-type: InputType.password;
                                horizontal-stretch: 1;
                            }
                            if root.ai-provider-idx == 2 : LineEdit {
                                text <=> root.ai-base-url-input;
                                placeholder-text: "https://api.openai.com/v1";
                                width: 190px;
                            }
                            Button {
                                text: "Save Provider";
                                enabled: !root.ai-busy;
                                clicked => { root.ai-save-provider(root.ai-provider-idx, root.ai-model-input, root.ai-base-url-input, root.ai-api-key-input); }
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            Button {
                                text: root.ai-installed ? "Reinstall Ollama" : "Install Ollama";
                                enabled: !root.ai-busy;
                                clicked => { root.ai-action("install", ""); }
                            }
                            Button {
                                text: "Start Local AI";
                                primary: true;
                                enabled: root.ai-installed && !root.ai-running && !root.ai-busy;
                                clicked => { root.ai-action("start", ""); }
                            }
                            Button {
                                text: "Stop AI (Free RAM)";
                                enabled: root.ai-running && !root.ai-busy;
                                clicked => { root.ai-action("stop", ""); }
                            }
                            LineEdit {
                                text <=> root.ai-model-input;
                                placeholder-text: "Model (e.g. llama3.2:1b or gemini-2.5-flash)";
                                enabled: !root.ai-busy;
                                horizontal-stretch: 1;
                            }
                            Button {
                                text: "Pull Model";
                                enabled: root.ai-installed && root.ai-running && !root.ai-busy;
                                clicked => { root.ai-action("pull", root.ai-model-input); }
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            LineEdit {
                                text <=> root.ai-prompt-input;
                                placeholder-text: "Ask UniCore AI Assistant (local Ollama or Gemini/OpenAI API)...";
                                enabled: (root.ai-running || (root.ai-provider-idx != 0 && root.ai-api-key-set)) && !root.ai-busy;
                                horizontal-stretch: 1;
                            }
                            Button {
                                text: root.ai-busy ? "Working..." : "Ask AI";
                                primary: true;
                                enabled: (root.ai-running || (root.ai-provider-idx != 0 && root.ai-api-key-set)) && !root.ai-busy && root.ai-prompt-input != "";
                                clicked => { root.ai-ask(root.ai-model-input, root.ai-prompt-input); }
                            }
                        }

                        if root.ai-response-text != "" : Rectangle {
                            height: 92px;
                            background: UiTheme.surface-subtle;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: UiTheme.card-border;
                            ScrollView {
                                Text {
                                    text: root.ai-response-text;
                                    color: UiTheme.text-primary;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                    x: 8px;
                                    y: 6px;
                                    width: parent.width - 16px;
                                }
                            }
                        }
                    }
                }

                Card {
                    VerticalLayout {
                        padding: 14px;
                        spacing: 8px;

                        Text {
                            text: root.tr.hdr-devbox;
                            color: UiTheme.text-primary;
                            font-size: 15px;
                            font-weight: 700;
                        }
                        InfoRow { label: "Host Tooling:"; value: root.dev-tools-summary; value-color: UiTheme.text-accent; }
                        InfoRow { label: "Workspace Root:"; value: root.dev-projects-dir; }

                        HorizontalLayout {
                            spacing: 8px;
                            ComboBox {
                                model: ["Python 3.12 (python)", "Node.js 22 (node)", "Rust Stable (rust)", "Ubuntu 24.04 glibc (ubuntu)"];
                                current-index <=> root.dev-template-idx;
                                width: 220px;
                            }
                            LineEdit {
                                text <=> root.dev-new-name;
                                placeholder-text: "DevBox name (e.g. py-lab)";
                                horizontal-stretch: 1;
                            }
                            Button {
                                text: "Create DevBox";
                                primary: true;
                                clicked => { root.create-devbox(root.dev-template-idx, root.dev-new-name); }
                            }
                        }

                        if root.dev-containers.length == 0 : Text {
                            text: "No rootless Podman DevBoxes created yet. Choose a template above (mounted at /data/dev/projects -> /workspace).";
                            color: UiTheme.text-muted;
                            font-size: 12px;
                            wrap: word-wrap;
                        }

                        for box_label[idx] in root.dev-containers : Rectangle {
                            height: 36px;
                            border-radius: 6px;
                            background: idx == root.selected-dev-idx ? #0369a1 : (dta.has-hover ? UiTheme.surface-hover : UiTheme.surface-subtle);
                            border-width: 1px;
                            border-color: idx == root.selected-dev-idx ? #38bdf8 : UiTheme.card-border;
                            dta := TouchArea { clicked => { root.select-devbox(idx); } }
                            Text {
                                text: box_label;
                                color: idx == root.selected-dev-idx ? #ffffff : UiTheme.text-primary;
                                font-size: 12px;
                                x: 10px;
                                vertical-alignment: center;
                                width: parent.width - 20px;
                                overflow: elide;
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            Button {
                                text: "Open Shell Terminal";
                                enabled: root.selected-dev-idx >= 0;
                                clicked => { root.open-devbox-shell(); }
                            }
                            Button {
                                text: "Remove DevBox";
                                enabled: root.selected-dev-idx >= 0;
                                clicked => { root.remove-devbox(); }
                            }
                            Button {
                                text: root.tr.btn-refresh;
                                clicked => { root.refresh-dev-ai(); }
                            }
                        }
                    }
                }
            }
        }

        // Tab 4: UniCore App Store (Microsoft Store / Play Store Storefront Layout)
        if root.show-tabs && root.active-tab == 4 : HorizontalLayout {
            spacing: 12px;
            vertical-stretch: 1;

            // Left Store Navigation Rail
            Card {
                width: 158px;
                VerticalLayout {
                    padding: 10px;
                    spacing: 6px;

                    Text {
                        text: root.tr.tab-store + " UniCore";
                        color: UiTheme.text-primary;
                        font-size: 14px;
                        font-weight: 800;
                        height: 28px;
                        vertical-alignment: center;
                    }

                    StoreNavItem {
                        label: root.tr.store-nav-discover;
                        active: root.store-category == "all";
                        clicked => {
                            root.store-detail-open = false;
                            root.store-category = "all";
                            root.store-filter-changed("all", root.store-search-query);
                        }
                    }
                    StoreNavItem {
                        label: root.tr.store-cat-gaming;
                        active: root.store-category == "gaming";
                        clicked => {
                            root.store-detail-open = false;
                            root.store-category = "gaming";
                            root.store-filter-changed("gaming", root.store-search-query);
                        }
                    }
                    StoreNavItem {
                        label: root.tr.store-cat-creative;
                        active: root.store-category == "creative";
                        clicked => {
                            root.store-detail-open = false;
                            root.store-category = "creative";
                            root.store-filter-changed("creative", root.store-search-query);
                        }
                    }
                    StoreNavItem {
                        label: root.tr.store-cat-social;
                        active: root.store-category == "social";
                        clicked => {
                            root.store-detail-open = false;
                            root.store-category = "social";
                            root.store-filter-changed("social", root.store-search-query);
                        }
                    }
                    StoreNavItem {
                        label: root.tr.store-cat-dev;
                        active: root.store-category == "dev";
                        clicked => {
                            root.store-detail-open = false;
                            root.store-category = "dev";
                            root.store-filter-changed("dev", root.store-search-query);
                        }
                    }
                    StoreNavItem {
                        label: root.tr.store-cat-office;
                        active: root.store-category == "office";
                        clicked => {
                            root.store-detail-open = false;
                            root.store-category = "office";
                            root.store-filter-changed("office", root.store-search-query);
                        }
                    }
                    StoreNavItem {
                        label: root.tr.store-cat-android;
                        active: root.store-category == "android";
                        clicked => {
                            root.store-detail-open = false;
                            root.store-category = "android";
                            root.store-filter-changed("android", root.store-search-query);
                        }
                    }
                    StoreNavItem {
                        label: root.tr.store-cat-retro;
                        active: root.store-category == "retro";
                        clicked => {
                            root.store-detail-open = false;
                            root.store-category = "retro";
                            root.store-filter-changed("retro", root.store-search-query);
                        }
                    }
                    StoreNavItem {
                        label: root.tr.store-cat-util;
                        active: root.store-category == "utilities";
                        clicked => {
                            root.store-detail-open = false;
                            root.store-category = "utilities";
                            root.store-filter-changed("utilities", root.store-search-query);
                        }
                    }

                    Rectangle { vertical-stretch: 1; }

                    Rectangle { height: 1px; background: UiTheme.card-border; }

                    Button {
                        text: root.tr.store-feed-toggle;
                        clicked => { root.store-show-feed = !root.store-show-feed; }
                    }
                }
            }

            // Right Storefront Canvas / App Detail Page
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 10px;

                // Top Search Bar (when in storefront view)
                if !root.store-detail-open : HorizontalLayout {
                    spacing: 8px;
                    LineEdit {
                        text <=> root.store-search-query;
                        placeholder-text: root.tr.store-search-hint;
                        horizontal-stretch: 1;
                        edited(txt) => { root.store-filter-changed(root.store-category, txt); }
                    }
                    Rectangle {
                        width: 72px;
                        border-radius: 6px;
                        background: UiTheme.card-bg;
                        border-width: 1px;
                        border-color: UiTheme.card-border;
                        Text {
                            text: root.store-entries.length + " apps";
                            color: UiTheme.text-muted;
                            font-size: 11px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                // Collapsible Signed HTTPS Catalog Feed URL Bar
                if root.store-show-feed && !root.store-detail-open : Card {
                    HorizontalLayout {
                        padding: 10px;
                        spacing: 8px;
                        LineEdit {
                            text <=> root.store-sync-url;
                            placeholder-text: "Leave blank for Official Ed25519 Signed GitHub Catalog, or enter custom HTTPS URL";
                            enabled: !root.store-busy;
                            horizontal-stretch: 1;
                        }
                        Button {
                            text: root.tr.btn-store-sync;
                            enabled: !root.store-busy;
                            clicked => { root.store-sync-catalog(root.store-sync-url); }
                        }
                    }
                }

                if root.store-busy && !root.store-detail-open : ProgressIndicator {
                    indeterminate: true;
                    height: 8px;
                }

                if root.store-status != "" && !root.store-detail-open : Text {
                    text: root.store-status;
                    color: root.store-busy ? #fbbf24 : #38bdf8;
                    font-size: 12px;
                    wrap: word-wrap;
                }

                // STOREFRONT GRID VIEW
                if !root.store-detail-open : ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 12px;
                        alignment: start;

                        // 1-Click Native Wayland Web Browsers Strip (Epiphany / Firefox / Chromium)
                        if root.store-category == "all" && root.store-search-query == "" : Card {
                            HorizontalLayout {
                                padding: 10px;
                                spacing: 8px;
                                Text {
                                    text: "Web Browsers (Native Wayland):";
                                    color: UiTheme.text-primary;
                                    font-size: 12px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                                Button {
                                    text: root.store-browser-default == "epiphany" ? "Epiphany (Default)" : "Use Epiphany";
                                    enabled: !root.store-busy && root.store-browser-default != "epiphany";
                                    clicked => { root.set-default-browser("epiphany"); }
                                }
                                Button {
                                    text: root.store-firefox-installed ? (root.store-browser-default == "firefox" ? "Firefox (Default)" : "Use Firefox") : "1-Click Install Firefox";
                                    primary: !root.store-firefox-installed;
                                    enabled: !root.store-busy && !(root.store-firefox-installed && root.store-browser-default == "firefox");
                                    clicked => {
                                        if (root.store-firefox-installed) {
                                            root.set-default-browser("firefox");
                                        } else {
                                            root.install-native-browser("firefox");
                                        }
                                    }
                                }
                                Button {
                                    text: root.store-chromium-installed ? (root.store-browser-default == "chromium" ? "Chromium (Default)" : "Use Chromium") : "1-Click Install Chromium";
                                    enabled: !root.store-busy && !(root.store-chromium-installed && root.store-browser-default == "chromium");
                                    clicked => {
                                        if (root.store-chromium-installed) {
                                            root.set-default-browser("chromium");
                                        } else {
                                            root.install-native-browser("chromium");
                                        }
                                    }
                                }
                            }
                        }

                        // Featured Hero Banner (shown on Discover view without active search)
                        if root.store-has-featured && root.store-category == "all" && root.store-search-query == "" : Rectangle {
                            height: 136px;
                            border-radius: 12px;
                            background: @linear-gradient(135deg, #0c4a6e 0%, #1d4ed8 55%, #312e81 100%);
                            border-width: 1px;
                            border-color: #38bdf8;

                            hero-ta := TouchArea {
                                clicked => {
                                    root.store-detail = root.store-featured;
                                    root.store-detail-open = true;
                                }
                            }

                            HorizontalLayout {
                                padding: 16px;
                                spacing: 16px;

                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 1;
                                    spacing: 5px;

                                    Text {
                                        text: root.tr.store-featured-tag + " • " + root.store-featured.platform-short;
                                        color: #7dd3fc;
                                        font-size: 10px;
                                        font-weight: 800;
                                    }
                                    Text {
                                        text: root.store-featured.name + "  v" + root.store-featured.version;
                                        color: #ffffff;
                                        font-size: 18px;
                                        font-weight: 800;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: root.store-featured.summary;
                                        color: #e0f2fe;
                                        font-size: 12px;
                                        wrap: word-wrap;
                                        overflow: elide;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 12px;
                                    alignment: center;
                                    Rectangle {
                                        width: 72px;
                                        height: 72px;
                                        border-radius: 14px;
                                        background: root.store-featured.accent-color;
                                        border-width: 2px;
                                        border-color: #e0f2fe;
                                        y: 16px;
                                        Text {
                                            text: root.store-featured.icon-text;
                                            color: #ffffff;
                                            font-size: 22px;
                                            font-weight: 800;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        if !root.store-featured.is-installed : Button {
                                            text: root.tr.store-btn-get;
                                            primary: true;
                                            enabled: !root.store-busy;
                                            clicked => { root.store-install-app(root.store-featured.id); }
                                        }
                                        if root.store-featured.is-installed : Button {
                                            text: root.tr.store-btn-open;
                                            clicked => { root.store-launch-app(root.store-featured.installed-app-id, root.store-featured.is-flatpak); }
                                        }
                                    }
                                }
                            }
                        }

                        // Modern Gaming & GE-Proton / Flatpak Banner
                        if root.store-category == "gaming" && root.store-search-query == "" : Rectangle {
                            height: 112px;
                            border-radius: 12px;
                            background: @linear-gradient(135deg, #0f172a 0%, #1d4ed8 55%, #0369a1 100%);
                            border-width: 1px;
                            border-color: #38bdf8;
                            HorizontalLayout {
                                padding: 14px;
                                spacing: 14px;
                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 1;
                                    spacing: 4px;
                                    Text {
                                        text: "Modern PC Gaming • Flatpak + GE-Proton + Xbox/PS/Switch Gamepads";
                                        color: #ffffff;
                                        font-size: 14px;
                                        font-weight: 800;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: root.store-flatpak-summary + " | " + root.store-proton-summary;
                                        color: #bae6fd;
                                        font-size: 11px;
                                        wrap: word-wrap;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Button {
                                        text: root.store-proton-busy ? "Installing GE-Proton..." : "Install Latest GE-Proton";
                                        primary: true;
                                        enabled: !root.store-proton-busy && !root.store-busy;
                                        clicked => { root.install-latest-proton(); }
                                    }
                                }
                            }
                        }

                        // Retro & Classic Games Marketplace Banner
                        if root.store-category == "retro" && root.store-search-query == "" : Rectangle {
                            height: 112px;
                            border-radius: 12px;
                            background: @linear-gradient(135deg, #4c1d95 0%, #9d174d 60%, #7f1d1d 100%);
                            border-width: 1px;
                            border-color: #c084fc;

                            HorizontalLayout {
                                padding: 16px;
                                spacing: 14px;
                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 1;
                                    spacing: 5px;
                                    Text {
                                        text: root.tr.store-retro-banner-title;
                                        color: #ffffff;
                                        font-size: 16px;
                                        font-weight: 800;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: root.tr.store-retro-banner-hint;
                                        color: #f3e8ff;
                                        font-size: 11px;
                                        wrap: word-wrap;
                                    }
                                }
                                Rectangle {
                                    width: 148px;
                                    height: 36px;
                                    y: 22px;
                                    border-radius: 8px;
                                    background: #3b0764;
                                    border-width: 1px;
                                    border-color: #e879f9;
                                    Text {
                                        text: "MS-DOS • Win98 • WinXP";
                                        color: #fae8ff;
                                        font-size: 10px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        Text {
                            text: root.tr.store-section-apps;
                            color: UiTheme.text-primary;
                            font-size: 14px;
                            font-weight: 700;
                        }

                        if root.store-rows.length == 0 : Text {
                            text: "No matching applications in catalog.";
                            color: UiTheme.text-muted;
                            font-size: 12px;
                        }

                        for row in root.store-rows : HorizontalLayout {
                            spacing: 10px;

                            if row.has-a : StoreAppCard {
                                item: row.a;
                                get-label: root.tr.store-btn-get;
                                open-label: root.tr.store-btn-open;
                                busy: root.store-busy;
                                horizontal-stretch: 1;
                                card-clicked(entry) => {
                                    root.store-detail = entry;
                                    root.store-detail-open = true;
                                }
                                install-clicked(id) => { root.store-install-app(id); }
                                launch-clicked(app-id) => { root.store-launch-app(app-id, row.a.is-flatpak); }
                            }
                            if !row.has-a : Rectangle { horizontal-stretch: 1; }

                            if row.has-b : StoreAppCard {
                                item: row.b;
                                get-label: root.tr.store-btn-get;
                                open-label: root.tr.store-btn-open;
                                busy: root.store-busy;
                                horizontal-stretch: 1;
                                card-clicked(entry) => {
                                    root.store-detail = entry;
                                    root.store-detail-open = true;
                                }
                                install-clicked(id) => { root.store-install-app(id); }
                                launch-clicked(app-id) => { root.store-launch-app(app-id, row.b.is-flatpak); }
                            }
                            if !row.has-b : Rectangle { horizontal-stretch: 1; }

                            if row.has-c : StoreAppCard {
                                item: row.c;
                                get-label: root.tr.store-btn-get;
                                open-label: root.tr.store-btn-open;
                                busy: root.store-busy;
                                horizontal-stretch: 1;
                                card-clicked(entry) => {
                                    root.store-detail = entry;
                                    root.store-detail-open = true;
                                }
                                install-clicked(id) => { root.store-install-app(id); }
                                launch-clicked(app-id) => { root.store-launch-app(app-id, row.c.is-flatpak); }
                            }
                            if !row.has-c : Rectangle { horizontal-stretch: 1; }
                        }
                    }
                }

                // PLAY STORE / MICROSOFT STORE APP DETAIL VIEW
                if root.store-detail-open : ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 12px;
                        alignment: start;

                        HorizontalLayout {
                            Button {
                                text: root.tr.store-btn-back;
                                clicked => { root.store-detail-open = false; }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }

                        Card {
                            VerticalLayout {
                                padding: 16px;
                                spacing: 14px;

                                HorizontalLayout {
                                    spacing: 16px;
                                    Rectangle {
                                        width: 72px;
                                        height: 72px;
                                        border-radius: 14px;
                                        background: root.store-detail.accent-color;
                                        Text {
                                            text: root.store-detail.icon-text;
                                            color: #ffffff;
                                            font-size: 24px;
                                            font-weight: 800;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        horizontal-stretch: 1;
                                        spacing: 4px;
                                        Text {
                                            text: root.store-detail.name;
                                            color: UiTheme.text-primary;
                                            font-size: 20px;
                                            font-weight: 800;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: root.store-detail.platform-label + " • v" + root.store-detail.version;
                                            color: UiTheme.text-accent;
                                            font-size: 12px;
                                        }
                                        Text {
                                            text: root.store-detail.badge;
                                            color: root.store-detail.is-installed ? #4ade80 : UiTheme.text-muted;
                                            font-size: 11px;
                                            font-weight: 600;
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: center;
                                        if !root.store-detail.is-installed : Button {
                                            text: root.tr.btn-store-install;
                                            primary: true;
                                            enabled: !root.store-busy;
                                            clicked => { root.store-install-app(root.store-detail.id); }
                                        }
                                        if root.store-detail.is-installed : Button {
                                            text: root.tr.btn-store-launch;
                                            primary: true;
                                            clicked => { root.store-launch-app(root.store-detail.installed-app-id, root.store-detail.is-flatpak); }
                                        }
                                        if root.store-detail.is-installed : Button {
                                            text: root.tr.btn-uninstall;
                                            enabled: !root.store-busy;
                                            clicked => { root.store-uninstall-app(root.store-detail.id, root.store-detail.installed-app-id); }
                                        }
                                    }
                                }

                                if root.store-status != "" : Text {
                                    text: root.store-status;
                                    color: root.store-busy ? #fbbf24 : #38bdf8;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }

                                Rectangle { height: 1px; background: UiTheme.card-border; }

                                // 3-Column Play Store Info Strip
                                HorizontalLayout {
                                    spacing: 12px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        Text { text: root.store-detail.size-label; color: UiTheme.text-primary; font-size: 14px; font-weight: 700; horizontal-alignment: center; }
                                        Text { text: "Download Size"; color: UiTheme.text-muted; font-size: 11px; horizontal-alignment: center; }
                                    }
                                    Rectangle { width: 1px; height: 34px; background: UiTheme.card-border; }
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        Text { text: root.store-detail.platform-short; color: UiTheme.text-primary; font-size: 14px; font-weight: 700; horizontal-alignment: center; }
                                        Text { text: "Built-in Subsystem"; color: UiTheme.text-muted; font-size: 11px; horizontal-alignment: center; }
                                    }
                                    Rectangle { width: 1px; height: 34px; background: UiTheme.card-border; }
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        Text { text: root.store-detail.badge; color: UiTheme.text-ok; font-size: 14px; font-weight: 700; horizontal-alignment: center; }
                                        Text { text: "Integrity"; color: UiTheme.text-muted; font-size: 11px; horizontal-alignment: center; }
                                    }
                                }
                            }
                        }

                        Card {
                            VerticalLayout {
                                padding: 16px;
                                spacing: 10px;
                                Text {
                                    text: root.tr.store-about-hdr;
                                    color: UiTheme.text-primary;
                                    font-size: 14px;
                                    font-weight: 700;
                                }
                                Text {
                                    text: root.store-detail.summary;
                                    color: UiTheme.text-muted;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }
                                Rectangle { height: 1px; background: UiTheme.card-border; }
                                Text {
                                    text: root.tr.store-security-hdr;
                                    color: UiTheme.text-primary;
                                    font-size: 14px;
                                    font-weight: 700;
                                }
                                InfoRow { label: "SHA-256 Digest:"; value: root.store-detail.sha256-short; value-color: UiTheme.text-accent; }
                                InfoRow { label: "Isolation:"; value: "Zero-Trust Bubblewrap Sandbox (Camera/Mic/Docs denied by default)"; }
                            }
                        }
                    }
                }
            }
        }

        // Bottom Status Banner
        if root.status-message != "" : Rectangle {
            height: 30px;
            border-radius: 6px;
            background: root.status-is-error ? #7f1d1d : #14532d;
            border-width: 1px;
            border-color: root.status-is-error ? #ef4444 : #22c55e;

            Text {
                text: root.status-message;
                color: #f8fafc;
                font-size: 12px;
                overflow: elide;
                x: 10px;
                width: parent.width - 20px;
                vertical-alignment: center;
            }
        }
    }
}
