#!/bin/sh
# UniCore OS Wayland Desktop Autostart

USER_HOME="${HOME:-/home/unicore}"
mkdir -p "${USER_HOME}/.local/share/applications" "${USER_HOME}/Desktop" "${USER_HOME}/Documents" "${USER_HOME}/Downloads" "${USER_HOME}/Music" "${USER_HOME}/Pictures" "${USER_HOME}/Videos" "${USER_HOME}/Cloud" "${USER_HOME}/.config/gtk-3.0"
if [ ! -f "${USER_HOME}/.config/gtk-3.0/bookmarks" ]; then
    cat <<EOF_BM > "${USER_HOME}/.config/gtk-3.0/bookmarks"
file://${USER_HOME}/Desktop Desktop
file://${USER_HOME}/Documents Documents
file://${USER_HOME}/Downloads Downloads
file://${USER_HOME}/Music Music
file://${USER_HOME}/Pictures Pictures
file://${USER_HOME}/Videos Videos
file://${USER_HOME}/Cloud Cloud Drives
EOF_BM
fi
for desk_src in \
    /usr/share/applications/unicore-center.desktop \
    /usr/share/applications/unicore-files.desktop \
    /usr/share/applications/unicore-browser.desktop; do
    base_name="$(basename "${desk_src}")"
    if [ -f "${desk_src}" ] && [ ! -f "${USER_HOME}/Desktop/${base_name}" ]; then
        cp "${desk_src}" "${USER_HOME}/Desktop/${base_name}"
        chmod +x "${USER_HOME}/Desktop/${base_name}"
    fi
done
if [ -r /mnt/unicore-boot.env ] && grep -q '^UNICORE_BOOT_MODE=live$' /mnt/unicore-boot.env 2>/dev/null; then
    if [ -f /usr/share/applications/unicore-install.desktop ] && [ ! -f "${USER_HOME}/Desktop/unicore-install.desktop" ]; then
        cp /usr/share/applications/unicore-install.desktop "${USER_HOME}/Desktop/unicore-install.desktop"
        chmod +x "${USER_HOME}/Desktop/unicore-install.desktop"
    fi
fi

if command -v pipewire >/dev/null 2>&1; then
    pipewire >/dev/null 2>&1 &
fi
if command -v wireplumber >/dev/null 2>&1; then
    wireplumber >/dev/null 2>&1 &
fi
if command -v pipewire-pulse >/dev/null 2>&1; then
    pipewire-pulse >/dev/null 2>&1 &
fi

# Re-apply persisted display layout (wlr-randr output/mode/scale) and Night Light
if [ -x /data/home/.config/unicore/display.sh ]; then
    /data/home/.config/unicore/display.sh >/dev/null 2>&1 || true
fi
if [ -x /usr/libexec/unicore-nightlight ]; then
    /usr/libexec/unicore-nightlight apply >/dev/null 2>&1 || true
fi

# Skip heavy shell panels, desktop icons, wallpaper, clipboard watcher, idle lock & toast daemon on 2005-2008 legacy_ultra machines (<=1.5GB RAM).
if [ "${UNICORE_LIGHTWEIGHT_SHELL:-0}" != "1" ]; then
    WALLPAPER_PATH="/usr/share/unicore/wallpaper.png"
    SHOW_DESKTOP_ICONS="yes"
    if [ -x /usr/libexec/unicore-personalize ]; then
        P_STATUS="$(/usr/libexec/unicore-personalize status 2>/dev/null || true)"
        SAVED_WP="$(printf '%s\n' "${P_STATUS}" | sed -n 's/^wallpaper=//p' | head -n1 || true)"
        SAVED_DI="$(printf '%s\n' "${P_STATUS}" | sed -n 's/^desktop_icons=//p' | head -n1 || true)"
        if [ -n "${SAVED_WP}" ] && [ -f "${SAVED_WP}" ]; then
            WALLPAPER_PATH="${SAVED_WP}"
        fi
        if [ -n "${SAVED_DI}" ]; then
            SHOW_DESKTOP_ICONS="${SAVED_DI}"
        fi
    fi
    if [ -f "${WALLPAPER_PATH}" ] && command -v swaybg >/dev/null 2>&1; then
        swaybg -i "${WALLPAPER_PATH}" -m fill >/dev/null 2>&1 &
    fi
    if [ "${SHOW_DESKTOP_ICONS}" = "yes" ] && command -v pcmanfm >/dev/null 2>&1; then
        pcmanfm --desktop >/dev/null 2>&1 &
    fi
    if command -v mako >/dev/null 2>&1; then
        mako >/dev/null 2>&1 &
    fi
    if command -v waybar >/dev/null 2>&1; then
        waybar >/dev/null 2>&1 &
    fi
    if command -v udiskie >/dev/null 2>&1; then
        udiskie --config /etc/xdg/udiskie/config.yml --tray --notify --automount >/dev/null 2>&1 &
    fi
    if [ -x /usr/libexec/unicore-osd ]; then
        /usr/libexec/unicore-osd start-daemon >/dev/null 2>&1 &
    fi
    if command -v wl-paste >/dev/null 2>&1 && [ -x /usr/libexec/unicore-clip-store ]; then
        wl-paste --type text --watch /usr/libexec/unicore-clip-store >/dev/null 2>&1 &
    fi
    if [ -x /usr/libexec/unicore-power ]; then
        /usr/libexec/unicore-power apply-idle >/dev/null 2>&1 || true
    fi
    if [ -x /usr/libexec/unicore-update-check ]; then
        /usr/libexec/unicore-update-check --daemon >/dev/null 2>&1 &
    fi
    if [ -x /usr/libexec/unicore-phone ]; then
        /usr/libexec/unicore-phone autostart-hook >/dev/null 2>&1 &
    fi
    if [ -x /usr/libexec/unicore-cloud ]; then
        /usr/libexec/unicore-cloud autostart-hook >/dev/null 2>&1 &
    fi
fi

# Launch First-Boot OOBE Wizard on initial boot, or UniCore App & Security Center once configured
if [ -x /usr/bin/unicore-center ]; then
    if [ ! -f /data/unicore/oobe.done ]; then
        /usr/bin/unicore-center --oobe >/tmp/unicore-center.log 2>&1 &
    else
        /usr/bin/unicore-center >/tmp/unicore-center.log 2>&1 &
    fi
elif command -v foot >/dev/null 2>&1; then
    foot &
fi

# Health-gated A/B OTA boot confirmation (confirms slot ONLY after rootfs, /data, uniload, unicore-center & Wayland pass)
if [ -x /usr/libexec/unicore-boot-health ]; then
    /usr/libexec/unicore-boot-health confirm >/tmp/unicore-boot-confirm.log 2>&1 &
elif [ -r /mnt/unicore-boot.env ] && grep -q '^UNICORE_BOOT_MODE=installed$' /mnt/unicore-boot.env 2>/dev/null; then
    doas /usr/libexec/unicore-sys-helper confirm-boot >/tmp/unicore-boot-confirm.log 2>&1 &
fi
