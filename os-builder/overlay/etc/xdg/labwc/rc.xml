<?xml version="1.0"?>
<labwc_config>
  <core>
    <gap>6</gap>
    <adaptiveSync>no</adaptiveSync>
    <xwayland>yes</xwayland>
  </core>

  <theme>
    <name>UniCore-Dark</name>
    <cornerRadius>10</cornerRadius>
    <font name="Sans" size="10" />
  </theme>

  <snapping>
    <range>10</range>
    <overlay enabled="yes">
      <box>
        <inner borderWidth="2" color="#38bdf8" />
      </box>
    </overlay>
    <topMaximize>yes</topMaximize>
  </snapping>

  <windowSwitcher show="yes" preview="yes" outlines="yes" />

  <keyboard>
    <default />
    <keybind key="Super_L">
      <action name="Execute" command="pkill -x fuzzel || fuzzel" />
    </keybind>
    <keybind key="W-a">
      <action name="Execute" command="/usr/bin/unicore-center --ai" />
    </keybind>
    <keybind key="A-space">
      <action name="Execute" command="fuzzel" />
    </keybind>
    <keybind key="W-c">
      <action name="Execute" command="/usr/bin/unicore-center" />
    </keybind>
    <keybind key="W-e">
      <action name="Execute" command="pcmanfm /home/unicore" />
    </keybind>
    <keybind key="W-Return">
      <action name="Execute" command="foot" />
    </keybind>
    <keybind key="Print">
      <action name="Execute" command="/usr/bin/unicore-center --capture" />
    </keybind>
    <keybind key="W-S-r">
      <action name="Execute" command="/usr/bin/unicore-center --capture" />
    </keybind>
    <keybind key="W-S-s">
      <action name="Execute" command="/usr/libexec/unicore-screenshot --region" />
    </keybind>
    <keybind key="W-S-t">
      <action name="Execute" command="/usr/libexec/unicore-a11y speak en" />
    </keybind>
    <keybind key="W-l">
      <action name="Execute" command="/usr/libexec/unicore-lock" />
    </keybind>
    <keybind key="W-s">
      <action name="Execute" command="/usr/bin/unicore-center --tab settings" />
    </keybind>
    <keybind key="W-i">
      <action name="Execute" command="/usr/bin/unicore-center --tab settings" />
    </keybind>
    <keybind key="W-x">
      <action name="Execute" command="/usr/bin/unicore-center --power" />
    </keybind>
    <keybind key="W-w">
      <action name="Execute" command="/usr/bin/unicore-browser" />
    </keybind>
    <keybind key="W-v">
      <action name="Execute" command="/usr/libexec/unicore-clipboard" />
    </keybind>
    <keybind key="C-S-Escape">
      <action name="Execute" command="/usr/bin/unicore-center --taskmgr" />
    </keybind>
    <keybind key="W-Left">
      <action name="SnapToEdge" direction="left" />
    </keybind>
    <keybind key="W-Right">
      <action name="SnapToEdge" direction="right" />
    </keybind>
    <keybind key="W-Up">
      <action name="ToggleMaximize" />
    </keybind>
    <keybind key="W-Down">
      <action name="Iconify" />
    </keybind>
    <keybind key="W-d">
      <action name="ToggleShowDesktop" />
    </keybind>
    <keybind key="XF86AudioRaiseVolume">
      <action name="Execute" command="pactl set-sink-volume @DEFAULT_SINK@ +5%" />
    </keybind>
    <keybind key="XF86AudioLowerVolume">
      <action name="Execute" command="pactl set-sink-volume @DEFAULT_SINK@ -5%" />
    </keybind>
    <keybind key="XF86AudioMute">
      <action name="Execute" command="pactl set-sink-mute @DEFAULT_SINK@ toggle" />
    </keybind>
    <keybind key="XF86AudioMicMute">
      <action name="Execute" command="pactl set-source-mute @DEFAULT_SOURCE@ toggle" />
    </keybind>
    <keybind key="XF86MonBrightnessUp">
      <action name="Execute" command="brightnessctl -c backlight set +10%" />
    </keybind>
    <keybind key="XF86MonBrightnessDown">
      <action name="Execute" command="brightnessctl -c backlight set 10%-" />
    </keybind>
    <keybind key="A-F4">
      <action name="Close" />
    </keybind>
    <keybind key="A-Tab">
      <action name="NextWindow" />
    </keybind>
    <keybind key="W-q">
      <action name="Exit" />
    </keybind>
  </keyboard>

  <mouse>
    <default />
  </mouse>

  <libinput>
    <device category="touchpad">
      <naturalScroll>yes</naturalScroll>
      <tap>yes</tap>
      <tapButtonMap>lrm</tapButtonMap>
      <clickMethod>clickfinger</clickMethod>
      <disableWhileTyping>yes</disableWhileTyping>
      <middleEmulation>yes</middleEmulation>
    </device>
  </libinput>
</labwc_config>
