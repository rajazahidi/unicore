<?xml version="1.0" encoding="UTF-8"?>
<openbox_menu>
  <menu id="root-menu" label="UniCore Desktop">
    <item label="Start Menu (Applications)">
      <action name="Execute" command="/usr/libexec/unicore-toggle --start-menu" />
    </item>
    <item label="Computer Explorer (This PC)">
      <action name="Execute" command="pcmanfm /home/unicore" />
    </item>
    <item label="Web Browser">
      <action name="Execute" command="/usr/bin/unicore-browser" />
    </item>
    <item label="UniCore App Store">
      <action name="Execute" command="/usr/libexec/unicore-toggle --tab store" />
    </item>
    <separator />
    <item label="New Folder on Desktop">
      <action name="Execute" command="/usr/libexec/unicore-desktop-action new-folder" />
    </item>
    <item label="New Text Document">
      <action name="Execute" command="/usr/libexec/unicore-desktop-action new-file" />
    </item>
    <separator />
    <item label="Control Panel">
      <action name="Execute" command="/usr/bin/unicore-center --control-panel" />
    </item>
    <item label="Device Manager">
      <action name="Execute" command="/usr/bin/unicore-center --devmgr" />
    </item>
    <item label="Storage Manager">
      <action name="Execute" command="/usr/bin/unicore-center --storage" />
    </item>
    <item label="Region, Language &amp; Keyboard">
      <action name="Execute" command="/usr/bin/unicore-center --region" />
    </item>
    <item label="Display &amp; Multi-Monitor Settings">
      <action name="Execute" command="/usr/bin/unicore-center --tab settings:display" />
    </item>
    <item label="10 Desktop Themes Studio">
      <action name="Execute" command="/usr/bin/unicore-center --themes" />
    </item>
    <item label="AegisTunnel VPN (Anti-DPI &amp; PQ)">
      <action name="Execute" command="/usr/bin/unicore-center --vpn" />
    </item>
    <item label="ResonanceFX Equalizer &amp; Audio DSP">
      <action name="Execute" command="/usr/bin/unicore-center --equalizer" />
    </item>
    <item label="Screen Capture &amp; Recorder">
      <action name="Execute" command="/usr/libexec/unicore-toggle --capture" />
    </item>
    <item label="Emoji Picker (Super+.)">
      <action name="Execute" command="/usr/libexec/unicore-toggle --emoji" />
    </item>
    <separator />
    <item label="Open Terminal">
      <action name="Execute" command="foot" />
    </item>
    <item label="Task Manager">
      <action name="Execute" command="/usr/libexec/unicore-toggle --taskmgr" />
    </item>
    <item label="Power Options...">
      <action name="Execute" command="/usr/libexec/unicore-toggle --power" />
    </item>
  </menu>
</openbox_menu>
