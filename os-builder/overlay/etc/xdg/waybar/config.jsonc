{
  "layer": "top",
  "position": "bottom",
  "height": 42,
  "margin-bottom": 5,
  "margin-left": 10,
  "margin-right": 10,
  "spacing": 4,
  "modules-left": [],
  "modules-center": [
    "custom/start",
    "custom/files",
    "custom/browser",
    "custom/center",
    "wlr/taskbar"
  ],
  "modules-right": [
    "custom/rec",
    "custom/update",
    "tray",
    "network",
    "pulseaudio",
    "battery",
    "custom/ai",
    "custom/quick",
    "clock",
    "custom/power",
    "custom/desktop"
  ],
  "custom/start": {
    "format": "\uf00a",
    "tooltip-format": "Start Menu (Super)",
    "on-click": "/usr/libexec/unicore-toggle --start-menu"
  },
  "custom/files": {
    "format": "\uf07b",
    "tooltip-format": "Computer Explorer (Super+E)",
    "on-click": "pcmanfm /home/unicore &"
  },
  "custom/browser": {
    "format": "\uf0ac",
    "tooltip-format": "Web Browser (Super+W)",
    "on-click": "/usr/bin/unicore-browser &"
  },
  "custom/center": {
    "format": "\uf290",
    "tooltip-format": "UniCore App Store & Center (Super+C)",
    "on-click": "/usr/libexec/unicore-toggle --tab store"
  },
  "custom/taskmgr": {
    "format": "\uf080",
    "tooltip-format": "Task Manager (Ctrl+Shift+Esc)",
    "on-click": "/usr/libexec/unicore-toggle --taskmgr"
  },
  "wlr/taskbar": {
    "format": "{title:.13}",
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close",
    "all-outputs": true
  },
  "tray": {
    "icon-size": 16,
    "spacing": 6
  },
  "custom/rec": {
    "exec": "/usr/libexec/unicore-capture waybar-status",
    "return-type": "json",
    "interval": 3,
    "signal": 8,
    "on-click": "/usr/libexec/unicore-capture record-stop"
  },
  "custom/update": {
    "exec": "/usr/libexec/unicore-update-check --waybar",
    "return-type": "json",
    "interval": 300,
    "on-click": "/usr/bin/unicore-center --tab system &"
  },
  "network": {
    "format-wifi": "\uf1eb {signalStrength}%",
    "format-ethernet": "\uf108",
    "format-disconnected": "\uf127",
    "tooltip-format-wifi": "Wi-Fi: {essid} ({signalStrength}%) — Click for Network Settings",
    "tooltip-format-ethernet": "Wired Network ({ifname}) — Click for Network Settings",
    "tooltip-format-disconnected": "Offline — Click for Network Settings",
    "on-click": "/usr/bin/unicore-center --tab settings:wifi"
  },
  "pulseaudio": {
    "format": "\uf028 {volume}%",
    "format-muted": "\uf026",
    "tooltip-format": "Sound ({volume}%) — Click for Settings, Scroll for Volume, Right-click to Mute",
    "on-click": "/usr/bin/unicore-center --tab settings:audio",
    "on-click-right": "/usr/libexec/unicore-osd vol-mute",
    "on-scroll-up": "/usr/libexec/unicore-osd vol-up",
    "on-scroll-down": "/usr/libexec/unicore-osd vol-down"
  },
  "battery": {
    "format": "\uf240 {capacity}%",
    "tooltip-format": "Battery: {capacity}% — Click for Power Settings",
    "on-click": "/usr/bin/unicore-center --tab settings:power"
  },
  "custom/ai": {
    "format": "\uf0eb AI",
    "tooltip-format": "UniCore AI Assistant (Super+A)",
    "on-click": "/usr/libexec/unicore-toggle --ai"
  },
  "custom/quick": {
    "format": "\uf1de",
    "tooltip-format": "Quick Settings (Wi-Fi, Sound, Brightness, Theme, DND)",
    "on-click": "/usr/libexec/unicore-toggle --quick-settings"
  },
  "clock": {
    "format": "{:%H:%M\n%d/%m/%Y}",
    "tooltip-format": "{:%A, %d %B %Y}"
  },
  "custom/power": {
    "format": "\uf011",
    "tooltip-format": "Power Options (Super+X)",
    "on-click": "/usr/libexec/unicore-toggle --power"
  },
  "custom/desktop": {
    "format": " ",
    "tooltip-format": "Show Desktop (Super+D)",
    "on-click": "wlrctl toplevel minimize"
  }
}
