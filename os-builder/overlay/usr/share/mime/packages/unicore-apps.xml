<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/vnd.microsoft.portable-executable">
    <comment>Windows Executable Application</comment>
    <glob pattern="*.exe" weight="60"/>
    <magic priority="60">
      <match type="string" value="MZ" offset="0"/>
    </magic>
  </mime-type>
  <mime-type type="application/x-ms-dos-executable">
    <comment>MS-DOS Application / Batch</comment>
    <glob pattern="*.com" weight="60"/>
    <glob pattern="*.bat" weight="60"/>
  </mime-type>
  <mime-type type="application/x-msi">
    <comment>Windows Installer Package</comment>
    <glob pattern="*.msi" weight="60"/>
  </mime-type>
  <mime-type type="application/vnd.android.package-archive">
    <comment>Android Application Package</comment>
    <glob pattern="*.apk" weight="60"/>
  </mime-type>
</mime-info>
