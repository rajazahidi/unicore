[Desktop Entry]
Type=Application
Version=1.0
Name=Web Browser
Name[ms]=Pelayar Web
Comment=Open UniCore OS Default Web Browser (Epiphany / Firefox / Chromium)
Exec=/usr/bin/unicore-browser %U
Icon=web-browser
Terminal=false
Categories=Network;WebBrowser;
MimeType=x-scheme-handler/http;x-scheme-handler/https;text/html;application/xhtml+xml;
