#!/bin/sh
# UniCore OS Hardware & Boot Diagnostics Collector (Phase 15)
set -eu

export PATH="/sbin:/bin:/usr/sbin:/usr/bin"

if [ -d /home/unicore/Desktop ]; then
    OUT_FILE="/home/unicore/Desktop/unicore-diag.txt"
else
    OUT_FILE="/tmp/unicore-diag.txt"
fi

if [ "$#" -gt 0 ]; then
    case "$1" in
        --output)
            OUT_FILE="${2:-}"
            [ -n "${OUT_FILE}" ] || { echo "Usage: unicore-diag [--output <PATH>]" >&2; exit 2; }
            ;;
        -h|--help)
            echo "Usage: unicore-diag [--output <PATH>]"
            exit 0
            ;;
        *)
            echo "Unknown option: $1" >&2
            exit 2
            ;;
    esac
fi

mkdir -p "$(dirname "${OUT_FILE}")"

{
    echo "=== UniCore OS Hardware & System Diagnostics ==="
    echo "Generated: $(date -Iseconds 2>/dev/null || date)"
    echo ""
    echo "--- /etc/os-release ---"
    cat /etc/os-release 2>/dev/null || echo "N/A"
    echo ""
    echo "--- /mnt/unicore-boot.env ---"
    cat /mnt/unicore-boot.env 2>/dev/null || echo "N/A"
    echo ""
    echo "--- uname -a ---"
    uname -a 2>/dev/null || true
    echo ""
    echo "--- uniload hw-profile ---"
    /usr/bin/uniload hw-profile 2>/dev/null || echo "N/A"
    echo ""
    echo "--- free -m ---"
    free -m 2>/dev/null || true
    echo ""
    echo "--- /proc/swaps ---"
    cat /proc/swaps 2>/dev/null || true
    echo ""
    echo "--- lspci -nn ---"
    lspci -nn 2>/dev/null || echo "lspci unavailable"
    echo ""
    echo "--- Network Interfaces ---"
    ip -br addr 2>/dev/null || true
    nmcli general status 2>/dev/null || true
    echo ""
    echo "--- Audio (pactl info) ---"
    pactl info 2>/dev/null || echo "PipeWire session inactive in current shell"
    echo ""
    echo "--- Recent Kernel Warnings/Errors/Firmware (dmesg) ---"
    dmesg 2>/dev/null | grep -iE 'error|fail|warn|firmware' | tail -n 40 || true
} > "${OUT_FILE}"

printf '%s\n' "${OUT_FILE}"
