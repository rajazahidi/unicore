#!/bin/sh
# UniCore OS Phone Link Helper (KDE Connect + scrcpy Android Screen Mirror + ADB)
set -eu

USER_HOME="${HOME:-/home/unicore}"
CONF_DIR="${UNICORE_PHONE_CONF_DIR:-${USER_HOME}/.config/unicore}"
CONF_FILE="${CONF_DIR}/phone.conf"

find_kdeconnectd() {
    for p in /usr/libexec/kdeconnectd /usr/lib/libexec/kdeconnectd /usr/lib/kdeconnectd /usr/bin/kdeconnectd; do
        if [ -x "${p}" ]; then
            printf '%s\n' "${p}"
            return 0
        fi
    done
    command -v kdeconnectd 2>/dev/null || return 1
}

read_autostart() {
    if [ -r "${CONF_FILE}" ]; then
        awk -F= '$1=="KDECONNECT_AUTOSTART"{print $2; exit}' "${CONF_FILE}" 2>/dev/null | grep -Eq '^(1|yes|true)$' && echo 1 && return 0
    fi
    echo 0
}

save_autostart() {
    val="$1"
    mkdir -p "${CONF_DIR}"
    printf 'KDECONNECT_AUTOSTART=%s\n' "${val}" > "${CONF_FILE}"
}

is_kde_running() {
    pgrep -f '[k]deconnectd' >/dev/null 2>&1
}

is_safe_id() {
    printf '%s' "$1" | grep -Eq '^[A-Za-z0-9._:-]{1,96}$'
}

start_kdeconnectd() {
    daemon="$(find_kdeconnectd || true)"
    if [ -z "${daemon}" ]; then
        echo "kdeconnectd not installed" >&2
        return 1
    fi
    if ! is_kde_running; then
        nohup "${daemon}" >/tmp/unicore-kdeconnectd.log 2>&1 </dev/null &
        sleep 1
    fi
}

stop_kdeconnectd() {
    pkill -f '[k]deconnectd' >/dev/null 2>&1 || true
}

list_kde_devices() {
    command -v kdeconnect-cli >/dev/null 2>&1 || return 0
    is_kde_running || return 0
    # Format: "- Pixel 7: abcdef123456 (paired and reachable)"
    kdeconnect-cli -l 2>/dev/null | awk '
        /^- / {
            line = substr($0, 3)
            idx = index(line, ": ")
            if (idx > 0) {
                name = substr(line, 1, idx - 1)
                rest = substr(line, idx + 2)
                sp = index(rest, " ")
                id = (sp > 0) ? substr(rest, 1, sp - 1) : rest
                state = (sp > 0) ? substr(rest, sp + 1) : ""
                paired = (index(state, "paired") > 0 && index(state, "unpaired") == 0) ? 1 : 0
                reach = (index(state, "reachable") > 0 && index(state, "unreachable") == 0) ? 1 : 0
                gsub(/[|;]/, " ", name)
                if (out != "") out = out ";"
                out = out id "|" name "|" paired "|" reach
            }
        }
        END { print out }
    '
}

list_adb_devices() {
    command -v adb >/dev/null 2>&1 || return 0
    adb devices 2>/dev/null | awk '
        NR > 1 && $2 == "device" {
            if (out != "") out = out ","
            out = out $1
        }
        END { print out }
    '
}

cmd="${1:-status}"
shift || true

case "${cmd}" in
    status)
        kde_inst=0
        if [ -n "$(find_kdeconnectd || true)" ] && command -v kdeconnect-cli >/dev/null 2>&1; then
            kde_inst=1
        fi
        kde_run=0
        is_kde_running && kde_run=1
        kde_auto="$(read_autostart)"
        scrcpy_inst=0
        command -v scrcpy >/dev/null 2>&1 && scrcpy_inst=1
        adb_inst=0
        command -v adb >/dev/null 2>&1 && adb_inst=1
        kde_devs="$(list_kde_devices || true)"
        adb_devs="$(list_adb_devices || true)"
        printf 'kdeconnect_installed=%s\nkdeconnect_running=%s\nkdeconnect_autostart=%s\nscrcpy_installed=%s\nadb_installed=%s\nkde_devices=%s\nadb_devices=%s\n' \
            "${kde_inst}" "${kde_run}" "${kde_auto}" "${scrcpy_inst}" "${adb_inst}" "${kde_devs}" "${adb_devs}"
        ;;
    start)
        start_kdeconnectd
        echo "started"
        ;;
    stop)
        stop_kdeconnectd
        echo "stopped"
        ;;
    set-autostart)
        val="${1:-0}"
        case "${val}" in
            1|yes|true|on) save_autostart 1 ;;
            0|no|false|off) save_autostart 0 ;;
            *) echo "Invalid autostart value: ${val}" >&2; exit 2 ;;
        esac
        echo "autostart=$(read_autostart)"
        ;;
    autostart-hook)
        [ "${UNICORE_LIGHTWEIGHT_SHELL:-0}" = "1" ] && exit 0
        if [ "$(read_autostart)" = "1" ]; then
            start_kdeconnectd >/dev/null 2>&1 || true
        fi
        ;;
    refresh)
        start_kdeconnectd
        kdeconnect-cli --refresh >/dev/null 2>&1 || true
        echo "refreshed"
        ;;
    pair)
        dev_id="${1:-}"
        is_safe_id "${dev_id}" || { echo "Invalid device ID" >&2; exit 2; }
        start_kdeconnectd
        exec kdeconnect-cli -d "${dev_id}" --pair
        ;;
    unpair)
        dev_id="${1:-}"
        is_safe_id "${dev_id}" || { echo "Invalid device ID" >&2; exit 2; }
        exec kdeconnect-cli -d "${dev_id}" --unpair
        ;;
    ping)
        dev_id="${1:-}"
        is_safe_id "${dev_id}" || { echo "Invalid device ID" >&2; exit 2; }
        exec kdeconnect-cli -d "${dev_id}" --ping-msg "Hello from UniCore OS!"
        ;;
    ring)
        dev_id="${1:-}"
        is_safe_id "${dev_id}" || { echo "Invalid device ID" >&2; exit 2; }
        exec kdeconnect-cli -d "${dev_id}" --ring
        ;;
    send-file)
        dev_id="${1:-}"
        fpath="${2:-}"
        is_safe_id "${dev_id}" || { echo "Invalid device ID" >&2; exit 2; }
        [ -f "${fpath}" ] || { echo "File not found: ${fpath}" >&2; exit 1; }
        exec kdeconnect-cli -d "${dev_id}" --share "${fpath}"
        ;;
    open-kde-settings)
        start_kdeconnectd >/dev/null 2>&1 || true
        if command -v kdeconnect-app >/dev/null 2>&1; then
            nohup kdeconnect-app >/tmp/unicore-kdeconnect-app.log 2>&1 </dev/null &
        elif command -v kdeconnect-settings >/dev/null 2>&1; then
            nohup kdeconnect-settings >/tmp/unicore-kdeconnect-app.log 2>&1 </dev/null &
        else
            echo "KDE Connect GUI not installed" >&2
            exit 1
        fi
        ;;
    mirror)
        command -v scrcpy >/dev/null 2>&1 || { echo "scrcpy not installed" >&2; exit 1; }
        serial=""
        screen_off=0
        while [ "$#" -gt 0 ]; do
            case "$1" in
                --screen-off) screen_off=1 ;;
                *)
                    is_safe_id "$1" || { echo "Invalid ADB serial: $1" >&2; exit 2; }
                    serial="$1"
                    ;;
            esac
            shift
        done
        set -- scrcpy --window-title "UniCore Phone Mirror" --stay-awake
        [ "${screen_off}" -eq 1 ] && set -- "$@" --turn-screen-off
        [ -n "${serial}" ] && set -- "$@" -s "${serial}"
        nohup "$@" >/tmp/unicore-scrcpy.log 2>&1 </dev/null &
        echo "mirror_started"
        ;;
    adb-wifi)
        target="${1:-}"
        printf '%s' "${target}" | grep -Eq '^[0-9]{1,3}(\.[0-9]{1,3}){3}:[0-9]{2,5}$' || {
            echo "Invalid IP:PORT (example: 192.168.1.45:5555)" >&2
            exit 2
        }
        command -v adb >/dev/null 2>&1 || { echo "adb not installed" >&2; exit 1; }
        exec adb connect "${target}"
        ;;
    *)
        echo "Usage: unicore-phone <status|start|stop|set-autostart <0|1>|autostart-hook|refresh|pair|unpair|ping|ring|send-file|open-kde-settings|mirror|adb-wifi>" >&2
        exit 2
        ;;
esac
