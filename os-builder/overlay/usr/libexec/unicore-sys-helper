#!/bin/sh
set -eu

if [ "$#" -lt 1 ] || [ "$#" -gt 6 ]; then
    echo "Usage: unicore-sys-helper <poweroff|reboot|suspend|bt-start|bt-stop|cups-start|cups-stop|printer-discover|printer-add|printer-remove|printer-default|fw-status|fw-set|backup-targets|backup-create|backup-restore|user-list|user-add|user-delete|user-passwd|auth-user|power-status|power-profile|power-idle|smart-health|set-cpu-governor|install-disk|apply-oobe|set-user-password|update-*|sb-*|browser-*|migrate-scan|migrate-inspect|migrate-import|hw-status|hw-set-gpu|hw-set-wifi-ps|hw-reset-audio-bt|hw-fw-check|hw-fw-update|parental-status|parental-set|parental-reset-usage>" >&2
    exit 2
fi

is_safe_https_url() {
    printf '%s' "$1" | grep -Eq '^https://[^[:space:]"'\''$`\\;<>|&]+$'
}

is_safe_printer_name() {
    printf '%s' "$1" | grep -Eq '^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$'
}

is_safe_printer_uri() {
    printf '%s' "$1" | grep -Eq '^(ipp|ipps|usb|socket|lpd|http|https|dnssd)://[^[:space:]"'\''$`\\;<>|&]+$'
}

is_safe_abs_path() {
    case "$1" in
        /*)
            case "$1" in
                *..*) return 1 ;;
            esac
            ! printf '%s' "$1" | grep -Eq '[[:cntrl:]"'\''$`\\;<>|&]'
            ;;
        *) return 1 ;;
    esac
}

case "$1" in
    poweroff)
        [ "$#" -eq 1 ] || exit 2
        exec /sbin/poweroff
        ;;
    reboot)
        [ "$#" -eq 1 ] || exit 2
        exec /sbin/reboot
        ;;
    suspend)
        [ "$#" -eq 1 ] || exit 2
        if [ -w /sys/power/state ]; then
            printf 'mem' > /sys/power/state
        else
            echo "Suspend is not supported by this hardware or VM firmware" >&2
            exit 1
        fi
        ;;
    bt-start)
        [ "$#" -eq 1 ] || exit 2
        HAS_BT=0
        for dev in /sys/class/bluetooth/hci*; do
            if [ -e "${dev}" ]; then
                HAS_BT=1
                break
            fi
        done
        if [ "${HAS_BT}" -ne 1 ]; then
            echo "No Bluetooth adapter detected in /sys/class/bluetooth" >&2
            exit 1
        fi
        exec /etc/init.d/bluetooth start
        ;;
    bt-stop)
        [ "$#" -eq 1 ] || exit 2
        if [ -x /etc/init.d/bluetooth ]; then
            exec /etc/init.d/bluetooth stop
        fi
        exit 0
        ;;
    cups-start)
        [ "$#" -eq 1 ] || exit 2
        mkdir -p /data/cups /var/spool/cups/tmp /var/cache/cups /run/cups/certs
        chmod 0755 /data/cups
        if [ ! -f /data/cups/cupsd.conf ] && [ -d /usr/share/unicore/cups-defaults ]; then
            cp -a /usr/share/unicore/cups-defaults/. /data/cups/ 2>/dev/null || true
        fi
        if [ -f /data/cups/cups-files.conf ]; then
            if grep -q '^SystemGroup ' /data/cups/cups-files.conf; then
                sed -i 's/^SystemGroup .*/SystemGroup root wheel lpadmin/' /data/cups/cups-files.conf
            else
                printf '\nSystemGroup root wheel lpadmin\n' >> /data/cups/cups-files.conf
            fi
        fi
        addgroup root lpadmin >/dev/null 2>&1 || true
        if [ ! -L /etc/cups ]; then
            rm -rf /etc/cups
            ln -s /data/cups /etc/cups
        fi
        if [ -x /etc/init.d/cupsd ]; then
            exec /etc/init.d/cupsd start
        elif [ -x /etc/init.d/cups ]; then
            exec /etc/init.d/cups start
        else
            echo "CUPS service script not found" >&2
            exit 1
        fi
        ;;
    cups-stop)
        [ "$#" -eq 1 ] || exit 2
        if [ -x /etc/init.d/cupsd ]; then
            exec /etc/init.d/cupsd stop
        elif [ -x /etc/init.d/cups ]; then
            exec /etc/init.d/cups stop
        fi
        exit 0
        ;;
    printer-discover)
        [ "$#" -eq 1 ] || exit 2
        if [ -x /usr/sbin/lpinfo ]; then
            exec /usr/sbin/lpinfo -v
        fi
        exec lpinfo -v
        ;;
    printer-add)
        [ "$#" -eq 3 ] || [ "$#" -eq 4 ] || exit 2
        is_safe_printer_name "$2" || { echo "Denied invalid printer name: $2" >&2; exit 1; }
        is_safe_printer_uri "$3" || { echo "Denied invalid printer URI: $3" >&2; exit 1; }
        drv="${4:-everywhere}"
        case "${drv}" in
            everywhere)
                exec lpadmin -p "$2" -E -v "$3" -m everywhere
                ;;
            raw)
                exec lpadmin -p "$2" -E -v "$3"
                ;;
            *)
                echo "Denied unsupported printer driver mode: ${drv}" >&2
                exit 2
                ;;
        esac
        ;;
    printer-remove)
        [ "$#" -eq 2 ] || exit 2
        is_safe_printer_name "$2" || { echo "Denied invalid printer name: $2" >&2; exit 1; }
        exec lpadmin -x "$2"
        ;;
    printer-default)
        [ "$#" -eq 2 ] || exit 2
        is_safe_printer_name "$2" || { echo "Denied invalid printer name: $2" >&2; exit 1; }
        exec lpadmin -d "$2"
        ;;
    fw-status)
        [ "$#" -eq 1 ] || exit 2
        exec /usr/libexec/unicore-firewall status
        ;;
    fw-set)
        [ "$#" -ge 2 ] && [ "$#" -le 4 ] || exit 2
        case "$2" in
            on|off|1|0) ;;
            *) echo "Denied invalid firewall flag: $2" >&2; exit 2 ;;
        esac
        if [ "$#" -ge 3 ]; then
            case "$3" in
                home|public) ;;
                *) echo "Denied invalid firewall profile: $3" >&2; exit 2 ;;
            esac
        fi
        if [ "$#" -ge 4 ]; then
            case "$4" in
                0|1) ;;
                *) echo "Denied invalid firewall ssh flag: $4" >&2; exit 2 ;;
            esac
        fi
        shift
        exec /usr/libexec/unicore-firewall set "$@"
        ;;
    backup-targets)
        [ "$#" -eq 1 ] || exit 2
        exec /usr/libexec/unicore-backup list-targets
        ;;
    backup-create)
        [ "$#" -eq 2 ] || [ "$#" -eq 3 ] || exit 2
        is_safe_abs_path "$2" || { echo "Denied unsafe backup target dir: $2" >&2; exit 1; }
        if [ "$#" -eq 3 ]; then
            [ "$3" = "encrypted" ] || { echo "Denied unknown backup mode: $3" >&2; exit 2; }
            exec /usr/libexec/unicore-backup create "$2" encrypted
        fi
        exec /usr/libexec/unicore-backup create "$2"
        ;;
    backup-restore)
        [ "$#" -eq 2 ] || [ "$#" -eq 3 ] || exit 2
        is_safe_abs_path "$2" || { echo "Denied unsafe backup archive path: $2" >&2; exit 1; }
        if [ "$#" -eq 3 ]; then
            [ "$3" = "encrypted" ] || { echo "Denied unknown restore mode: $3" >&2; exit 2; }
            exec /usr/libexec/unicore-backup restore "$2" encrypted
        fi
        exec /usr/libexec/unicore-backup restore "$2"
        ;;
    user-list)
        [ "$#" -eq 1 ] || exit 2
        exec /usr/libexec/unicore-users list
        ;;
    user-add)
        [ "$#" -eq 2 ] || [ "$#" -eq 3 ] || exit 2
        role="${3:-standard}"
        exec /usr/libexec/unicore-users add "$2" "${role}"
        ;;
    user-delete)
        [ "$#" -eq 2 ] || exit 2
        exec /usr/libexec/unicore-users delete "$2"
        ;;
    user-passwd)
        [ "$#" -eq 2 ] || exit 2
        exec /usr/libexec/unicore-users passwd "$2"
        ;;
    auth-user)
        [ "$#" -eq 2 ] || exit 2
        exec /usr/libexec/unicore-users auth "$2"
        ;;
    power-status)
        [ "$#" -eq 1 ] || exit 2
        exec /usr/libexec/unicore-power status
        ;;
    power-profile)
        [ "$#" -eq 2 ] || exit 2
        exec /usr/libexec/unicore-power set-profile "$2"
        ;;
    power-idle)
        [ "$#" -eq 4 ] || exit 2
        exec /usr/libexec/unicore-power set-idle "$2" "$3" "$4"
        ;;
    smart-health)
        [ "$#" -le 2 ] || exit 2
        if [ "$#" -eq 2 ]; then
            exec /usr/libexec/unicore-smart health "$2"
        fi
        exec /usr/libexec/unicore-smart health
        ;;
    install-disk)
        [ "$#" -eq 2 ] || exit 2
        if ! printf '%s' "$2" | grep -Eq '^/dev/(sd[a-z]|hd[a-z]|vd[a-z]|nvme[0-9]+n[0-9]+|mmcblk[0-9]+)$'; then
            echo "Denied invalid install disk path: $2" >&2
            exit 1
        fi
        exec /usr/sbin/unicore-install --disk "$2" --mode wipe --yes-wipe
        ;;
    install-disk-alongside)
        [ "$#" -eq 2 ] || exit 2
        if ! printf '%s' "$2" | grep -Eq '^/dev/(sd[a-z]|hd[a-z]|vd[a-z]|nvme[0-9]+n[0-9]+|mmcblk[0-9]+)$'; then
            echo "Denied invalid install disk path: $2" >&2
            exit 1
        fi
        exec /usr/sbin/unicore-install --disk "$2" --mode alongside --yes-install
        ;;
    install-disk-encrypted|install-disk-alongside-encrypted)
        [ "$#" -eq 2 ] || exit 2
        if ! printf '%s' "$2" | grep -Eq '^/dev/(sd[a-z]|hd[a-z]|vd[a-z]|nvme[0-9]+n[0-9]+|mmcblk[0-9]+)$'; then
            echo "Denied invalid install disk path: $2" >&2
            exit 1
        fi
        mode_arg="wipe"
        [ "$1" = "install-disk-alongside-encrypted" ] && mode_arg="alongside"
        PASS_TMP="$(umask 077 && mktemp /tmp/.unicore-luks.XXXXXX)"
        cleanup_pass() { rm -f "${PASS_TMP}"; }
        trap cleanup_pass EXIT
        IFS= read -r pass_val || pass_val=""
        if [ "${#pass_val}" -lt 8 ]; then
            echo "Denied LUKS passphrase: minimum 8 characters required." >&2
            exit 1
        fi
        printf '%s' "${pass_val}" > "${PASS_TMP}"
        unset pass_val
        /usr/sbin/unicore-install --disk "$2" --mode "${mode_arg}" --yes-wipe --encrypt-data --passphrase-file "${PASS_TMP}"
        ;;
    apply-oobe)
        [ "$#" -eq 3 ] || exit 2
        tz="$2"
        host="$3"
        case "${tz}" in
            *..*) echo "Denied invalid timezone: ${tz}" >&2; exit 1 ;;
        esac
        if ! printf '%s' "${tz}" | grep -Eq '^[A-Za-z0-9_/+.-]+$'; then
            echo "Denied invalid timezone: ${tz}" >&2
            exit 1
        fi
        if ! printf '%s' "${host}" | grep -Eq '^[A-Za-z0-9][A-Za-z0-9-]{0,31}$'; then
            echo "Denied invalid hostname: ${host}" >&2
            exit 1
        fi
        printf '%s\n' "${host}" > /etc/hostname
        hostname "${host}" 2>/dev/null || true
        printf '%s\n' "${tz}" > /etc/timezone
        if [ -f "/usr/share/zoneinfo/${tz}" ]; then
            ln -snf "/usr/share/zoneinfo/${tz}" /etc/localtime
        fi
        ;;
    set-timezone)
        [ "$#" -eq 2 ] || exit 2
        tz="$2"
        case "${tz}" in
            *..*) echo "Denied invalid timezone: ${tz}" >&2; exit 1 ;;
        esac
        if ! printf '%s' "${tz}" | grep -Eq '^[A-Za-z0-9_/+.-]+$'; then
            echo "Denied invalid timezone: ${tz}" >&2
            exit 1
        fi
        printf '%s\n' "${tz}" > /etc/timezone
        if [ -f "/usr/share/zoneinfo/${tz}" ]; then
            ln -snf "/usr/share/zoneinfo/${tz}" /etc/localtime
        fi
        echo "timezone=${tz}"
        ;;
    storage-eject)
        [ "$#" -eq 2 ] || exit 2
        exec /usr/libexec/unicore-storage eject "$2"
        ;;
    aegis-start)
        exec /usr/libexec/unicore-aegis-ctl start
        ;;
    aegis-stop)
        exec /usr/libexec/unicore-aegis-ctl stop
        ;;
    aegis-rotate-pq)
        exec /usr/libexec/unicore-aegis-ctl rotate-pq
        ;;
    aegis-save-config)
        mkdir -p /data/network
        chmod 0700 /data/network 2>/dev/null || true
        TMP_AEGIS="$(umask 077 && mktemp /data/network/.aegis-vpn.XXXXXX)"
        cat > "${TMP_AEGIS}"
        chmod 0600 "${TMP_AEGIS}"
        mv -f "${TMP_AEGIS}" /data/network/aegis-vpn.json
        echo "Saved /data/network/aegis-vpn.json (chmod 600)"
        ;;
    set-user-password)
        [ "$#" -eq 1 ] || exit 2
        IFS= read -r user_pass || user_pass=""
        if [ "${#user_pass}" -lt 4 ] || printf '%s' "${user_pass}" | grep -Eq '[[:cntrl:]:]'; then
            echo "Invalid password (min 4 chars, no colons or control chars)." >&2
            exit 1
        fi
        printf 'unicore:%s\n' "${user_pass}" | chpasswd
        unset user_pass
        ;;
    update-status)
        [ "$#" -eq 1 ] || exit 2
        exec /usr/sbin/unicore-update --status
        ;;
    update-check)
        [ "$#" -le 2 ] || exit 2
        if [ "$#" -eq 2 ]; then
            is_safe_https_url "$2" || { echo "Denied invalid update URL: $2" >&2; exit 1; }
            exec /usr/sbin/unicore-update --check --url "$2"
        fi
        exec /usr/sbin/unicore-update --check
        ;;
    update-apply-url)
        [ "$#" -eq 2 ] || exit 2
        is_safe_https_url "$2" || { echo "Denied invalid update URL: $2" >&2; exit 1; }
        exec /usr/sbin/unicore-update --apply-url "$2"
        ;;
    update-apply-local)
        [ "$#" -ge 2 ] && [ "$#" -le 3 ] || exit 2
        is_safe_abs_path "$2" || { echo "Denied unsafe local update path: $2" >&2; exit 1; }
        if [ "$#" -eq 3 ]; then
            [ "$3" = "allow-unsigned" ] || { echo "Denied unknown flag: $3" >&2; exit 2; }
            exec /usr/sbin/unicore-update --apply-local "$2" --allow-unsigned
        fi
        exec /usr/sbin/unicore-update --apply-local "$2"
        ;;
    update-rollback)
        [ "$#" -eq 1 ] || exit 2
        exec /usr/sbin/unicore-update --rollback
        ;;
    confirm-boot)
        [ "$#" -eq 1 ] || exit 2
        exec /usr/sbin/unicore-update --confirm-boot
        ;;
    sb-status)
        [ "$#" -eq 1 ] || exit 2
        exec /usr/libexec/unicore-secureboot status
        ;;
    sb-enroll)
        [ "$#" -eq 1 ] || exit 2
        exec /usr/libexec/unicore-secureboot enroll
        ;;
    browser-install)
        [ "$#" -eq 2 ] || exit 2
        case "$2" in
            firefox|chromium) exec /usr/libexec/unicore-browser-mgr install "$2" ;;
            *) echo "Denied unsupported browser: $2" >&2; exit 2 ;;
        esac
        ;;
    browser-remove)
        [ "$#" -eq 2 ] || exit 2
        case "$2" in
            firefox|chromium) exec /usr/libexec/unicore-browser-mgr remove "$2" ;;
            *) echo "Denied unsupported browser: $2" >&2; exit 2 ;;
        esac
        ;;
    migrate-scan)
        [ "$#" -eq 1 ] || exit 2
        exec /usr/libexec/unicore-migrate scan
        ;;
    migrate-inspect)
        [ "$#" -eq 2 ] || exit 2
        if ! printf '%s' "$2" | grep -Eq '^/dev/(sd[a-z][0-9]+|hd[a-z][0-9]+|vd[a-z][0-9]+|nvme[0-9]+n[0-9]+p[0-9]+|mmcblk[0-9]+p[0-9]+)$'; then
            echo "Denied invalid Windows partition device: $2" >&2
            exit 1
        fi
        exec /usr/libexec/unicore-migrate inspect "$2"
        ;;
    migrate-import)
        [ "$#" -eq 4 ] || exit 2
        if ! printf '%s' "$2" | grep -Eq '^/dev/(sd[a-z][0-9]+|hd[a-z][0-9]+|vd[a-z][0-9]+|nvme[0-9]+n[0-9]+p[0-9]+|mmcblk[0-9]+p[0-9]+)$'; then
            echo "Denied invalid Windows partition device: $2" >&2
            exit 1
        fi
        if ! printf '%s' "$3" | grep -Eq '^[A-Za-z0-9 ._()-]{1,64}$' || printf '%s' "$3" | grep -q '\.\.'; then
            echo "Denied invalid Windows username: $3" >&2
            exit 1
        fi
        if ! printf '%s' "$4" | grep -Eq '^[a-z,]+$'; then
            echo "Denied invalid migration item flags: $4" >&2
            exit 1
        fi
        exec /usr/libexec/unicore-migrate import "$2" "$3" "$4"
        ;;
    hw-status)
        [ "$#" -eq 1 ] || exit 2
        exec /usr/libexec/unicore-hw-mgr status
        ;;
    hw-set-gpu)
        [ "$#" -eq 2 ] || exit 2
        case "$2" in
            auto|hw|safe|prime-dgpu) exec /usr/libexec/unicore-hw-mgr set-gpu "$2" ;;
            *) echo "Denied invalid GPU mode: $2" >&2; exit 2 ;;
        esac
        ;;
    hw-set-wifi-ps)
        [ "$#" -eq 2 ] || exit 2
        case "$2" in
            on|off) exec /usr/libexec/unicore-hw-mgr set-wifi-ps "$2" ;;
            *) echo "Denied invalid Wi-Fi power-save flag: $2" >&2; exit 2 ;;
        esac
        ;;
    hw-set-nvidia-gsp)
        [ "$#" -eq 2 ] || exit 2
        case "$2" in
            on|off) exec /usr/libexec/unicore-hw-mgr set-nvidia-gsp "$2" ;;
            *) echo "Denied invalid NVIDIA GSP flag: $2" >&2; exit 2 ;;
        esac
        ;;
    hw-reset-audio-bt)
        [ "$#" -eq 1 ] || exit 2
        exec /usr/libexec/unicore-hw-mgr reset-audio-bt
        ;;
    hw-fw-check)
        [ "$#" -eq 1 ] || exit 2
        exec /usr/libexec/unicore-hw-mgr fw-check
        ;;
    hw-fw-update)
        [ "$#" -eq 1 ] || exit 2
        exec /usr/libexec/unicore-hw-mgr fw-update
        ;;
    parental-status)
        [ "$#" -eq 1 ] || exit 2
        exec /usr/libexec/unicore-parental status
        ;;
    parental-set)
        [ "$#" -ge 5 ] && [ "$#" -le 6 ] || exit 2
        case "$2" in 0|1) ;; *) echo "Denied invalid parental enabled flag: $2" >&2; exit 2 ;; esac
        case "$3" in off|malware|family) ;; *) echo "Denied invalid DNS filter: $3" >&2; exit 2 ;; esac
        printf '%s' "$4" | grep -Eq '^[0-9]{1,4}$' || { echo "Denied invalid daily limit: $4" >&2; exit 2; }
        case "$5" in
            off) ;;
            *) printf '%s' "$5" | grep -Eq '^[0-2][0-9]:[0-5][0-9]-[0-2][0-9]:[0-5][0-9]$' || { echo "Denied invalid bedtime: $5" >&2; exit 2; } ;;
        esac
        blk="${6:-}"
        if [ -n "${blk}" ] && ! printf '%s' "${blk}" | grep -Eq '^[A-Za-z0-9:_,.-]{1,512}$'; then
            echo "Denied invalid blocked app list: ${blk}" >&2
            exit 2
        fi
        exec /usr/libexec/unicore-parental set "$2" "$3" "$4" "$5" "${blk}"
        ;;
    parental-reset-usage)
        [ "$#" -eq 1 ] || exit 2
        exec /usr/libexec/unicore-parental reset-usage
        ;;
    android-init)
        [ "$#" -eq 2 ] || exit 2
        case "$2" in
            vanilla|microg|gapps) ;;
            *) echo "Denied invalid Android profile: $2" >&2; exit 2 ;;
        esac
        exec /usr/libexec/uniload-art init --profile "$2"
        ;;
    android-setup-arm)
        [ "$#" -eq 1 ] || exit 2
        exec /usr/libexec/uniload-art setup-arm
        ;;
    android-gsf-id)
        [ "$#" -eq 1 ] || exit 2
        exec /usr/libexec/uniload-art gsf-id
        ;;
    android-restart)
        [ "$#" -eq 1 ] || exit 2
        exec /usr/libexec/uniload-art restart
        ;;
    android-install-aurora)
        [ "$#" -eq 1 ] || exit 2
        exec /usr/libexec/uniload-art install-aurora
        ;;
    set-cpu-governor)
        [ "$#" -eq 2 ] || exit 2
        target_gov="$2"
        case "${target_gov}" in
            performance|schedutil|powersave) ;;
            *)
                echo "Denied invalid CPU governor: ${target_gov}" >&2
                exit 2
                ;;
        esac
        updated=0
        for gov_file in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
            [ -w "${gov_file}" ] || continue
            avail_file="$(dirname "${gov_file}")/scaling_available_governors"
            chosen="${target_gov}"
            if [ "${chosen}" = "schedutil" ] && [ -r "${avail_file}" ]; then
                if ! grep -qw 'schedutil' "${avail_file}" 2>/dev/null; then
                    if grep -qw 'ondemand' "${avail_file}" 2>/dev/null; then
                        chosen="ondemand"
                    elif grep -qw 'powersave' "${avail_file}" 2>/dev/null; then
                        chosen="powersave"
                    fi
                fi
            fi
            if printf '%s' "${chosen}" > "${gov_file}" 2>/dev/null; then
                updated=$((updated + 1))
            fi
        done
        if [ "${updated}" -eq 0 ]; then
            echo "cpufreq scaling not exposed on this VM/CPU; Game Mode flag saved."
        else
            echo "Applied CPU governor '${target_gov}' to ${updated} core(s)."
        fi
        ;;
    *)
        echo "Denied power/hardware action: $1" >&2
        exit 1
        ;;
esac
