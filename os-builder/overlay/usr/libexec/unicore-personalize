#!/bin/sh
# UniCore OS v1.3.0 — 10-Theme Desktop Environment & Personalization Manager
set -eu

default_conf_path() {
    if [ -n "${UNICORE_PERSONALIZE_CONF:-}" ]; then
        printf '%s\n' "${UNICORE_PERSONALIZE_CONF}"
    elif [ -d /data/home ]; then
        printf '/data/home/.config/unicore/personalize.conf\n'
    else
        printf '%s/.config/unicore/personalize.conf\n' "${HOME:-/home/unicore}"
    fi
}

CONF_PATH="$(default_conf_path)"
UNICORE_THEME_PRESET="midnight"
UNICORE_THEME="dark"
UNICORE_WALLPAPER="/usr/share/unicore/wallpaper.png"
UNICORE_KB_LAYOUT="us"
UNICORE_NATURAL_SCROLL="yes"
UNICORE_TAP_TO_CLICK="yes"
UNICORE_POINTER_SPEED="0.0"
UNICORE_DESKTOP_ICONS="yes"
UNICORE_TASKBAR_STYLE="floating"
UNICORE_LAYOUT="win11"
UNICORE_ACCENT_COLOR="blue"
UNICORE_HIGH_CONTRAST="no"
UNICORE_LARGE_TEXT="no"

validate_preset() {
    case "$1" in
        midnight|daylight|aurora|nordic|dracula|emerald|sunset|sakura|cyberpunk|classic98)
            printf '%s\n' "$1"
            ;;
        *) return 1 ;;
    esac
}

validate_theme() {
    case "$1" in
        dark|light) printf '%s\n' "$1" ;;
        *) return 1 ;;
    esac
}

validate_taskbar_style() {
    case "$1" in
        docked|floating) printf '%s\n' "$1" ;;
        *) return 1 ;;
    esac
}

validate_layout() {
    case "$1" in
        win11|win10|macos) printf '%s\n' "$1" ;;
        *) return 1 ;;
    esac
}

validate_accent() {
    case "$1" in
        blue|purple|green|amber|rose) printf '%s\n' "$1" ;;
        *) return 1 ;;
    esac
}

validate_bool_yn() {
    case "$1" in
        yes|1|true|on) printf 'yes\n' ;;
        no|0|false|off) printf 'no\n' ;;
        *) return 1 ;;
    esac
}

validate_kb_layout() {
    case "$1" in
        us|my|gb|de|fr|jp) printf '%s\n' "$1" ;;
        *) return 1 ;;
    esac
}

validate_wallpaper() {
    wp="$1"
    case "${wp}" in
        /*) ;;
        *) return 1 ;;
    esac
    case "${wp}" in
        *..*|*\"*|*\'*|*\$*|*\`*|*\\*|*\;*|*\<*|*\>*|*\|*|*\&*) return 1 ;;
    esac
    printf '%s\n' "${wp}"
}

clamp_pointer_speed() {
    awk -v v="$1" 'BEGIN {
        if (v !~ /^-?[0-9]+(\.[0-9]+)?$/) exit 1;
        val = v + 0.0;
        if (val < -0.8) val = -0.8;
        if (val > 0.8) val = 0.8;
        printf "%.1f\n", val;
    }'
}

preset_default_accent() {
    case "$1" in
        aurora|dracula) echo "purple" ;;
        emerald) echo "green" ;;
        sunset) echo "amber" ;;
        sakura|cyberpunk) echo "rose" ;;
        *) echo "blue" ;;
    esac
}

preset_base_mode() {
    case "$1" in
        daylight|sakura|classic98) echo "light" ;;
        *) echo "dark" ;;
    esac
}

apply_preset_defaults() {
    p="$1"
    UNICORE_THEME_PRESET="${p}"
    case "${p}" in
        daylight)
            UNICORE_THEME="light"
            UNICORE_WALLPAPER="/usr/share/unicore/wallpaper-light.png"
            UNICORE_LAYOUT="win11"
            UNICORE_TASKBAR_STYLE="floating"
            UNICORE_ACCENT_COLOR="blue"
            ;;
        aurora)
            UNICORE_THEME="dark"
            UNICORE_WALLPAPER="/usr/share/unicore/wallpaper-aurora.png"
            UNICORE_LAYOUT="win11"
            UNICORE_TASKBAR_STYLE="floating"
            UNICORE_ACCENT_COLOR="purple"
            ;;
        nordic)
            UNICORE_THEME="dark"
            UNICORE_WALLPAPER="/usr/share/unicore/wallpaper-nordic.png"
            UNICORE_LAYOUT="macos"
            UNICORE_TASKBAR_STYLE="floating"
            UNICORE_ACCENT_COLOR="blue"
            ;;
        dracula)
            UNICORE_THEME="dark"
            UNICORE_WALLPAPER="/usr/share/unicore/wallpaper-dracula.png"
            UNICORE_LAYOUT="win11"
            UNICORE_TASKBAR_STYLE="floating"
            UNICORE_ACCENT_COLOR="purple"
            ;;
        emerald)
            UNICORE_THEME="dark"
            UNICORE_WALLPAPER="/usr/share/unicore/wallpaper-emerald.png"
            UNICORE_LAYOUT="win11"
            UNICORE_TASKBAR_STYLE="floating"
            UNICORE_ACCENT_COLOR="green"
            ;;
        sunset)
            UNICORE_THEME="dark"
            UNICORE_WALLPAPER="/usr/share/unicore/wallpaper-sunset.png"
            UNICORE_LAYOUT="win10"
            UNICORE_TASKBAR_STYLE="docked"
            UNICORE_ACCENT_COLOR="amber"
            ;;
        sakura)
            UNICORE_THEME="light"
            UNICORE_WALLPAPER="/usr/share/unicore/wallpaper-sakura.png"
            UNICORE_LAYOUT="macos"
            UNICORE_TASKBAR_STYLE="floating"
            UNICORE_ACCENT_COLOR="rose"
            ;;
        cyberpunk)
            UNICORE_THEME="dark"
            UNICORE_WALLPAPER="/usr/share/unicore/wallpaper-cyberpunk.png"
            UNICORE_LAYOUT="win10"
            UNICORE_TASKBAR_STYLE="floating"
            UNICORE_ACCENT_COLOR="rose"
            ;;
        classic98)
            UNICORE_THEME="light"
            UNICORE_WALLPAPER="/usr/share/unicore/wallpaper-classic98.png"
            UNICORE_LAYOUT="win10"
            UNICORE_TASKBAR_STYLE="docked"
            UNICORE_ACCENT_COLOR="blue"
            ;;
        *)
            UNICORE_THEME_PRESET="midnight"
            UNICORE_THEME="dark"
            UNICORE_WALLPAPER="/usr/share/unicore/wallpaper.png"
            UNICORE_LAYOUT="win11"
            UNICORE_TASKBAR_STYLE="floating"
            UNICORE_ACCENT_COLOR="blue"
            ;;
    esac
}

load_conf() {
    UNICORE_THEME_PRESET="midnight"
    UNICORE_THEME="dark"
    UNICORE_WALLPAPER="/usr/share/unicore/wallpaper.png"
    UNICORE_KB_LAYOUT="us"
    UNICORE_NATURAL_SCROLL="yes"
    UNICORE_TAP_TO_CLICK="yes"
    UNICORE_POINTER_SPEED="0.0"
    UNICORE_DESKTOP_ICONS="yes"
    UNICORE_TASKBAR_STYLE="floating"
    UNICORE_LAYOUT="win11"
    UNICORE_ACCENT_COLOR="blue"
    UNICORE_HIGH_CONTRAST="no"
    UNICORE_LARGE_TEXT="no"
    seen_preset=0
    if [ -r "${CONF_PATH}" ]; then
        while IFS='=' read -r k v; do
            case "${k}" in
                UNICORE_THEME_PRESET)
                    if pr="$(validate_preset "${v}" 2>/dev/null)"; then
                        UNICORE_THEME_PRESET="${pr}"
                        seen_preset=1
                    fi
                    ;;
                UNICORE_THEME)
                    if t="$(validate_theme "${v}" 2>/dev/null)"; then UNICORE_THEME="${t}"; fi
                    ;;
                UNICORE_WALLPAPER)
                    if wp="$(validate_wallpaper "${v}" 2>/dev/null)"; then UNICORE_WALLPAPER="${wp}"; fi
                    ;;
                UNICORE_KB_LAYOUT)
                    if kb="$(validate_kb_layout "${v}" 2>/dev/null)"; then UNICORE_KB_LAYOUT="${kb}"; fi
                    ;;
                UNICORE_NATURAL_SCROLL)
                    if ns="$(validate_bool_yn "${v}" 2>/dev/null)"; then UNICORE_NATURAL_SCROLL="${ns}"; fi
                    ;;
                UNICORE_TAP_TO_CLICK)
                    if tp="$(validate_bool_yn "${v}" 2>/dev/null)"; then UNICORE_TAP_TO_CLICK="${tp}"; fi
                    ;;
                UNICORE_POINTER_SPEED)
                    if ps="$(clamp_pointer_speed "${v}" 2>/dev/null)"; then UNICORE_POINTER_SPEED="${ps}"; fi
                    ;;
                UNICORE_DESKTOP_ICONS)
                    if di="$(validate_bool_yn "${v}" 2>/dev/null)"; then UNICORE_DESKTOP_ICONS="${di}"; fi
                    ;;
                UNICORE_TASKBAR_STYLE)
                    if ts="$(validate_taskbar_style "${v}" 2>/dev/null)"; then UNICORE_TASKBAR_STYLE="${ts}"; fi
                    ;;
                UNICORE_LAYOUT)
                    if lay="$(validate_layout "${v}" 2>/dev/null)"; then UNICORE_LAYOUT="${lay}"; fi
                    ;;
                UNICORE_ACCENT_COLOR)
                    if acc="$(validate_accent "${v}" 2>/dev/null)"; then UNICORE_ACCENT_COLOR="${acc}"; fi
                    ;;
                UNICORE_HIGH_CONTRAST)
                    if hc="$(validate_bool_yn "${v}" 2>/dev/null)"; then UNICORE_HIGH_CONTRAST="${hc}"; fi
                    ;;
                UNICORE_LARGE_TEXT)
                    if lt="$(validate_bool_yn "${v}" 2>/dev/null)"; then UNICORE_LARGE_TEXT="${lt}"; fi
                    ;;
            esac
        done < "${CONF_PATH}"
    fi
    if [ "${seen_preset}" -eq 0 ]; then
        if [ "${UNICORE_THEME}" = "light" ]; then
            UNICORE_THEME_PRESET="daylight"
        else
            UNICORE_THEME_PRESET="midnight"
        fi
    fi
}

write_conf() {
    mkdir -p "$(dirname "${CONF_PATH}")"
    cat <<EOF > "${CONF_PATH}"
UNICORE_THEME_PRESET=${UNICORE_THEME_PRESET}
UNICORE_THEME=${UNICORE_THEME}
UNICORE_WALLPAPER=${UNICORE_WALLPAPER}
UNICORE_KB_LAYOUT=${UNICORE_KB_LAYOUT}
UNICORE_NATURAL_SCROLL=${UNICORE_NATURAL_SCROLL}
UNICORE_TAP_TO_CLICK=${UNICORE_TAP_TO_CLICK}
UNICORE_POINTER_SPEED=${UNICORE_POINTER_SPEED}
UNICORE_DESKTOP_ICONS=${UNICORE_DESKTOP_ICONS}
UNICORE_TASKBAR_STYLE=${UNICORE_TASKBAR_STYLE}
UNICORE_LAYOUT=${UNICORE_LAYOUT}
UNICORE_ACCENT_COLOR=${UNICORE_ACCENT_COLOR}
UNICORE_HIGH_CONTRAST=${UNICORE_HIGH_CONTRAST}
UNICORE_LARGE_TEXT=${UNICORE_LARGE_TEXT}
EOF
}

write_waybar_config() {
    dest="$1"
    icon_theme="$2"
    pos="bottom"
    mb="5"
    mt="0"
    ml="10"
    mr="10"
    h="42"
    left_mods="[]"
    center_mods='["custom/start", "custom/files", "custom/browser", "custom/center", "wlr/taskbar"]'
    task_fmt='{title:.13}'

    case "${UNICORE_LAYOUT}" in
        win10)
            pos="bottom"
            h="40"
            mb="0"; mt="0"; ml="0"; mr="0"
            if [ "${UNICORE_TASKBAR_STYLE}" = "floating" ]; then
                h="42"; mb="5"; ml="10"; mr="10"
            fi
            left_mods='["custom/start", "custom/files", "custom/browser", "custom/center", "custom/taskmgr"]'
            center_mods='["wlr/taskbar"]'
            task_fmt='{title:.15}'
            ;;
        macos)
            pos="top"
            h="38"
            mb="0"; mt="4"; ml="10"; mr="10"
            left_mods='["custom/start", "custom/files", "custom/browser", "custom/center"]'
            center_mods='["wlr/taskbar"]'
            task_fmt='{title:.13}'
            ;;
        *)
            pos="bottom"
            h="42"
            mb="5"; mt="0"; ml="10"; mr="10"
            if [ "${UNICORE_TASKBAR_STYLE}" = "docked" ]; then
                mb="0"; ml="0"; mr="0"
            fi
            left_mods='[]'
            center_mods='["custom/start", "custom/files", "custom/browser", "custom/center", "wlr/taskbar"]'
            task_fmt='{title:.13}'
            ;;
    esac

    cat <<EOF > "${dest}"
{
  "layer": "top",
  "position": "${pos}",
  "height": ${h},
  "margin-top": ${mt},
  "margin-bottom": ${mb},
  "margin-left": ${ml},
  "margin-right": ${mr},
  "spacing": 4,
  "modules-left": ${left_mods},
  "modules-center": ${center_mods},
  "modules-right": [
    "custom/rec",
    "custom/update",
    "tray",
    "network",
    "pulseaudio",
    "battery",
    "custom/ai",
    "custom/quick",
    "clock",
    "custom/power",
    "custom/desktop"
  ],
  "custom/start": {
    "format": "\\uf00a",
    "tooltip-format": "Start Menu (Win)",
    "on-click": "pkill -f 'unicore-center --start-menu' || /usr/bin/unicore-center --start-menu &"
  },
  "custom/files": {
    "format": "\\uf07b",
    "tooltip-format": "File Explorer (Win+E)",
    "on-click": "pcmanfm /home/unicore &"
  },
  "custom/browser": {
    "format": "\\uf0ac",
    "tooltip-format": "Web Browser (Win+W)",
    "on-click": "/usr/bin/unicore-browser &"
  },
  "custom/center": {
    "format": "\\uf290",
    "tooltip-format": "UniCore App Store & Center (Win+C)",
    "on-click": "pkill -f 'unicore-center --tab store' || /usr/bin/unicore-center --tab store &"
  },
  "custom/taskmgr": {
    "format": "\\uf080",
    "tooltip-format": "Task Manager (Ctrl+Shift+Esc)",
    "on-click": "pkill -f 'unicore-center --taskmgr' || /usr/bin/unicore-center --taskmgr &"
  },
  "wlr/taskbar": {
    "format": "${task_fmt}",
    "icon-size": 16,
    "icon-theme": "${icon_theme}",
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close",
    "all-outputs": true
  },
  "tray": {
    "icon-size": 16,
    "spacing": 6
  },
  "custom/rec": {
    "exec": "/usr/libexec/unicore-capture waybar-status",
    "return-type": "json",
    "interval": 3,
    "signal": 8,
    "on-click": "/usr/libexec/unicore-capture record-stop"
  },
  "custom/update": {
    "exec": "/usr/libexec/unicore-update-check --waybar",
    "return-type": "json",
    "interval": 300,
    "on-click": "/usr/bin/unicore-center --tab system &"
  },
  "network": {
    "format-wifi": "\\uf1eb {signalStrength}%",
    "format-ethernet": "\\uf108",
    "format-disconnected": "\\uf127",
    "tooltip-format-wifi": "Wi-Fi: {essid} ({signalStrength}%) — Click for Settings",
    "tooltip-format-ethernet": "Wired Network ({ifname}) — Click for Settings",
    "tooltip-format-disconnected": "Offline — Click for Settings",
    "on-click": "/usr/bin/unicore-center --tab settings:wifi"
  },
  "pulseaudio": {
    "format": "\\uf028 {volume}%",
    "format-muted": "\\uf026",
    "tooltip-format": "Sound ({volume}%) — Scroll to adjust, Right-click to mute",
    "on-click": "/usr/bin/unicore-center --tab settings:audio",
    "on-click-right": "/usr/libexec/unicore-osd vol-mute",
    "on-scroll-up": "/usr/libexec/unicore-osd vol-up",
    "on-scroll-down": "/usr/libexec/unicore-osd vol-down"
  },
  "battery": {
    "format": "\\uf240 {capacity}%",
    "tooltip-format": "Battery: {capacity}% — Click for Power Settings",
    "on-click": "/usr/bin/unicore-center --tab settings:power"
  },
  "custom/ai": {
    "format": "\\uf0eb AI",
    "tooltip-format": "UniCore AI Assistant (Win+A)",
    "on-click": "pkill -f 'unicore-center --ai' || /usr/bin/unicore-center --ai &"
  },
  "custom/quick": {
    "format": "\\uf1de",
    "tooltip-format": "Quick Settings (Wi-Fi, Sound, Brightness, Themes, DND)",
    "on-click": "pkill -f 'unicore-center --quick-settings' || /usr/bin/unicore-center --quick-settings &"
  },
  "clock": {
    "format": "{:%H:%M\\n%d/%m/%Y}",
    "tooltip-format": "{:%A, %d %B %Y}"
  },
  "custom/power": {
    "format": "\\uf011",
    "tooltip-format": "Power Options (Win+X)",
    "on-click": "pkill -f 'unicore-center --power' || /usr/bin/unicore-center --power &"
  },
  "custom/desktop": {
    "format": " ",
    "tooltip-format": "Show Desktop (Win+D)",
    "on-click": "wlrctl toplevel minimize"
  }
}
EOF
}

apply_configs() {
    no_reload="${1:-0}"
    load_conf
    USER_HOME="${HOME:-/home/unicore}"
    CFG_ROOT="${XDG_CONFIG_HOME:-${USER_HOME}/.config}"
    export XDG_CONFIG_HOME="${CFG_ROOT}"
    mkdir -p "${CFG_ROOT}/gtk-3.0" "${CFG_ROOT}/waybar" "${CFG_ROOT}/fuzzel" "${CFG_ROOT}/labwc" "${CFG_ROOT}/libfm" "${CFG_ROOT}/foot" "${CFG_ROOT}/mako"

    if [ "${UNICORE_THEME}" = "light" ]; then
        GTK_THEME="Adwaita"
        GTK_PREFER_DARK="0"
        OPENBOX_FALLBACK="UniCore-Daylight"
        ICON_THEME="Papirus-Light"
        [ -d /usr/share/icons/Papirus-Light ] || ICON_THEME="Adwaita"
    else
        GTK_THEME="Adwaita-dark"
        GTK_PREFER_DARK="1"
        OPENBOX_FALLBACK="UniCore-Midnight"
        ICON_THEME="Papirus-Dark"
        [ -d /usr/share/icons/Papirus-Dark ] || ICON_THEME="Adwaita"
    fi

    WIN_CORNER_RADIUS=10
    case "${UNICORE_THEME_PRESET}" in
        midnight)  OPENBOX_THEME="UniCore-Midnight";  WIN_CORNER_RADIUS=10 ;;
        daylight)  OPENBOX_THEME="UniCore-Daylight";  WIN_CORNER_RADIUS=10 ;;
        aurora)    OPENBOX_THEME="UniCore-Aurora";    WIN_CORNER_RADIUS=10 ;;
        nordic)    OPENBOX_THEME="UniCore-Nordic";    WIN_CORNER_RADIUS=12 ;;
        dracula)   OPENBOX_THEME="UniCore-Dracula";   WIN_CORNER_RADIUS=10 ;;
        emerald)   OPENBOX_THEME="UniCore-Emerald";   WIN_CORNER_RADIUS=10 ;;
        sunset)    OPENBOX_THEME="UniCore-Sunset";    WIN_CORNER_RADIUS=8  ;;
        sakura)    OPENBOX_THEME="UniCore-Sakura";    WIN_CORNER_RADIUS=12 ;;
        cyberpunk) OPENBOX_THEME="UniCore-Cyberpunk"; WIN_CORNER_RADIUS=6  ;;
        classic98) OPENBOX_THEME="UniCore-Classic98"; WIN_CORNER_RADIUS=0  ;;
        *)         OPENBOX_THEME="${OPENBOX_FALLBACK}"; WIN_CORNER_RADIUS=10 ;;
    esac
    if [ ! -d "/usr/share/themes/${OPENBOX_THEME}" ]; then
        OPENBOX_THEME="${OPENBOX_FALLBACK}"
    fi

    case "${UNICORE_ACCENT_COLOR}" in
        purple)
            ACC_PRIMARY="#6366f1"; ACC_DARK="#4f46e5"; ACC_BRIGHT="#a5b4fc"
            ACC_SOFT_DARK="#312e81"; ACC_SOFT_LIGHT="#e0e7ff"
            ;;
        green)
            ACC_PRIMARY="#059669"; ACC_DARK="#047857"; ACC_BRIGHT="#34d399"
            ACC_SOFT_DARK="#064e3b"; ACC_SOFT_LIGHT="#d1fae5"
            ;;
        amber)
            ACC_PRIMARY="#d97706"; ACC_DARK="#b45309"; ACC_BRIGHT="#fbbf24"
            ACC_SOFT_DARK="#78350f"; ACC_SOFT_LIGHT="#fef3c7"
            ;;
        rose)
            ACC_PRIMARY="#e11d48"; ACC_DARK="#be123c"; ACC_BRIGHT="#fb7185"
            ACC_SOFT_DARK="#881337"; ACC_SOFT_LIGHT="#ffe4e6"
            ;;
        *)
            ACC_PRIMARY="#0284c7"; ACC_DARK="#0369a1"; ACC_BRIGHT="#38bdf8"
            ACC_SOFT_DARK="#1e3a5f"; ACC_SOFT_LIGHT="#dbeafe"
            ;;
    esac

    GTK_FONT="DejaVu Sans 10"
    [ "${UNICORE_LARGE_TEXT}" = "yes" ] && GTK_FONT="DejaVu Sans 13"

    cat <<EOF > "${CFG_ROOT}/gtk-3.0/settings.ini"
[Settings]
gtk-theme-name=${GTK_THEME}
gtk-icon-theme-name=${ICON_THEME}
gtk-font-name=${GTK_FONT}
gtk-application-prefer-dark-theme=${GTK_PREFER_DARK}
EOF

    cat <<EOF > "${CFG_ROOT}/libfm/libfm.conf"
[config]
quick_exec=1
single_click=0
thumbnail_local=1
thumbnail_max=8192

[ui]
icon_theme=${ICON_THEME}
show_thumbnail=1
EOF

    WAYBAR_SRC="/usr/share/unicore/themes/waybar-${UNICORE_THEME_PRESET}.css"
    [ -f "${WAYBAR_SRC}" ] || WAYBAR_SRC="/usr/share/unicore/themes/waybar-${UNICORE_THEME}.css"
    if [ -f "${WAYBAR_SRC}" ]; then
        cp "${WAYBAR_SRC}" "${CFG_ROOT}/waybar/style.css"
        if [ "${UNICORE_THEME}" = "light" ]; then
            ACC_SOFT="${ACC_SOFT_LIGHT}"
            FLOAT_BORDER="rgba(148, 163, 184, 0.55)"
        else
            ACC_SOFT="${ACC_SOFT_DARK}"
            FLOAT_BORDER="${ACC_BRIGHT}"
        fi
        # Preserve bespoke preset colors when using the preset's native accent; apply override when user customizes accent
        NATIVE_ACC="$(preset_default_accent "${UNICORE_THEME_PRESET}")"
        if [ "${UNICORE_ACCENT_COLOR}" != "${NATIVE_ACC}" ] || [ "${UNICORE_THEME_PRESET}" = "midnight" ] || [ "${UNICORE_THEME_PRESET}" = "daylight" ]; then
            cat <<EOF >> "${CFG_ROOT}/waybar/style.css"

/* Accent Color Override (${UNICORE_ACCENT_COLOR}) */
#custom-start,
#custom-update.update-available {
    background-color: ${ACC_PRIMARY};
}
#custom-start:hover,
#custom-update.update-available:hover {
    background-color: ${ACC_DARK};
}
#taskbar button.active {
    background-color: ${ACC_SOFT};
    border-bottom: 2px solid ${ACC_BRIGHT};
}
#custom-desktop:hover {
    background-color: ${ACC_BRIGHT};
}
EOF
        fi
        if [ "${UNICORE_TASKBAR_STYLE}" = "floating" ] || [ "${UNICORE_LAYOUT}" = "win11" ] || [ "${UNICORE_LAYOUT}" = "macos" ]; then
            if [ "${UNICORE_LAYOUT}" = "win10" ] && [ "${UNICORE_TASKBAR_STYLE}" = "docked" ]; then
                cat <<'EOF' >> "${CFG_ROOT}/waybar/style.css"
window#waybar {
    margin: 0;
    border-radius: 0;
}
EOF
            else
                BAR_RAD=14
                [ "${UNICORE_THEME_PRESET}" = "classic98" ] && BAR_RAD=0
                [ "${UNICORE_THEME_PRESET}" = "cyberpunk" ] && BAR_RAD=8
                [ "${UNICORE_THEME_PRESET}" = "sakura" ] && BAR_RAD=16
                cat <<EOF >> "${CFG_ROOT}/waybar/style.css"

/* Floating Pill Taskbar Override (${UNICORE_LAYOUT} / ${UNICORE_THEME_PRESET}) */
window#waybar {
    margin: 4px 8px;
    border-radius: ${BAR_RAD}px;
    border: 1px solid ${FLOAT_BORDER};
}
EOF
            fi
        else
            cat <<'EOF' >> "${CFG_ROOT}/waybar/style.css"
window#waybar {
    margin: 0;
    border-radius: 0;
}
EOF
        fi
        if [ "${UNICORE_HIGH_CONTRAST}" = "yes" ]; then
            cat <<'EOF' >> "${CFG_ROOT}/waybar/style.css"

/* High-Contrast Accessibility Override */
window#waybar {
    border: 2px solid #facc15;
}
#taskbar button.active {
    border-bottom: 3px solid #facc15;
}
EOF
        fi
        if [ "${UNICORE_LARGE_TEXT}" = "yes" ]; then
            cat <<'EOF' >> "${CFG_ROOT}/waybar/style.css"
* {
    font-size: 13px;
}
EOF
        fi
    fi

    write_waybar_config "${CFG_ROOT}/waybar/config.jsonc" "${ICON_THEME}"

    FUZZEL_SRC="/usr/share/unicore/themes/fuzzel-${UNICORE_THEME_PRESET}.ini"
    [ -f "${FUZZEL_SRC}" ] || FUZZEL_SRC="/usr/share/unicore/themes/fuzzel-${UNICORE_THEME}.ini"
    if [ -f "${FUZZEL_SRC}" ]; then
        cp "${FUZZEL_SRC}" "${CFG_ROOT}/fuzzel/fuzzel.ini"
        if [ -d "/usr/share/icons/${ICON_THEME}" ]; then
            if grep -q '^icon-theme=' "${CFG_ROOT}/fuzzel/fuzzel.ini" 2>/dev/null; then
                sed -i "s|^icon-theme=.*|icon-theme=${ICON_THEME}|" "${CFG_ROOT}/fuzzel/fuzzel.ini"
            else
                awk -v ic="${ICON_THEME}" '{
                    print
                    if ($0 == "[main]") print "icon-theme=" ic
                }' "${CFG_ROOT}/fuzzel/fuzzel.ini" > "${CFG_ROOT}/fuzzel/fuzzel.ini.tmp" \
                    && mv "${CFG_ROOT}/fuzzel/fuzzel.ini.tmp" "${CFG_ROOT}/fuzzel/fuzzel.ini"
            fi
        fi
    fi

    FOOT_SRC="/usr/share/unicore/themes/foot-${UNICORE_THEME_PRESET}.ini"
    if [ -f "${FOOT_SRC}" ]; then
        cp "${FOOT_SRC}" "${CFG_ROOT}/foot/foot.ini"
    fi

    MAKO_SRC="/usr/share/unicore/themes/mako-${UNICORE_THEME_PRESET}.conf"
    if [ -f "${MAKO_SRC}" ]; then
        cp "${MAKO_SRC}" "${CFG_ROOT}/mako/config"
    fi

    if [ -r /etc/xdg/labwc/rc.xml ]; then
        awk \
            -v theme="${OPENBOX_THEME}" \
            -v crad="${WIN_CORNER_RADIUS}" \
            -v ns="${UNICORE_NATURAL_SCROLL}" \
            -v tap="${UNICORE_TAP_TO_CLICK}" \
            -v speed="${UNICORE_POINTER_SPEED}" \
            '{
                if ($0 ~ /<name>UniCore-[A-Za-z0-9]+<\/name>/) {
                    sub(/<name>UniCore-[A-Za-z0-9]+<\/name>/, "<name>" theme "</name>");
                }
                if ($0 ~ /<cornerRadius>[0-9]+<\/cornerRadius>/) {
                    sub(/<cornerRadius>[0-9]+<\/cornerRadius>/, "<cornerRadius>" crad "</cornerRadius>");
                }
                if ($0 ~ /<naturalScroll>/) {
                    sub(/<naturalScroll>.*<\/naturalScroll>/, "<naturalScroll>" ns "</naturalScroll>");
                }
                if ($0 ~ /<tap>/) {
                    sub(/<tap>.*<\/tap>/, "<tap>" tap "</tap>");
                    print $0;
                    print "      <pointerSpeed>" speed "</pointerSpeed>";
                    next;
                }
                if ($0 ~ /<\/libinput>/) {
                    print "    <device category=\"non-touch\">";
                    print "      <pointerSpeed>" speed "</pointerSpeed>";
                    print "    </device>";
                }
                print $0;
            }' /etc/xdg/labwc/rc.xml > "${CFG_ROOT}/labwc/rc.xml"
    fi

    printf 'XKB_DEFAULT_LAYOUT=%s\n' "${UNICORE_KB_LAYOUT}" > "${CFG_ROOT}/labwc/environment"

    if [ "${no_reload}" = "0" ] && [ -n "${WAYLAND_DISPLAY:-}" ]; then
        LABWC_P="$(pgrep -x labwc 2>/dev/null | head -n1 || true)"
        if [ -n "${LABWC_P}" ]; then
            LABWC_PID="${LABWC_P}" labwc --reconfigure >/dev/null 2>&1 || true
            kill -HUP "${LABWC_P}" 2>/dev/null || true
            sleep 0.4
        elif command -v labwc >/dev/null 2>&1; then
            labwc --reconfigure >/dev/null 2>&1 || true
            sleep 0.3
        fi
        command -v makoctl >/dev/null 2>&1 && makoctl reload >/dev/null 2>&1 || true
        if [ "${UNICORE_LIGHTWEIGHT_SHELL:-0}" != "1" ]; then
            if [ -f "${UNICORE_WALLPAPER}" ] && command -v swaybg >/dev/null 2>&1; then
                pkill -x swaybg >/dev/null 2>&1 || true
                swaybg -i "${UNICORE_WALLPAPER}" -m fill </dev/null >/dev/null 2>&1 &
            fi
            if command -v pcmanfm >/dev/null 2>&1; then
                if [ "${UNICORE_DESKTOP_ICONS}" = "yes" ]; then
                    if ! pgrep -f "pcmanfm --desktop" >/dev/null 2>&1; then
                        pcmanfm --desktop </dev/null >/dev/null 2>&1 &
                    fi
                else
                    pkill -f "pcmanfm --desktop" >/dev/null 2>&1 || true
                fi
            fi
            if command -v waybar >/dev/null 2>&1 && pgrep -x waybar >/dev/null 2>&1; then
                pkill -x waybar >/dev/null 2>&1 || true
                sleep 0.2
                waybar </dev/null >/dev/null 2>&1 &
            fi
        fi
    fi
}

cmd="${1:-status}"
shift || true

case "${cmd}" in
    list-presets)
        cat <<'EOF'
midnight|UniCore Midnight|dark|win11|floating|blue|/usr/share/unicore/wallpaper.png
daylight|UniCore Daylight|light|win11|floating|blue|/usr/share/unicore/wallpaper-light.png
aurora|Aurora Violet|dark|win11|floating|purple|/usr/share/unicore/wallpaper-aurora.png
nordic|Nordic Frost|dark|macos|floating|blue|/usr/share/unicore/wallpaper-nordic.png
dracula|Dracula Neon|dark|win11|floating|purple|/usr/share/unicore/wallpaper-dracula.png
emerald|Emerald Forest|dark|win11|floating|green|/usr/share/unicore/wallpaper-emerald.png
sunset|Amber Sunset|dark|win10|docked|amber|/usr/share/unicore/wallpaper-sunset.png
sakura|Sakura Blossom|light|macos|floating|rose|/usr/share/unicore/wallpaper-sakura.png
cyberpunk|Cyberpunk Synth|dark|win10|floating|rose|/usr/share/unicore/wallpaper-cyberpunk.png
classic98|Retro Classic 98|light|win10|docked|blue|/usr/share/unicore/wallpaper-classic98.png
EOF
        ;;
    preset)
        p_raw="${1:-}"
        p_id="$(validate_preset "${p_raw}")" || { echo "Invalid theme preset: ${p_raw}" >&2; exit 2; }
        load_conf
        apply_preset_defaults "${p_id}"
        write_conf
        apply_configs 0
        echo "theme_preset=${UNICORE_THEME_PRESET}"
        ;;
    status)
        load_conf
        printf 'theme_preset=%s\ntheme=%s\nwallpaper=%s\nkb_layout=%s\nnatural_scroll=%s\ntap_to_click=%s\npointer_speed=%s\ndesktop_icons=%s\ntaskbar_style=%s\nlayout=%s\naccent_color=%s\nhigh_contrast=%s\nlarge_text=%s\n' \
            "${UNICORE_THEME_PRESET}" "${UNICORE_THEME}" "${UNICORE_WALLPAPER}" "${UNICORE_KB_LAYOUT}" \
            "${UNICORE_NATURAL_SCROLL}" "${UNICORE_TAP_TO_CLICK}" "${UNICORE_POINTER_SPEED}" \
            "${UNICORE_DESKTOP_ICONS}" "${UNICORE_TASKBAR_STYLE}" \
            "${UNICORE_LAYOUT}" "${UNICORE_ACCENT_COLOR}" \
            "${UNICORE_HIGH_CONTRAST}" "${UNICORE_LARGE_TEXT}"
        ;;
    apply)
        no_reload=0
        if [ "${1:-}" = "--no-reload" ]; then
            no_reload=1
        fi
        apply_configs "${no_reload}"
        ;;
    set)
        load_conf
        explicit_preset=0
        while [ "$#" -gt 0 ]; do
            case "$1" in
                --preset)
                    shift || { echo "Missing value for --preset" >&2; exit 2; }
                    p_id="$(validate_preset "$1")" || { echo "Invalid preset: $1" >&2; exit 2; }
                    apply_preset_defaults "${p_id}"
                    explicit_preset=1
                    ;;
                --theme)
                    shift || { echo "Missing value for --theme" >&2; exit 2; }
                    UNICORE_THEME="$(validate_theme "$1")" || { echo "Invalid theme: $1" >&2; exit 2; }
                    if [ "${explicit_preset}" -eq 0 ] && [ "$(preset_base_mode "${UNICORE_THEME_PRESET}")" != "${UNICORE_THEME}" ]; then
                        if [ "${UNICORE_THEME}" = "light" ]; then
                            UNICORE_THEME_PRESET="daylight"
                        else
                            UNICORE_THEME_PRESET="midnight"
                        fi
                    fi
                    ;;
                --wallpaper)
                    shift || { echo "Missing value for --wallpaper" >&2; exit 2; }
                    UNICORE_WALLPAPER="$(validate_wallpaper "$1")" || { echo "Invalid wallpaper path: $1" >&2; exit 2; }
                    ;;
                --kb-layout)
                    shift || { echo "Missing value for --kb-layout" >&2; exit 2; }
                    UNICORE_KB_LAYOUT="$(validate_kb_layout "$1")" || { echo "Invalid kb layout: $1" >&2; exit 2; }
                    ;;
                --natural-scroll)
                    shift || { echo "Missing value for --natural-scroll" >&2; exit 2; }
                    UNICORE_NATURAL_SCROLL="$(validate_bool_yn "$1")" || { echo "Invalid natural-scroll value: $1" >&2; exit 2; }
                    ;;
                --tap)
                    shift || { echo "Missing value for --tap" >&2; exit 2; }
                    UNICORE_TAP_TO_CLICK="$(validate_bool_yn "$1")" || { echo "Invalid tap value: $1" >&2; exit 2; }
                    ;;
                --pointer-speed)
                    shift || { echo "Missing value for --pointer-speed" >&2; exit 2; }
                    UNICORE_POINTER_SPEED="$(clamp_pointer_speed "$1")" || { echo "Invalid pointer-speed: $1" >&2; exit 2; }
                    ;;
                --desktop-icons)
                    shift || { echo "Missing value for --desktop-icons" >&2; exit 2; }
                    UNICORE_DESKTOP_ICONS="$(validate_bool_yn "$1")" || { echo "Invalid desktop-icons value: $1" >&2; exit 2; }
                    ;;
                --taskbar-style)
                    shift || { echo "Missing value for --taskbar-style" >&2; exit 2; }
                    UNICORE_TASKBAR_STYLE="$(validate_taskbar_style "$1")" || { echo "Invalid taskbar-style value: $1" >&2; exit 2; }
                    ;;
                --layout)
                    shift || { echo "Missing value for --layout" >&2; exit 2; }
                    UNICORE_LAYOUT="$(validate_layout "$1")" || { echo "Invalid layout value: $1" >&2; exit 2; }
                    if [ "${UNICORE_LAYOUT}" = "win10" ]; then
                        UNICORE_TASKBAR_STYLE="docked"
                    else
                        UNICORE_TASKBAR_STYLE="floating"
                    fi
                    ;;
                --accent)
                    shift || { echo "Missing value for --accent" >&2; exit 2; }
                    UNICORE_ACCENT_COLOR="$(validate_accent "$1")" || { echo "Invalid accent color: $1" >&2; exit 2; }
                    ;;
                --high-contrast)
                    shift || { echo "Missing value for --high-contrast" >&2; exit 2; }
                    UNICORE_HIGH_CONTRAST="$(validate_bool_yn "$1")" || { echo "Invalid high-contrast value: $1" >&2; exit 2; }
                    ;;
                --large-text)
                    shift || { echo "Missing value for --large-text" >&2; exit 2; }
                    UNICORE_LARGE_TEXT="$(validate_bool_yn "$1")" || { echo "Invalid large-text value: $1" >&2; exit 2; }
                    ;;
                *)
                    echo "Unknown option: $1" >&2
                    exit 2
                    ;;
            esac
            shift || true
        done
        write_conf
        apply_configs 0
        ;;
    *)
        echo "Usage: unicore-personalize <status|list-presets|preset <id>|apply [--no-reload]|set [--preset midnight..classic98] [--theme dark|light] [--layout win11|win10|macos] [--accent blue|purple|green|amber|rose] [--wallpaper PATH] [--kb-layout us|my|gb|de|fr|jp] [--natural-scroll yes|no] [--tap yes|no] [--pointer-speed -0.8..0.8] [--desktop-icons yes|no] [--taskbar-style docked|floating] [--high-contrast yes|no] [--large-text yes|no]>" >&2
        exit 2
        ;;
esac
