#!/bin/sh
set -eu

default_conf_path() {
    if [ -n "${UNICORE_PERSONALIZE_CONF:-}" ]; then
        printf '%s\n' "${UNICORE_PERSONALIZE_CONF}"
    elif [ -d /data/home ]; then
        printf '/data/home/.config/unicore/personalize.conf\n'
    else
        printf '%s/.config/unicore/personalize.conf\n' "${HOME:-/home/unicore}"
    fi
}

CONF_PATH="$(default_conf_path)"
UNICORE_THEME="dark"
UNICORE_WALLPAPER="/usr/share/unicore/wallpaper.png"
UNICORE_KB_LAYOUT="us"
UNICORE_NATURAL_SCROLL="yes"
UNICORE_TAP_TO_CLICK="yes"
UNICORE_POINTER_SPEED="0.0"
UNICORE_DESKTOP_ICONS="yes"
UNICORE_TASKBAR_STYLE="docked"

validate_theme() {
    case "$1" in
        dark|light) printf '%s\n' "$1" ;;
        *) return 1 ;;
    esac
}

validate_taskbar_style() {
    case "$1" in
        docked|floating) printf '%s\n' "$1" ;;
        *) return 1 ;;
    esac
}

validate_bool_yn() {
    case "$1" in
        yes|1|true|on) printf 'yes\n' ;;
        no|0|false|off) printf 'no\n' ;;
        *) return 1 ;;
    esac
}

validate_kb_layout() {
    case "$1" in
        us|my|gb|de|fr|jp) printf '%s\n' "$1" ;;
        *) return 1 ;;
    esac
}

validate_wallpaper() {
    wp="$1"
    case "${wp}" in
        /*) ;;
        *) return 1 ;;
    esac
    case "${wp}" in
        *..*|*\"*|*\'*|*\$*|*\`*|*\\*|*\;*|*\<*|*\>*|*\|*|*\&*) return 1 ;;
    esac
    printf '%s\n' "${wp}"
}

clamp_pointer_speed() {
    awk -v v="$1" 'BEGIN {
        if (v !~ /^-?[0-9]+(\.[0-9]+)?$/) exit 1;
        val = v + 0.0;
        if (val < -0.8) val = -0.8;
        if (val > 0.8) val = 0.8;
        printf "%.1f\n", val;
    }'
}

load_conf() {
    UNICORE_THEME="dark"
    UNICORE_WALLPAPER="/usr/share/unicore/wallpaper.png"
    UNICORE_KB_LAYOUT="us"
    UNICORE_NATURAL_SCROLL="yes"
    UNICORE_TAP_TO_CLICK="yes"
    UNICORE_POINTER_SPEED="0.0"
    UNICORE_DESKTOP_ICONS="yes"
    UNICORE_TASKBAR_STYLE="docked"
    if [ -r "${CONF_PATH}" ]; then
        while IFS='=' read -r k v; do
            case "${k}" in
                UNICORE_THEME)
                    if t="$(validate_theme "${v}" 2>/dev/null)"; then UNICORE_THEME="${t}"; fi
                    ;;
                UNICORE_WALLPAPER)
                    if wp="$(validate_wallpaper "${v}" 2>/dev/null)"; then UNICORE_WALLPAPER="${wp}"; fi
                    ;;
                UNICORE_KB_LAYOUT)
                    if kb="$(validate_kb_layout "${v}" 2>/dev/null)"; then UNICORE_KB_LAYOUT="${kb}"; fi
                    ;;
                UNICORE_NATURAL_SCROLL)
                    if ns="$(validate_bool_yn "${v}" 2>/dev/null)"; then UNICORE_NATURAL_SCROLL="${ns}"; fi
                    ;;
                UNICORE_TAP_TO_CLICK)
                    if tp="$(validate_bool_yn "${v}" 2>/dev/null)"; then UNICORE_TAP_TO_CLICK="${tp}"; fi
                    ;;
                UNICORE_POINTER_SPEED)
                    if ps="$(clamp_pointer_speed "${v}" 2>/dev/null)"; then UNICORE_POINTER_SPEED="${ps}"; fi
                    ;;
                UNICORE_DESKTOP_ICONS)
                    if di="$(validate_bool_yn "${v}" 2>/dev/null)"; then UNICORE_DESKTOP_ICONS="${di}"; fi
                    ;;
                UNICORE_TASKBAR_STYLE)
                    if ts="$(validate_taskbar_style "${v}" 2>/dev/null)"; then UNICORE_TASKBAR_STYLE="${ts}"; fi
                    ;;
            esac
        done < "${CONF_PATH}"
    fi
}

write_conf() {
    mkdir -p "$(dirname "${CONF_PATH}")"
    cat <<EOF > "${CONF_PATH}"
UNICORE_THEME=${UNICORE_THEME}
UNICORE_WALLPAPER=${UNICORE_WALLPAPER}
UNICORE_KB_LAYOUT=${UNICORE_KB_LAYOUT}
UNICORE_NATURAL_SCROLL=${UNICORE_NATURAL_SCROLL}
UNICORE_TAP_TO_CLICK=${UNICORE_TAP_TO_CLICK}
UNICORE_POINTER_SPEED=${UNICORE_POINTER_SPEED}
UNICORE_DESKTOP_ICONS=${UNICORE_DESKTOP_ICONS}
UNICORE_TASKBAR_STYLE=${UNICORE_TASKBAR_STYLE}
EOF
}

apply_configs() {
    no_reload="${1:-0}"
    load_conf
    USER_HOME="${HOME:-/home/unicore}"
    CFG_ROOT="${XDG_CONFIG_HOME:-${USER_HOME}/.config}"
    export XDG_CONFIG_HOME="${CFG_ROOT}"
    mkdir -p "${CFG_ROOT}/gtk-3.0" "${CFG_ROOT}/waybar" "${CFG_ROOT}/fuzzel" "${CFG_ROOT}/labwc" "${CFG_ROOT}/libfm"

    if [ "${UNICORE_THEME}" = "light" ]; then
        GTK_THEME="Adwaita"
        GTK_PREFER_DARK="0"
        OPENBOX_THEME="UniCore-Light"
        ICON_THEME="Papirus-Light"
        [ -d /usr/share/icons/Papirus-Light ] || ICON_THEME="Adwaita"
    else
        GTK_THEME="Adwaita-dark"
        GTK_PREFER_DARK="1"
        OPENBOX_THEME="UniCore-Dark"
        ICON_THEME="Papirus-Dark"
        [ -d /usr/share/icons/Papirus-Dark ] || ICON_THEME="Adwaita"
    fi

    cat <<EOF > "${CFG_ROOT}/gtk-3.0/settings.ini"
[Settings]
gtk-theme-name=${GTK_THEME}
gtk-icon-theme-name=${ICON_THEME}
gtk-font-name=DejaVu Sans 10
gtk-application-prefer-dark-theme=${GTK_PREFER_DARK}
EOF

    cat <<EOF > "${CFG_ROOT}/libfm/libfm.conf"
[config]
quick_exec=1
single_click=0

[ui]
icon_theme=${ICON_THEME}
EOF

    if [ -f "/usr/share/unicore/themes/waybar-${UNICORE_THEME}.css" ]; then
        cp "/usr/share/unicore/themes/waybar-${UNICORE_THEME}.css" "${CFG_ROOT}/waybar/style.css"
        if [ "${UNICORE_TASKBAR_STYLE}" = "floating" ]; then
            if [ "${UNICORE_THEME}" = "light" ]; then
                FLOAT_BORDER="rgba(148, 163, 184, 0.55)"
            else
                FLOAT_BORDER="rgba(56, 189, 248, 0.35)"
            fi
            cat <<EOF >> "${CFG_ROOT}/waybar/style.css"

/* Floating macOS-style Pill Taskbar Override */
window#waybar {
    margin: 6px 14px;
    border-radius: 14px;
    border: 1px solid ${FLOAT_BORDER};
}
EOF
        fi
    fi

    if [ -r /etc/xdg/waybar/config.jsonc ]; then
        if [ "${UNICORE_TASKBAR_STYLE}" = "floating" ]; then
            awk '{
                if ($0 ~ /"height": 40,/) {
                    print "  \"height\": 42,"
                    print "  \"margin-bottom\": 6,"
                    print "  \"margin-left\": 14,"
                    print "  \"margin-right\": 14,"
                } else {
                    print
                }
            }' /etc/xdg/waybar/config.jsonc > "${CFG_ROOT}/waybar/config.jsonc"
        else
            cp /etc/xdg/waybar/config.jsonc "${CFG_ROOT}/waybar/config.jsonc"
        fi
    fi

    if [ -f "/usr/share/unicore/themes/fuzzel-${UNICORE_THEME}.ini" ]; then
        cp "/usr/share/unicore/themes/fuzzel-${UNICORE_THEME}.ini" "${CFG_ROOT}/fuzzel/fuzzel.ini"
        if [ -d "/usr/share/icons/${ICON_THEME}" ]; then
            if grep -q '^icon-theme=' "${CFG_ROOT}/fuzzel/fuzzel.ini" 2>/dev/null; then
                sed -i "s|^icon-theme=.*|icon-theme=${ICON_THEME}|" "${CFG_ROOT}/fuzzel/fuzzel.ini"
            else
                awk -v ic="${ICON_THEME}" '{
                    print
                    if ($0 == "[main]") print "icon-theme=" ic
                }' "${CFG_ROOT}/fuzzel/fuzzel.ini" > "${CFG_ROOT}/fuzzel/fuzzel.ini.tmp" \
                    && mv "${CFG_ROOT}/fuzzel/fuzzel.ini.tmp" "${CFG_ROOT}/fuzzel/fuzzel.ini"
            fi
        fi
    fi

    if [ -r /etc/xdg/labwc/rc.xml ]; then
        awk \
            -v theme="${OPENBOX_THEME}" \
            -v ns="${UNICORE_NATURAL_SCROLL}" \
            -v tap="${UNICORE_TAP_TO_CLICK}" \
            -v speed="${UNICORE_POINTER_SPEED}" \
            '{
                if ($0 ~ /<name>UniCore-(Dark|Light)<\/name>/) {
                    sub(/<name>UniCore-(Dark|Light)<\/name>/, "<name>" theme "</name>");
                }
                if ($0 ~ /<naturalScroll>/) {
                    sub(/<naturalScroll>.*<\/naturalScroll>/, "<naturalScroll>" ns "</naturalScroll>");
                }
                if ($0 ~ /<tap>/) {
                    sub(/<tap>.*<\/tap>/, "<tap>" tap "</tap>");
                    print $0;
                    print "      <pointerSpeed>" speed "</pointerSpeed>";
                    next;
                }
                if ($0 ~ /<\/libinput>/) {
                    print "    <device category=\"non-touch\">";
                    print "      <pointerSpeed>" speed "</pointerSpeed>";
                    print "    </device>";
                }
                print $0;
            }' /etc/xdg/labwc/rc.xml > "${CFG_ROOT}/labwc/rc.xml"
    fi

    printf 'XKB_DEFAULT_LAYOUT=%s\n' "${UNICORE_KB_LAYOUT}" > "${CFG_ROOT}/labwc/environment"

    if [ "${no_reload}" = "0" ] && [ -n "${WAYLAND_DISPLAY:-}" ]; then
        LABWC_P="$(pgrep -u "$(id -u)" -x labwc 2>/dev/null | head -n1 || true)"
        if [ -n "${LABWC_P}" ]; then
            LABWC_PID="${LABWC_P}" labwc --reconfigure >/dev/null 2>&1 || true
            kill -HUP "${LABWC_P}" 2>/dev/null || true
            sleep 0.4
        elif command -v labwc >/dev/null 2>&1; then
            labwc --reconfigure >/dev/null 2>&1 || true
            sleep 0.3
        fi
        if [ "${UNICORE_LIGHTWEIGHT_SHELL:-0}" != "1" ]; then
            if [ -f "${UNICORE_WALLPAPER}" ] && command -v swaybg >/dev/null 2>&1; then
                pkill -x swaybg >/dev/null 2>&1 || true
                swaybg -i "${UNICORE_WALLPAPER}" -m fill </dev/null >/dev/null 2>&1 &
            fi
            if command -v pcmanfm >/dev/null 2>&1; then
                if [ "${UNICORE_DESKTOP_ICONS}" = "yes" ]; then
                    if ! pgrep -u "$(id -u)" -f "pcmanfm --desktop" >/dev/null 2>&1; then
                        pcmanfm --desktop </dev/null >/dev/null 2>&1 &
                    fi
                else
                    pkill -u "$(id -u)" -f "pcmanfm --desktop" >/dev/null 2>&1 || true
                fi
            fi
            if command -v waybar >/dev/null 2>&1 && pgrep -x waybar >/dev/null 2>&1; then
                pkill -x waybar >/dev/null 2>&1 || true
                sleep 0.2
                waybar </dev/null >/dev/null 2>&1 &
            fi
        fi
    fi
}

cmd="${1:-status}"
shift || true

case "${cmd}" in
    status)
        load_conf
        printf 'theme=%s\nwallpaper=%s\nkb_layout=%s\nnatural_scroll=%s\ntap_to_click=%s\npointer_speed=%s\ndesktop_icons=%s\ntaskbar_style=%s\n' \
            "${UNICORE_THEME}" "${UNICORE_WALLPAPER}" "${UNICORE_KB_LAYOUT}" \
            "${UNICORE_NATURAL_SCROLL}" "${UNICORE_TAP_TO_CLICK}" "${UNICORE_POINTER_SPEED}" \
            "${UNICORE_DESKTOP_ICONS}" "${UNICORE_TASKBAR_STYLE}"
        ;;
    apply)
        no_reload=0
        if [ "${1:-}" = "--no-reload" ]; then
            no_reload=1
        fi
        apply_configs "${no_reload}"
        ;;
    set)
        load_conf
        while [ "$#" -gt 0 ]; do
            case "$1" in
                --theme)
                    shift || { echo "Missing value for --theme" >&2; exit 2; }
                    UNICORE_THEME="$(validate_theme "$1")" || { echo "Invalid theme: $1" >&2; exit 2; }
                    ;;
                --wallpaper)
                    shift || { echo "Missing value for --wallpaper" >&2; exit 2; }
                    UNICORE_WALLPAPER="$(validate_wallpaper "$1")" || { echo "Invalid wallpaper path: $1" >&2; exit 2; }
                    ;;
                --kb-layout)
                    shift || { echo "Missing value for --kb-layout" >&2; exit 2; }
                    UNICORE_KB_LAYOUT="$(validate_kb_layout "$1")" || { echo "Invalid kb layout: $1" >&2; exit 2; }
                    ;;
                --natural-scroll)
                    shift || { echo "Missing value for --natural-scroll" >&2; exit 2; }
                    UNICORE_NATURAL_SCROLL="$(validate_bool_yn "$1")" || { echo "Invalid natural-scroll value: $1" >&2; exit 2; }
                    ;;
                --tap)
                    shift || { echo "Missing value for --tap" >&2; exit 2; }
                    UNICORE_TAP_TO_CLICK="$(validate_bool_yn "$1")" || { echo "Invalid tap value: $1" >&2; exit 2; }
                    ;;
                --pointer-speed)
                    shift || { echo "Missing value for --pointer-speed" >&2; exit 2; }
                    UNICORE_POINTER_SPEED="$(clamp_pointer_speed "$1")" || { echo "Invalid pointer-speed: $1" >&2; exit 2; }
                    ;;
                --desktop-icons)
                    shift || { echo "Missing value for --desktop-icons" >&2; exit 2; }
                    UNICORE_DESKTOP_ICONS="$(validate_bool_yn "$1")" || { echo "Invalid desktop-icons value: $1" >&2; exit 2; }
                    ;;
                --taskbar-style)
                    shift || { echo "Missing value for --taskbar-style" >&2; exit 2; }
                    UNICORE_TASKBAR_STYLE="$(validate_taskbar_style "$1")" || { echo "Invalid taskbar-style value: $1" >&2; exit 2; }
                    ;;
                *)
                    echo "Unknown option: $1" >&2
                    exit 2
                    ;;
            esac
            shift || true
        done
        write_conf
        apply_configs 0
        ;;
    *)
        echo "Usage: unicore-personalize <status|apply [--no-reload]|set [--theme dark|light] [--wallpaper PATH] [--kb-layout us|my|gb|de|fr|jp] [--natural-scroll yes|no] [--tap yes|no] [--pointer-speed -0.8..0.8] [--desktop-icons yes|no] [--taskbar-style docked|floating]>" >&2
        exit 2
        ;;
esac
