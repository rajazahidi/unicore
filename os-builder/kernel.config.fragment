# Minimal Universal OS Linux Kernel Configuration Fragment (x86_64 primary)

# --- Built-in Android ART Subsystem (No Heavy VM) ---
CONFIG_ANDROID=y
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
CONFIG_ASHMEM=y
CONFIG_MEMFD_CREATE=y

# --- Built-in Binary Dispatch (PE .exe & .apk) ---
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_BINFMT_MISC=y

# --- Zero-Trust Per-App Sandboxing ---
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_PIDS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# --- Immutable RootFS & A/B Partition Support ---
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_EROFS_FS=y
CONFIG_OVERLAY_FS=y

# --- Unified Zero-Copy Display & GPU (Wayland + Vulkan + DMA-BUF) ---
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DMA_SHARED_BUFFER=y
CONFIG_SYNC_FILE=y
CONFIG_VIRTIO_GPU=y
